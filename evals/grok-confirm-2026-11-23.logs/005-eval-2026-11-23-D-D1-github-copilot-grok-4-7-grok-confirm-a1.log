import os, time, tempfile, shutil, hashlib
from pathlib import Path

# Measure scan + copy characteristics at a few scales, then extrapolate.
# Also measure os.link vs copy vs shutil.copy2 throughput on a real temp dir.

base = tempfile.mkdtemp(prefix="bctl-bench-")
print("base", base)

def make_tree(root, n_files, bytes_each, subdirs=100):
    root = Path(root)
    root.mkdir(parents=True, exist_ok=True)
    payload = b"x" * bytes_each
    for i in range(n_files):
        d = root / f"d{i % subdirs}"
        d.mkdir(exist_ok=True)
        (d / f"f{i}.bin").write_bytes(payload)

def bench_walk(root):
    t0 = time.perf_counter()
    n = 0
    b = 0
    for dirpath, dirnames, filenames in os.walk(root):
        for name in filenames:
            p = os.path.join(dirpath, name)
            st = os.stat(p)
            b += st.st_size
            n += 1
    dt = time.perf_counter() - t0
    return n, b, dt

def bench_copy_readwrite(src, dst, limit=None):
    os.makedirs(dst, exist_ok=True)
    t0 = time.perf_counter()
    n = 0
    b = 0
    for dirpath, dirnames, filenames in os.walk(src):
        for name in filenames:
            s = os.path.join(dirpath, name)
            rel = os.path.relpath(s, src)
            d = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(d), exist_ok=True)
            with open(s, "rb") as fsrc, open(d, "wb") as fdst:
                data = fsrc.read()
                fdst.write(data)
                b += len(data)
            n += 1
            if limit and n >= limit:
                dt = time.perf_counter() - t0
                return n, b, dt
    dt = time.perf_counter() - t0
    return n, b, dt

def bench_copyfile(src, dst, limit=None):
    os.makedirs(dst, exist_ok=True)
    t0 = time.perf_counter()
    n = 0
    b = 0
    for dirpath, dirnames, filenames in os.walk(src):
        for name in filenames:
            s = os.path.join(dirpath, name)
            rel = os.path.relpath(s, src)
            d = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(d), exist_ok=True)
            shutil.copyfile(s, d)
            b += os.path.getsize(s)
            n += 1
            if limit and n >= limit:
                return n, b, time.perf_counter() - t0
    return n, b, time.perf_counter() - t0

def bench_hardlink(src, dst, limit=None):
    os.makedirs(dst, exist_ok=True)
    t0 = time.perf_counter()
    n = 0
    for dirpath, dirnames, filenames in os.walk(src):
        for name in filenames:
            s = os.path.join(dirpath, name)
            rel = os.path.relpath(s, src)
            d = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(d), exist_ok=True)
            os.link(s, d)
            n += 1
            if limit and n >= limit:
                return n, time.perf_counter() - t0
    return n, time.perf_counter() - t0

# small metadata-bound tree: 20k empty-ish files
meta = os.path.join(base, "meta")
print("making 20000 x 64B ...", flush=True)
t0 = time.perf_counter()
make_tree(meta, 20000, 64, subdirs=200)
print(f"  create {time.perf_counter()-t0:.2f}s")
n, b, dt = bench_walk(meta)
print(f"  walk+stat {n} files {b} bytes in {dt:.3f}s  ({n/dt:.0f} files/s)")

# medium content tree: 2000 x 64KiB = 128 MiB
med = os.path.join(base, "med")
