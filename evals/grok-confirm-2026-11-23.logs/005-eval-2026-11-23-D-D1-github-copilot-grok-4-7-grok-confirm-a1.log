import os, time, tempfile, shutil, subprocess
from pathlib import Path

base = tempfile.mkdtemp(prefix="bctl-bench2-")
print("base", base, "cpu", os.cpu_count())

def purge():
    # best-effort; may fail without privileges
    subprocess.run(["purge"], capture_output=True)

def make_tree(root, n_files, bytes_each, subdirs=100):
    root = Path(root)
    payload = b"y" * bytes_each
    for i in range(n_files):
        d = root / f"d{i % subdirs}"
        d.mkdir(parents=True, exist_ok=True)
        (d / f"f{i}.bin").write_bytes(payload)

def bench_link(src, dst):
    os.makedirs(dst, exist_ok=True)
    t0 = time.perf_counter()
    n = 0
    for dirpath, dirnames, filenames in os.walk(src):
        for name in filenames:
            s = os.path.join(dirpath, name)
            rel = os.path.relpath(s, src)
            d = os.path.join(dst, rel)
            parent = os.path.dirname(d)
            if not os.path.isdir(parent):
                os.makedirs(parent, exist_ok=True)
            os.link(s, d)
            n += 1
    return n, time.perf_counter() - t0

def bench_copy_chunked(src, dst, chunk=1024*1024):
    os.makedirs(dst, exist_ok=True)
    t0 = time.perf_counter()
    n = 0
    b = 0
    for dirpath, dirnames, filenames in os.walk(src):
        for name in filenames:
            s = os.path.join(dirpath, name)
            rel = os.path.relpath(s, src)
            d = os.path.join(dst, rel)
            os.makedirs(os.path.dirname(d) or ".", exist_ok=True)
            with open(s, "rb") as fsrc, open(d, "wb") as fdst:
                while True:
                    block = fsrc.read(chunk)
                    if not block:
                        break
                    fdst.write(block)
                    b += len(block)
                fdst.flush()
                os.fsync(fdst.fileno())
            n += 1
    return n, b, time.perf_counter() - t0

# link rate, second measurement (dirs already warm vs cold create)
meta = os.path.join(base, "meta")
print("create 5000 x 128B", flush=True)
make_tree(meta, 5000, 128, subdirs=100)
n, dt = bench_link(meta, os.path.join(base, "meta-link"))
print(f"  link 5000 in {dt:.3f}s ({n/dt:.0f}/s)  -- includes makedirs")

# precreate dest dirs, link only
src = meta
dst = os.path.join(base, "meta-link2")
for dirpath, dirnames, filenames in os.walk(src):
    rel = os.path.relpath(dirpath, src)
    os.makedirs(os.path.join(dst, rel), exist_ok=True)
t0 = time.perf_counter()
n = 0
for dirpath, dirnames, filenames in os.walk(src):
    for name in filenames:
        s = os.path.join(dirpath, name)
        rel = os.path.relpath(s, src)
        os.link(s, os.path.join(dst, rel))
        n += 1
dt = time.perf_counter() - t0
print(f"  link-only 5000 in {dt:.3f}s ({n/dt:.0f}/s)")

# fsync copy of ~64MB of small files to see metadata+fsync cost
small = os.path.join(base, "small")
print("create 1000 x 64KiB", flush=True)
make_tree(small, 1000, 64*1024, subdirs=20)
n, b, dt = bench_copy_chunked(small, os.path.join(base, "small-copy"))
print(f"  fsync-copy {n} files {b/1e6:.1f}MB in {dt:.3f}s ({b/dt/1e6:.1f} MB/s, {n/dt:.0f} files/s)")

# one large file fsync copy 256MB
big = os.path.join(base, "big.bin")
print("write 256MB", flush=True)
payload = b"z" * (1024*1024)
with open(big, "wb") as f:
    for _ in range(256):
        f.write(payload)
    f.flush(); os.fsync(f.fileno())
dstb = os.path.join(base, "big-copy.bin")
t0 = time.perf_counter()
with open(big, "rb") as fsrc, open(dstb, "wb") as fdst:
    while True:
        block = fsrc.read(1024*1024)
        if not block:
            break
        fdst.write(block)
    fdst.flush(); os.fsync(fdst.fileno())
dt = time.perf_counter() - t0
print(f"  fsync-copy 256MB one file in {dt:.3f}s ({256/dt:.1f} MB/s)  [likely cached]")

# json dump cost for 20k entries
import json
manifest = {f"d{i%200}/f{i}.bin": {"size": 4096, "mtime": 1700000000.123456} for i in range(20000)}
p = os.path.join(base, "m.json")
t0 = time.perf_counter()
with open(p, "w") as f:
    json.dump(manifest, f)
    f.flush(); os.fsync(f.fileno())
dt = time.perf_counter() - t0
print(f"  json.dump 20k entries {os.path.getsize(p)} bytes in {dt:.3f}s")
t0 = time.perf_counter()
with open(p) as f:
    json.load(f)
print(f"  json.load 20k in {time.perf_counter()-t0:.3f}s")

shutil.rmtree(base)
print("done")
