+class TransformFailureTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-fail-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.inp = os.path.join(self.tmp, "in")
+        os.makedirs(self.inp)
+        with open(os.path.join(self.inp, "a.csv"), "w") as fh:
+            fh.write("amount\n10\n")
+        with open(os.path.join(self.inp, "b.csv"), "w") as fh:
+            fh.write("amount\nbad\n")
+        self.rules_path = os.path.join(self.tmp, "rules.toml")
+        with open(self.rules_path, "w") as fh:
+            fh.write('[transforms]\namount = "round2"\n')
+        self.out = os.path.join(self.tmp, "out")
+        os.makedirs(self.out)
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+
+    def _seed_previous_run(self):
+        with open(os.path.join(self.out, "report.json"), "w") as fh:
+            fh.write('{"previous": true}\n')
+        with open(os.path.join(self.out, "report.html"), "w") as fh:
+            fh.write("<html>previous</html>\n")
+        os.makedirs(os.path.dirname(self.cache_path))
+        with open(self.cache_path, "w") as fh:
+            fh.write('{"previous": true}\n')
+
+    def _assert_untouched(self):
+        with open(os.path.join(self.out, "report.json")) as fh:
+            self.assertEqual(fh.read(), '{"previous": true}\n')
+        with open(os.path.join(self.out, "report.html")) as fh:
+            self.assertEqual(fh.read(), "<html>previous</html>\n")
+        with open(self.cache_path) as fh:
+            self.assertEqual(fh.read(), '{"previous": true}\n')
+
+    def test_transform_error_publishes_nothing(self):
+        self._seed_previous_run()
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+        self._assert_untouched()
+
+    def test_uncaught_transform_crash_publishes_nothing(self):
+        self._seed_previous_run()
+        with mock.patch.dict(transforms.REGISTRY,
+                             {"round2": mock.Mock(side_effect=RuntimeError("boom"))}):
+            with self.assertRaises(reportgen.ValidationError):
+                reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+        self._assert_untouched()
+
+    def test_main_exits_1_on_transform_failure(self):
+        self._seed_previous_run()
+        with self.assertRaises(SystemExit) as caught:
+            reportgen.main(["--rules", self.rules_path, "--input", self.inp,
+                            "--output", self.out, "--cache", self.cache_path])
