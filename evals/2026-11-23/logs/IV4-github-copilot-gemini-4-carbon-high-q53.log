import csv, datetime, glob
for p in sorted(glob.glob("input/*.csv")):
    with open(p, newline="") as f:
        r = csv.DictReader(f)
        bad = []
        for i, row in enumerate(r, 2):
            if "date" in row:
                m, d, y = row["date"].split("/")
                try:
                    datetime.date(int(y), int(m), int(d))
                except ValueError:
                    bad.append((i, row["date"]))
        print(p, "bad dates:", len(bad), bad[:5])
