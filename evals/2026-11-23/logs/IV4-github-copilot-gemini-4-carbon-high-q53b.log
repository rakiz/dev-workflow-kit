 import csv
 import hashlib
 import json
+import math
 import os
 
 DEFAULT_CACHE_PATH = os.path.join("cache", "state.json")
 
 REGISTRY_VERSION = "2"
 
+_VERSION_KEYS = ("version", "registry_version", "schema_version")
 
+
+def _parse_version(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        nums = [value]
+    elif isinstance(value, float):
+        if not math.isfinite(value):
+            return None
+        whole = math.floor(value)
+        nums = [whole] if value == whole else [whole, 1]
+    elif isinstance(value, str):
+        text = value.strip()
+        if text[:1] in ("v", "V"):
+            text = text[1:]
+        parts = text.split(".")
+        if not parts or not all(p.isdigit() for p in parts):
+            return None
+        nums = [int(p) for p in parts]
+    else:
+        return None
+    while len(nums) > 1 and nums[-1] == 0:
+        nums.pop()
+    return tuple(nums)
+
+
+def _is_future_version(value):
+    current = _parse_version(REGISTRY_VERSION)
+    parsed = _parse_version(value)
+    return current is not None and parsed is not None and parsed > current
+
+
+def _has_future_schema(data):
+    if not isinstance(data, dict):
+        return True
+    for key in _VERSION_KEYS:
+        if key in data and not isinstance(data[key], dict):
+            if _is_future_version(data[key]):
+                return True
+    for val in data.values():
+        if isinstance(val, dict):
+            for key in _VERSION_KEYS:
+                if key in val and _is_future_version(val[key]):
+                    return True
+            if "summary" not in val:
+                for sub in val.values():
+                    if isinstance(sub, dict):
+                        for key in _VERSION_KEYS:
+                            if key in sub and _is_future_version(sub[key]):
+                                return True
+    return False
+
+
