+class BooleanAndTransformRegressionTests(unittest.TestCase):
+    def test_boolean_transform_values_and_errors(self):
+        for raw in ("yes", "YES", "Yes", "true", "TRUE", "True", " yes "):
+            val = transforms.apply("boolean", raw)
+            self.assertIs(type(val), float)
+            self.assertEqual(val, 1.0)
+        for raw in ("no", "NO", "No", "false", "FALSE", "False", " false "):
+            val = transforms.apply("boolean", raw)
+            self.assertIs(type(val), float)
+            self.assertEqual(val, 0.0)
+        for bad in ("", "   ", "1", "0", "y", "n", "on", "off", "maybe"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", bad)
+
+    def test_boolean_end_to_end_and_duplicate_numeric_sum(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-bool-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        inp = os.path.join(tmp, "in")
+        os.makedirs(inp)
+        with open(os.path.join(inp, "flags.csv"), "w", encoding="utf-8") as fh:
+            fh.write("active,price\nyes,$10.00\nTRUE,$10.00\nno,$5.00\nFalse,$10.00\nyes,$5.00\n")
+        rules_path = os.path.join(tmp, "rules.toml")
+        with open(rules_path, "w", encoding="utf-8") as fh:
+            fh.write('[transforms]\nactive = "boolean"\nprice = "currency_amount"\n')
+        out = os.path.join(tmp, "out")
+        cache_path = os.path.join(tmp, "cache", "state.json")
+        report = reportgen.run(rules_path, inp, out, cache_path)
+        cols = report["files"]["flags.csv"]["summary"]["columns"]
+        self.assertEqual(cols["active"]["distinct"], 2)
+        self.assertEqual(cols["active"]["sample"], [0.0, 1.0])
+        self.assertEqual(cols["active"]["numeric_sum"], 3.0)
+        self.assertEqual(cols["price"]["distinct"], 2)
+        self.assertEqual(cols["price"]["numeric_sum"], 40.0)
+
+    def test_invalid_calendar_date_and_non_finite_numbers_rejected(self):
+        for bad_date in ("02/30/2026", "13/01/2026", "00/10/2026", "01/00/2026"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("date_iso", bad_date)
+        for bad_num in ("nan", "NaN", "inf", "-inf", "infinity"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("round2", bad_num)
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("currency_amount", bad_num)
+
+
+class HygieneAndInvariantRegressionTests(unittest.TestCase):
