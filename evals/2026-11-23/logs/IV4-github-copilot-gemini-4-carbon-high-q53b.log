    out = os.path.join(tmp, "out")
    cache_path = os.path.join(tmp, "cache", "state.json")
    rules_abs = os.path.abspath("rules.example.toml")
    cold_opens = []
    def hook(event, args):
        if event == "open":
            path = args[0]
