+        rules_path = os.path.join(tmp, "rules.toml")
+        with open(rules_path, "w") as fh:
+            fh.write('[transforms]\namount = "currency_amount"\n')
+
+        read_count = 0
+        real_load_rules = reportgen.load_rules
+
+        def counting_load_rules(path):
+            nonlocal read_count
+            if os.path.abspath(path) == os.path.abspath(rules_path):
+                read_count += 1
+            return real_load_rules(path)
+
+        orig_load = reportgen.load_rules
+        reportgen.load_rules = counting_load_rules
+        try:
+            reportgen.run(rules_path, INPUT_DIR, out, cache_path)
+        finally:
+            reportgen.load_rules = orig_load
+
+        self.assertEqual(read_count, 1)
+
+
+class TransformFailureInvariantTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-failure-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.inp = os.path.join(self.tmp, "in")
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+        os.makedirs(self.inp)
+        self.rules_path = os.path.join(self.tmp, "rules.toml")
+        with open(self.rules_path, "w") as fh:
+            fh.write('[transforms]\nval = "round2"\n')
+
+        self.good_csv = os.path.join(self.inp, "data.csv")
+        with open(self.good_csv, "w") as fh:
+            fh.write("val\n1.23\n4.56\n")
+        reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+
+        with open(os.path.join(self.out, "report.html"), "rb") as fh:
+            self.html_bytes = fh.read()
+        with open(os.path.join(self.out, "report.json"), "rb") as fh:
+            self.json_bytes = fh.read()
+        with open(self.cache_path, "rb") as fh:
+            self.cache_bytes = fh.read()
+
+    def test_transform_error_preserves_previous_artifacts_byte_for_byte(self):
+        with open(self.good_csv, "w") as fh:
+            fh.write("val\n1.23\nnot_a_number\n")
+
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+
+        with open(os.path.join(self.out, "report.html"), "rb") as fh:
+            self.assertEqual(fh.read(), self.html_bytes)
+        with open(os.path.join(self.out, "report.json"), "rb") as fh:
+            self.assertEqual(fh.read(), self.json_bytes)
+        with open(self.cache_path, "rb") as fh:
+            self.assertEqual(fh.read(), self.cache_bytes)
+
+    def test_unhandled_crash_preserves_previous_artifacts_byte_for_byte(self):
+        def crashing_transform(val):
+            raise ZeroDivisionError("unexpected crash")
+
+        transforms.REGISTRY["crash"] = crashing_transform
+        try:
+            with open(self.rules_path, "w") as fh:
+                fh.write('[transforms]\nval = "crash"\n')
+            with open(self.good_csv, "w") as fh:
+                fh.write("val\n1.23\n")
+
+            with self.assertRaises(reportgen.ValidationError):
+                reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+
+            with open(os.path.join(self.out, "report.html"), "rb") as fh:
+                self.assertEqual(fh.read(), self.html_bytes)
+            with open(os.path.join(self.out, "report.json"), "rb") as fh:
+                self.assertEqual(fh.read(), self.json_bytes)
+            with open(self.cache_path, "rb") as fh:
+                self.assertEqual(fh.read(), self.cache_bytes)
+        finally:
+            transforms.REGISTRY.pop("crash", None)
+
+    def test_main_exits_1_on_transform_failure(self):
+        with open(self.good_csv, "w") as fh:
+            fh.write("val\nnot_a_number\n")
+        with self.assertRaises(SystemExit) as cm:
+            reportgen.main(["--rules", self.rules_path, "--input", self.inp,
+                            "--output", self.out, "--cache", self.cache_path])
+        self.assertEqual(cm.exception.code, 1)
+
+    def test_first_run_failure_emits_nothing_new(self):
+        empty_out = os.path.join(self.tmp, "fresh_out")
+        empty_cache = os.path.join(self.tmp, "fresh_cache", "state.json")
+        with open(self.good_csv, "w") as fh:
+            fh.write("val\nnot_a_number\n")
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(self.rules_path, self.inp, empty_out, empty_cache)
+        self.assertFalse(os.path.exists(os.path.join(empty_out, "report.html")))
+        self.assertFalse(os.path.exists(os.path.join(empty_out, "report.json")))
+        self.assertFalse(os.path.exists(empty_cache))
+
+
 if __name__ == "__main__":
     unittest.main()

