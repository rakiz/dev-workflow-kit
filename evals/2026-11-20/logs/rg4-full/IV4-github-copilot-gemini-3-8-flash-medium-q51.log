+class BooleanTransformTests(unittest.TestCase):
+    def test_affirmative_forms(self):
+        for val in ["yes", "YES", "Yes", "true", "TRUE", "True", "  yes ", " True \n"]:
+            self.assertEqual(transforms.apply("boolean", val), 1.0)
+
+    def test_negative_forms(self):
+        for val in ["no", "NO", "No", "false", "FALSE", "False", "  no ", " False \n"]:
+            self.assertEqual(transforms.apply("boolean", val), 0.0)
+
+    def test_invalid_inputs(self):
+        for val in ["maybe", "0", "1", "t", "f", "y", "n", "", "   ", "trueish"]:
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", val)
+
+    def test_end_to_end_boolean(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-bool-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        inp = os.path.join(tmp, "in")
+        os.makedirs(inp)
+        with open(os.path.join(inp, "bools.csv"), "w") as fh:
+            fh.write("id,active\n1,yes\n2,no\n3,true\n4,FALSE\n")
+        rules_path = os.path.join(tmp, "rules.toml")
+        with open(rules_path, "w") as fh:
+            fh.write('[transforms]\nactive = "boolean"\n')
+        out = os.path.join(tmp, "out")
+        cache_path = os.path.join(tmp, "cache", "state.json")
+        report = reportgen.run(rules_path, inp, out, cache_path)
+        cols = report["files"]["bools.csv"]["summary"]["columns"]
+        self.assertEqual(cols["active"]["distinct"], 2)
+        self.assertEqual(cols["active"]["sample"], [0.0, 1.0])
+        self.assertEqual(cols["active"]["numeric_sum"], 2.0)
+
+
+class CacheHygieneTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-hygiene-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_dir = os.path.join(self.tmp, "cache")
+        self.cache_path = os.path.join(self.cache_dir, "state.json")
+        os.makedirs(self.cache_dir)
+
+    def test_future_top_level_version_does_not_crash_and_rewrites_valid_state(self):
+        with open(self.cache_path, "w") as fh:
+            json.dump({"version": 3, "schema_version": "99.0", "bogus_entry": {}}, fh)
+        report = reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+        self.assertEqual(report["total_rows"], 12012)
+        state = cache.load_state(self.cache_path)
+        self.assertNotIn("version", state)
+        self.assertNotIn("schema_version", state)
+        self.assertNotIn("bogus_entry", state)
+        self.assertIn("small_transactions.csv", state)
+        self.assertEqual(state["small_transactions.csv"]["registry_version"], cache.REGISTRY_VERSION)
+
+    def test_future_entry_version_does_not_crash_and_rewrites_valid_state(self):
+        with open(self.cache_path, "w") as fh:
+            json.dump({
+                "small_transactions.csv": {
+                    "digest": "fake",
+                    "rows": 999,
+                    "registry_version": "3",
