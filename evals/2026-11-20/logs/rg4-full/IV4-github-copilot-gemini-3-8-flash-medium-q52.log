+    def test_entry_with_older_registry_version_not_reused(self):
+        os.makedirs(os.path.dirname(self.cache_path), exist_ok=True)
+        tx_path = os.path.join(INPUT_DIR, "small_transactions.csv")
+        digest = cache.file_digest(tx_path)
+        rules = reportgen.load_rules(RULES)
+        rules_fp = cache.rules_fingerprint(rules)
+        stale_state = {
+            "small_transactions.csv": {
+                "digest": digest,
+                "rows": 999,
+                "generated_from": 3,
+                "rules_fp": rules_fp,
+                "registry_version": "1",
+                "summary": {"columns": {}, "skipped_rows": []},
+            }
+        }
+        with open(self.cache_path, "w", encoding="utf-8") as fh:
+            json.dump(stale_state, fh)
+        report = self.run_tool()
+        self.assertEqual(report["files"]["small_transactions.csv"]["rows"], 4)
+
+
+class RegressionAndInvariantTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-regression-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+
+    def test_rules_file_read_at_most_once_per_run(self):
+        read_count = 0
+        real_load_rules = reportgen.load_rules
+
+        def counting_load_rules(path):
+            nonlocal read_count
+            read_count += 1
+            return real_load_rules(path)
+
+        orig = reportgen.load_rules
+        reportgen.load_rules = counting_load_rules
+        try:
+            reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+        finally:
+            reportgen.load_rules = orig
+        self.assertEqual(read_count, 1)
+
+    def test_failure_policy_leaves_previous_outputs_intact_byte_for_byte(self):
+        reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+        html_path = os.path.join(self.out, "report.html")
+        json_path = os.path.join(self.out, "report.json")
+        with open(html_path, "rb") as fh:
+            good_html = fh.read()
+        with open(json_path, "rb") as fh:
+            good_json = fh.read()
+        with open(self.cache_path, "rb") as fh:
+            good_cache = fh.read()
+
+        bad_in = os.path.join(self.tmp, "bad_in")
+        os.makedirs(bad_in)
+        shutil.copy(os.path.join(INPUT_DIR, "small_devices.csv"), bad_in)
+        with open(os.path.join(bad_in, "bad.csv"), "w") as fh:
+            fh.write("col\ninvalid_bool\n")
+        bad_rules = os.path.join(self.tmp, "bad_rules.toml")
+        with open(bad_rules, "w") as fh:
+            fh.write('[transforms]\ncol = "boolean"\n')
+
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(bad_rules, bad_in, self.out, self.cache_path)
+
+        with open(html_path, "rb") as fh:
+            self.assertEqual(fh.read(), good_html)
+        with open(json_path, "rb") as fh:
+            self.assertEqual(fh.read(), good_json)
+        with open(self.cache_path, "rb") as fh:
+            self.assertEqual(fh.read(), good_cache)
+
+    def test_failure_policy_emits_nothing_new(self):
+        fresh_out = os.path.join(self.tmp, "fresh_out")
+        fresh_cache = os.path.join(self.tmp, "fresh_cache", "state.json")
+        bad_in = os.path.join(self.tmp, "bad_in2")
+        os.makedirs(bad_in)
+        with open(os.path.join(bad_in, "bad.csv"), "w") as fh:
+            fh.write("val\nnot_valid\n")
+        bad_rules = os.path.join(self.tmp, "bad_rules2.toml")
+        with open(bad_rules, "w") as fh:
+            fh.write('[transforms]\nval = "round2"\n')
+
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(bad_rules, bad_in, fresh_out, fresh_cache)
+
+        self.assertFalse(os.path.exists(fresh_out))
+        self.assertFalse(os.path.exists(fresh_cache))
+
+    def test_failure_policy_unhandled_crash_covered(self):
+        fresh_out = os.path.join(self.tmp, "fresh_out3")
+        fresh_cache = os.path.join(self.tmp, "fresh_cache3", "state.json")
+        bad_in = os.path.join(self.tmp, "bad_in3")
+        os.makedirs(bad_in)
+        with open(os.path.join(bad_in, "crash.csv"), "w") as fh:
+            fh.write("val\nanything\n")
+        rules_path = os.path.join(self.tmp, "crash_rules.toml")
+        with open(rules_path, "w") as fh:
+            fh.write('[transforms]\nval = "crasher"\n')
+
+        orig = transforms.REGISTRY.copy()
+        def crasher(v):
+            raise ZeroDivisionError("unexpected division by zero")
+        transforms.REGISTRY["crasher"] = crasher
+        try:
+            with self.assertRaises(reportgen.ValidationError):
+                reportgen.run(rules_path, bad_in, fresh_out, fresh_cache)
+        finally:
+            transforms.REGISTRY = orig
+
+        self.assertFalse(os.path.exists(fresh_out))
+        self.assertFalse(os.path.exists(fresh_cache))
+
+    def test_main_exits_1_on_failure(self):
+        bad_in = os.path.join(self.tmp, "bad_in4")
+        os.makedirs(bad_in)
+        with open(os.path.join(bad_in, "bad.csv"), "w") as fh:
+            fh.write("col\nbad\n")
+        bad_rules = os.path.join(self.tmp, "bad_rules4.toml")
+        with open(bad_rules, "w") as fh:
+            fh.write('[transforms]\ncol = "boolean"\n')
+
+        with self.assertRaises(SystemExit) as cm:
+            reportgen.main(["--rules", bad_rules, "--input", bad_in,
+                            "--output", self.out, "--cache", self.cache_path])
+        self.assertEqual(cm.exception.code, 1)
+
+
 if __name__ == "__main__":
     unittest.main()

