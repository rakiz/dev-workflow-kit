 REGISTRY_VERSION = "2"
 
 
+def is_future_version(val):
+    """Check if a version value is greater than the current REGISTRY_VERSION."""
+    if isinstance(val, bool):
+        return False
+    if isinstance(val, (int, float)):
+        return float(val) > float(REGISTRY_VERSION)
+    if isinstance(val, str):
+        cleaned = val.lstrip("vV").strip()
+        try:
+            return float(cleaned) > float(REGISTRY_VERSION)
+        except ValueError:
+            pass
+        try:
+            val_parts = [int(p) for p in cleaned.split(".") if p.isdigit()]
+            cur_parts = [int(p) for p in REGISTRY_VERSION.split(".") if p.isdigit()]
+            return val_parts > cur_parts
+        except Exception:
+            pass
+    return False
+
+
+def is_future_schema(obj):
+    """Return True if the JSON structure contains any version field greater
+    than REGISTRY_VERSION or is not a dict."""
+    if not isinstance(obj, dict):
+        return True
+    for k, v in obj.items():
+        if "version" in k.lower() and is_future_version(v):
+            return True
+        if isinstance(v, dict):
+            if is_future_schema(v):
+                return True
+    return False
+
+
