    try:
        return int(str(value).strip())
    except ValueError:
        return None


def _is_future(state):
    """True when the state carries a version field greater than
    REGISTRY_VERSION, at the top level or on any entry."""
    current = int(REGISTRY_VERSION)
    candidates = [state.get(k) for k in
                  ("version", "registry_version", "schema_version")]
    candidates += [e.get("registry_version") for e in state.values()
                   if isinstance(e, dict)]
    for value in candidates:
        number = _version_number(value) if value is not None else None
        if number is not None and number > current:
            return True
    return False


def load_state(path=DEFAULT_CACHE_PATH):
    """Load the cache state; a missing file is just an empty cache, and so
    is a state written by a future schema version."""
    if not os.path.exists(path):
        return {}
    with open(path, "r", encoding="utf-8") as fh:
        state = json.load(fh)
    if not isinstance(state, dict) or _is_future(state):
        return {}
    return state
