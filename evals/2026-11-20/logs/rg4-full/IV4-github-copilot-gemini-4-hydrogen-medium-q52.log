+def _version_tuple(val):
+    if isinstance(val, bool):
+        return None
+    if isinstance(val, int):
+        return (val,)
+    if isinstance(val, str):
+        s = val.strip().lstrip("vV")
+        if not s:
+            return None
+        parts = s.split(".")
+        try:
+            return tuple(int(p) for p in parts)
+        except ValueError:
+            return None
+    return None
+
+
+def _is_future_version(val):
+    vt = _version_tuple(val)
+    cur = _version_tuple(REGISTRY_VERSION)
+    return vt is not None and cur is not None and vt > cur
