+def reusable_entry(entry, digest, rules_fp):
+    """True when a cache entry can be replayed instead of recomputed: the
+    file is unchanged, the rules mapping is unchanged, and the entry was
+    produced by the current transform registry."""
+    if not isinstance(entry, dict):
+        return False
+    required = ("digest", "rules_fp", "rows", "generated_from", "summary",
+                "registry_version")
+    if any(key not in entry for key in required):
+        return False
+    if not isinstance(entry["summary"], dict):
+        return False
+    if entry["digest"] != digest or entry["rules_fp"] != rules_fp:
+        return False
+    return (cache.as_version(entry["registry_version"])
+            == cache.as_version(cache.REGISTRY_VERSION))
+
+
