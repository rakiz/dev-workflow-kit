"""reportgen — summarize CSV inputs through per-column transforms.

Reads every *.csv in the input directory, applies the per-column
transforms from a rules file, and writes a JSON summary plus an HTML
rendering of the same summary to the output directory. A content cache
(cache/state.json) lets unchanged inputs skip re-transformation on later
runs.

Usage:
    python3 reportgen.py [--rules rules.example.toml] [--input input]
                         [--output output] [--cache cache/state.json]
"""

import argparse
import csv
import json
import os
import sys

import cache
import transforms

DEFAULT_RULES = "rules.example.toml"
DEFAULT_INPUT = "input"
DEFAULT_OUTPUT = "output"


class ValidationError(Exception):
    """Raised when a summary was derived from an incomplete transform
    pass (at least one cell failed its transform)."""


def load_rules(path):
    """Load a rules file. Only the [transforms] table is read; it maps
    column name -> transform name. Other tables are reserved for future
    report options and ignored."""
    rules = {}
    section = None
    with open(path, "r", encoding="utf-8") as fh:
        for lineno, raw in enumerate(fh, start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip()
                continue
            if "=" not in line:
                raise ValueError('%s:%d: expected key = "value"' % (path, lineno))
            key, _, value = line.partition("=")
            if section == "transforms":
                rules[key.strip().strip('"')] = value.strip().strip('"')
    return rules


def load_rows(path):
    """Return (header, data_rows). Blank physical lines are not rows;
    quoted cells may span physical lines."""
    with open(path, "r", encoding="utf-8", newline="") as fh:
        reader = csv.reader(fh)
        header = next(reader)
        return header, [row for row in reader if row]


def summarize_file(header, data_rows, rules):
    """Column-level summary of one input file: per column, the non-empty
    cell count, the distinct count over transformed values, the first
    three distinct values in sorted order, and the numeric sum when every
    transformed value is a float. Cells that fail their transform are
    skipped and recorded in `skipped_rows`."""
    columns = {}
    skipped_rows = []
    for row_no, row in enumerate(data_rows, start=2):
        for i, col in enumerate(header):
            raw = row[i] if i < len(row) else ""
            tname = rules.get(col)
            if tname:
                try:
                    value = transforms.apply(tname, raw)
                except transforms.TransformError as exc:
                    skipped_rows.append(
                        {"row": row_no, "column": col, "reason": str(exc)})
                    continue
            else:
                value = raw
            stats = columns.setdefault(col, {"non_empty": 0, "values": set()})
            if raw != "":
                stats["non_empty"] += 1
            stats["values"].add(value)
    out = {}
    for col in sorted(columns):
        stats = columns[col]
        values = stats["values"]
        entry = {"non_empty": stats["non_empty"], "distinct": len(values),
                 "sample": sorted(values, key=str)[:3]}
        numeric = [v for v in values if isinstance(v, float)]
        if numeric and len(numeric) == len(values):
            entry["numeric_sum"] = round(sum(sorted(numeric)), 2)
        out[col] = entry
    return {"columns": out, "skipped_rows": skipped_rows}


def generated_from(header, data_rows, rules):
    """Number of rules-mapped columns that have at least one non-empty
    cell in the file."""
    non_empty = set()
    for row in data_rows:
        for i, col in enumerate(header):
            if i < len(row) and row[i] != "":
                non_empty.add(col)
    return sum(1 for col in header if col in rules and col in non_empty)


def validate_summary(summary):
    """Reject a summary that was derived from cells that failed their
    transform."""
    skipped = summary.get("skipped_rows") or []
    if skipped:
        first = skipped[0]
        raise ValidationError(
            "%d cell(s) failed their transform (first: row %s, column %s)"
            % (len(skipped), first["row"], first["column"]))


def render_html(report):
    """Render the summary as a standalone HTML page, one table per file."""
    parts = ["<!doctype html>",
             "<html><head><meta charset='utf-8'>",
             "<title>reportgen summary</title></head><body>"]
    for name in sorted(report["files"]):
        res = report["files"][name]
        parts.append("<h1>%s</h1>" % name)
        parts.append("<p>%d rows</p>" % res["rows"])
        parts.append("<table border='1'>")
        parts.append("<tr><th>column</th><th>non_empty</th>"
                     "<th>distinct</th><th>sample</th></tr>")
        summary = res["summary"]["columns"]
        for col in sorted(summary):
            stats = summary[col]
            sample = ", ".join(str(v) for v in stats["sample"])
            parts.append("<tr><td>%s</td><td>%d</td><td>%d</td><td>%s</td></tr>"
                         % (col, stats["non_empty"], stats["distinct"], sample))
        parts.append("</table>")
    parts.append("</body></html>")
    return "\n".join(parts)


def run(rules_path, input_dir, output_dir, cache_path):
    """Run one full pass over the input directory and write the report."""
    state = cache.load_state(cache_path)

    names = sorted(n for n in os.listdir(input_dir) if n.endswith(".csv"))
    results = {}
    pending = {}
    for name in names:
        rules = load_rules(rules_path)
        rules_fp = cache.rules_fingerprint(rules)
        path = os.path.join(input_dir, name)
        digest = cache.file_digest(path)
        entry = state.get(name)
        header, data_rows = load_rows(path)
        print("reportgen: %s: parsed %d rows" % (name, len(data_rows)))
        if entry and entry["digest"] == digest and entry.get("rules_fp") == rules_fp:
            results[name] = {"digest": digest, "rows": entry["rows"],
                             "generated_from": entry["generated_from"],
                             "summary": entry["summary"]}
        else:
            summary = summarize_file(header, data_rows, rules)
            results[name] = {"digest": digest, "rows": len(data_rows),
                             "generated_from": generated_from(header, data_rows, rules),
                             "summary": summary}
            pending[name] = cache.make_entry(path, digest, len(data_rows),
                                             summary, rules, rules_fp)
            cache.save_state(pending, path=cache_path)

    report = {"rules": rules_path,
              "total_rows": sum(r["rows"] for r in results.values()),
              "files": results}
    os.makedirs(output_dir, exist_ok=True)
    with open(os.path.join(output_dir, "report.html"), "w", encoding="utf-8") as fh:
        fh.write(render_html(report))
    for name in sorted(results):
        validate_summary(results[name]["summary"])
    with open(os.path.join(output_dir, "report.json"), "w", encoding="utf-8") as fh:
        json.dump(report, fh, indent=2, sort_keys=True)
        fh.write("\n")
    return report


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="summarize CSV inputs through per-column transforms")
    parser.add_argument("--rules", default=DEFAULT_RULES,
                        help="rules TOML file mapping columns to transforms")
    parser.add_argument("--input", default=DEFAULT_INPUT,
                        help="directory of input CSV files")
    parser.add_argument("--output", default=DEFAULT_OUTPUT,
                        help="directory for report.json / report.html")
    parser.add_argument("--cache", default=cache.DEFAULT_CACHE_PATH,
                        help="path of the cache state file")
    args = parser.parse_args(argv)
    try:
        return run(args.rules, args.input, args.output, args.cache)
    except ValidationError as exc:
        sys.stderr.write("reportgen: warning: %s\n" % exc)
        return None


if __name__ == "__main__":
    main()
"""Column transforms for reportgen.

A rules file maps a column name to a transform name; the registry below is
the single source of truth for what those names mean. Each transform takes
the raw string cell and returns the transformed value — numeric transforms
return floats, everything else returns strings.

The registry is versioned: every cache entry is stamped with the registry
version it was produced under (cache.REGISTRY_VERSION, stamped by
make_entry) and the version is compared at lookup, so a summary written
under an older registry is never reused.
"""


class TransformError(Exception):
    """Raised when a cell cannot be transformed under its column's rule."""


def trim(value):
    return value.strip()


def upper(value):
    return value.upper()


def lower(value):
    return value.lower()


def currency_amount(value):
    """'$1,234.5' -> 1234.5 (float, rounded to 2 decimals)."""
    cleaned = value.replace("$", "").replace(",", "").strip()
    try:
        return round(float(cleaned), 2)
    except ValueError:
        raise TransformError("not a currency amount: %r" % value)


def round2(value):
    """Parse a float and round it to 2 decimals."""
    try:
        return round(float(value.strip()), 2)
    except ValueError:
        raise TransformError("not a number: %r" % value)


def date_iso(value):
    """'MM/DD/YYYY' -> 'YYYY-MM-DD'."""
    parts = value.strip().split("/")
    if len(parts) != 3 or len(parts[2]) != 4:
        raise TransformError("not a MM/DD/YYYY date: %r" % value)
    month, day, year = (p.strip() for p in parts)
    if not (month.isdigit() and day.isdigit() and year.isdigit()):
        raise TransformError("not a MM/DD/YYYY date: %r" % value)
    return "%s-%02d-%02d" % (year, int(month), int(day))


REGISTRY = {
    "trim": trim,
    "upper": upper,
    "lower": lower,
    "currency_amount": currency_amount,
    "round2": round2,
    "date_iso": date_iso,
}


def apply(name, value):
    """Apply the named transform to a raw cell. An empty name is a
    passthrough; an unknown name raises TransformError."""
    if not name:
        return value
    fn = REGISTRY.get(name)
    if fn is None:
        raise TransformError("unknown transform: %r" % name)
    return fn(value)
"""Content cache for reportgen.

Layout: cache/state.json maps each input file name to one entry:

    {"digest":           "<sha256 of the file bytes>",
     "rows":             <int>,
     "generated_from":   <int>,
     "rules_fp":         "<fingerprint of the rules mapping>",
     "registry_version": "<version of the transform registry>",
     "summary":          {...}}

Entries are reused when the file on disk is byte-identical to the file
processed in the previous run and the rules mapping is unchanged;
save_state() rewrites the state file after every run so it always mirrors
what the last run saw.
"""

import csv
import hashlib
import json
import os

DEFAULT_CACHE_PATH = os.path.join("cache", "state.json")

REGISTRY_VERSION = "2"


def file_digest(path):
    """sha256 of the file bytes (streamed, constant memory)."""
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return h.hexdigest()


def rules_fingerprint(rules):
    """Stable fingerprint of the effective column -> transform mapping."""
    payload = json.dumps(rules, sort_keys=True, separators=(",", ":"))
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]


def load_state(path=DEFAULT_CACHE_PATH):
    """Load the cache state; a missing file is just an empty cache."""
    if not os.path.exists(path):
        return {}
    with open(path, "r", encoding="utf-8") as fh:
        return json.load(fh)


def save_state(entries, path=DEFAULT_CACHE_PATH):
    """Merge `entries` into the state file, keeping entries for inputs the
    run did not touch (a run may cover a subset of the inputs)."""
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    merged = {}
    if os.path.exists(path):
        merged = load_state(path)
    merged.update(entries)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        json.dump(merged, fh, indent=2, sort_keys=True)
        fh.write("\n")
    os.replace(tmp, path)


def make_entry(path, digest, rows, summary, rules, rules_fp):
    """Build a cache entry for `path`. `generated_from` is the number of
    header columns covered by the rules mapping."""
    with open(path, "r", encoding="utf-8", newline="") as fh:
        header = next(csv.reader(fh))
    generated_from = sum(1 for col in header if col in rules)
    return {"digest": digest, "rows": rows, "generated_from": generated_from,
            "rules_fp": rules_fp, "registry_version": REGISTRY_VERSION,
            "summary": summary}
