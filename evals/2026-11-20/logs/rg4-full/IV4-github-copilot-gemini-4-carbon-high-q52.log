import builtins, os, shutil, tempfile, reportgen

tmp = tempfile.mkdtemp(prefix="rg3-measure-")
try:
    real_open = builtins.open
    rules_abs = os.path.abspath("rules.example.toml")
    cold_reads = []
    warm_reads = []

    def spy_cold(file, *args, **kwargs):
        if os.path.abspath(str(file)) == rules_abs:
            cold_reads.append(file)
        return real_open(file, *args, **kwargs)

    builtins.open = spy_cold
    try:
        reportgen.main(["--rules", "rules.example.toml",
                        "--output", os.path.join(tmp, "out"),
                        "--cache", os.path.join(tmp, "cache", "state.json")])
    finally:
        builtins.open = real_open

    def spy_warm(file, *args, **kwargs):
        if os.path.abspath(str(file)) == rules_abs:
            warm_reads.append(file)
        return real_open(file, *args, **kwargs)

    builtins.open = spy_warm
    try:
        reportgen.main(["--rules", "rules.example.toml",
                        "--output", os.path.join(tmp, "out"),
                        "--cache", os.path.join(tmp, "cache", "state.json")])
    finally:
        builtins.open = real_open

    print("cold_reads:", len(cold_reads), "warm_reads:", len(warm_reads))
finally:
    shutil.rmtree(tmp, ignore_errors=True)
