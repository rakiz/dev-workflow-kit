import builtins, os, tempfile, shutil
import reportgen
rules = os.path.abspath("rules.example.toml")
orig_open = builtins.open
count = {"rules": 0}
def counting_open(file, *a, **k):
    try:
        if os.path.abspath(file) == rules:
            count["rules"] += 1
    except TypeError:
        pass
    return orig_open(file, *a, **k)
builtins.open = counting_open
tmp = tempfile.mkdtemp()
try:
    reportgen.run(rules, "input", os.path.join(tmp,"out"), os.path.join(tmp,"cache","state.json"))
finally:
    builtins.open = orig_open
    shutil.rmtree(tmp, ignore_errors=True)
print("RULES_FILE_READS_PER_RUN =", count["rules"])
