 DEFAULT_CACHE_PATH = os.path.join("cache", "state.json")
 
 REGISTRY_VERSION = "2"
 
+_VERSION_KEYS = ("version", "registry_version", "schema_version")
 
+
+def _parse_version(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, (int, float)):
+        return float(value)
+    if isinstance(value, str):
+        s = value.strip()
+        if s.startswith(("v", "V")):
+            s = s[1:]
+        try:
+            return float(s)
+        except ValueError:
+            head = s.split(".", 1)[0]
+            if head.isdigit():
+                return float(head)
+            return None
+    return None
+
+
+def _has_future_version(obj):
+    current = _parse_version(REGISTRY_VERSION)
+    if isinstance(obj, dict):
+        for key in _VERSION_KEYS:
+            if key in obj:
+                parsed = _parse_version(obj[key])
+                if parsed is not None and parsed > current:
+                    return True
+        for key, val in obj.items():
+            if key == "summary":
+                continue
+            if isinstance(val, (dict, list)) and _has_future_version(val):
+                return True
+    elif isinstance(obj, list):
+        return any(_has_future_version(item)
+                   for item in obj if isinstance(item, (dict, list)))
+    return False
+
+
