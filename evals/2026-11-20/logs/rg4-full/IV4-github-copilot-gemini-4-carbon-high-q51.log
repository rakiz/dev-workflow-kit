import builtins, os, shutil, tempfile, reportgen
tmp = tempfile.mkdtemp()
rules_abs = os.path.abspath("rules.example.toml")
reads = 0
orig_open = builtins.open
def counting_open(file, mode="r", *args, **kwargs):
    global reads
    if "r" in mode and os.path.abspath(str(file)) == rules_abs:
        reads += 1
    return orig_open(file, mode, *args, **kwargs)
builtins.open = counting_open
try:
    reportgen.run("rules.example.toml", "input", os.path.join(tmp, "out"), os.path.join(tmp, "cache", "state.json"))
    print("pre-change rules reads:", reads)
finally:
    builtins.open = orig_open
    shutil.rmtree(tmp)
