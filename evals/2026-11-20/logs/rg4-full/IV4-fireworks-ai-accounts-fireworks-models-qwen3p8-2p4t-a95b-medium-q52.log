+        with open(self.cache_path, "w") as fh:
+            json.dump(state, fh)
+        report = reportgen.run(self.rules, self.inp, self.out, self.cache_path)
+        self.assertEqual(report["files"]["good.csv"]["summary"]["skipped_rows"],
