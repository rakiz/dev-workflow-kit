import os, sys, time, json, shutil, resource
sys.path.insert(0, '/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-38624')
import synccli

S = '/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1-measure'
SRC = os.path.join(S,'tree'); STAGE = os.path.join(S,'stage'); BASE = os.path.join(S,'base')
for p in (STAGE, BASE):
    shutil.rmtree(p, ignore_errors=True)

def rss():
    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss  # bytes on macOS

def state(root, rel):
    st = os.lstat(os.path.join(root, rel))
    return {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "ctime_ns": st.st_ctime_ns,
            "ino": st.st_ino, "mode": st.st_mode}

def build(root, rels):
    return {r: state(root, r) for r in rels}

def copy_chunked(src, dst, bs=1<<20, do_fsync=True):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    fd = os.open(dst, os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o644)
    with open(src,'rb') as f, os.fdopen(fd,'wb') as g:
        while True:
            b = f.read(bs)
            if not b: break
            g.write(b)
        g.flush()
        if do_fsync: os.fsync(g.fileno())

# ---- phase 1: scan (existing synccli.scan_files) ----
t=time.time(); rels = synccli.scan_files(SRC); t_scan=time.time()-t
# ---- phase 2: full manifest, lstat ns ----
t=time.time(); man = build(SRC, rels); t_stat=time.time()-t
files = len(rels); total = sum(v['size'] for v in man.values())
print("FILES %d BYTES %d" % (files, total))
print("scan_files        %.3fs  %.1f us/file" % (t_scan, t_scan/files*1e6))
print("manifest lstat    %.3fs  %.1f us/file" % (t_stat, t_stat/files*1e6))
print("maxrss after scan %d MiB" % (rss()//2**20))

# ---- phase 3: full stage build, chunked copy + per-file fsync ----
t=time.time()
for i, r in enumerate(rels):
    copy_chunked(os.path.join(SRC,r), os.path.join(STAGE,r), do_fsync=True)
t_copy=time.time()-t
print("full stage copy+fsync %.3fs  %.1f MiB/s  %.1f ms/file" % (t_copy, (total/2**20)/t_copy, t_copy/files*1e3))

# manifest write
mpath = os.path.join(STAGE,'manifest.json')
t=time.time()
with open(mpath,'w') as f: json.dump(man, f)
os.fsync(os.open(mpath, os.O_RDONLY))
t_man=time.time()-t
print("manifest write+fsync %.3fs  %d bytes  %.0f B/entry" % (t_man, os.path.getsize(mpath), os.path.getsize(mpath)/files))
print("maxrss after copy  %d MiB" % (rss()//2**20))

# publish
t=time.time(); os.rename(STAGE, BASE); fd=os.open(S, os.O_RDONLY); os.fsync(fd); t_pub=time.time()-t
print("publish rename+dirfsync %.4fs" % t_pub)

# ---- phase 4: incremental run, all unchanged: scan+stat+hardlink+manifest ----
t=time.time()
rels2 = synccli.scan_files(SRC)
man2 = build(SRC, rels2)
t_meta=time.time()-t
t=time.time()
STAGE2 = os.path.join(S,'stage2'); shutil.rmtree(STAGE2, ignore_errors=True)
linked=0
for r in rels2:
    d = os.path.join(STAGE2,r); os.makedirs(os.path.dirname(d), exist_ok=True)
    os.link(os.path.join(BASE,r), d); linked+=1
t_link=time.time()-t
print("incremental scan+stat %.3fs (%.1f us/file), hardlink %d files %.3fs (%.2f ms/file)" %
      (t_meta, t_meta/files*1e6, linked, t_link, t_link/files*1e3))
print("maxrss end         %d MiB" % (rss()//2**20))
