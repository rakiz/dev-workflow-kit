import os, sys, time, shutil, fcntl, ctypes, ctypes.util, json
sys.path.insert(0,'/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-38624')
import snaputil, synccli
S='/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1-measure'
roots=[os.path.join(S,'tree')]
rels=synccli.scan_files(roots[0])
def free(): st=os.statvfs(S); return st.f_bavail*st.f_frsize
libc=ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True); clone=libc.clonefile
clone.argtypes=[ctypes.c_char_p,ctypes.c_char_p,ctypes.c_int]
def mk(name, mode):
    d=os.path.join(S,name); shutil.rmtree(d, ignore_errors=True)
    f0=free(); t=time.time()
    for r in rels:
        p=os.path.join(d,r); os.makedirs(os.path.dirname(p), exist_ok=True)
        s=os.path.join(roots[0],r)
        if mode=='clone':
            assert clone(os.fsencode(s), os.fsencode(p), 0)==0
        elif mode=='link':
            os.link(s,p)
        else:
            shutil.copyfile(s,p)
    return d, free()-f0, time.time()-t
for mode in ('copy','link','clone'):
    d,delta,dt=mk('x_'+mode, mode)
    print("%-6s 20k files 1GiB: wall %6.2fs  free-space delta %+d MiB" % (mode, dt, delta//2**20))

