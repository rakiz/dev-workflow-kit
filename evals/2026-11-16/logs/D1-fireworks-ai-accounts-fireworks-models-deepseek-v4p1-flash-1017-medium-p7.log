import os, sys, time, json, shutil, resource, ctypes, ctypes.util
sys.path.insert(0, '/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-38624')
import synccli
S = '/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1-measure'
SRC = os.path.join(S,'tree')
rels = synccli.scan_files(SRC); F=len(rels)
def timed(label, fn):
    t=time.time(); r=fn(); d=time.time()-t
    print("%-38s %7.3fs  %s" % (label, d, ("%.1f us/file" % (d/F*1e6)) if F else ""))
    return r
def walk_stat(paths=False, follow=False):
    out={}
    for dp, dns, fns in os.walk(SRC):
        for n in fns:
            full=os.path.join(dp,n)
            st = os.lstat(full) if paths else os.stat(full)
            out[os.path.relpath(full,SRC)] = st.st_size
    return out
def scandir_walk():
    out={}
    stack=[SRC]
    while stack:
        d=stack.pop()
        with os.scandir(d) as it:
            for e in it:
                if e.is_dir(follow_symlinks=False): stack.append(e.path)
                elif e.is_file(follow_symlinks=False):
                    st=e.stat(follow_symlinks=False)
                    out[os.path.relpath(e.path,SRC)] = st.st_size
    return out
timed("path os.stat (synccli.build_manifest)", lambda: synccli.build_manifest(SRC))
timed("path os.lstat", lambda: walk_stat(paths=True))
timed("scandir entry.stat(follow=False)", scandir_walk)

# copy variants
CLONE=None
try:
    libc = ctypes.CDLL(ctypes.util.find_library('c'), use_errno=True)
    CLONE = libc.clonefile
    CLONE.argtypes=[ctypes.c_char_p, ctypes.c_char_p, ctypes.c_int]
except Exception as e:
    print("clonefile unavailable", e)
def stage(name):
    d=os.path.join(S,name); shutil.rmtree(d, ignore_errors=True); return d
def copy_all(dst, bs=1<<20, fsync=0):
    for r in rels:
        p=os.path.join(dst,r); os.makedirs(os.path.dirname(p), exist_ok=True)
        fd=os.open(p, os.O_WRONLY|os.O_CREAT|os.O_TRUNC, 0o644)
        with open(os.path.join(SRC,r),'rb') as f, os.fdopen(fd,'wb') as g:
            while True:
                b=f.read(bs)
                if not b: break
                g.write(b)
            if fsync==1: os.fsync(g.fileno())
            elif fsync==2: os.fsync(g.fileno())
def hardlink_all(dst):
    for r in rels:
        p=os.path.join(dst,r); os.makedirs(os.path.dirname(p), exist_ok=True)
        os.link(os.path.join(SRC,r), p)
def clone_all(dst):
    for r in rels:
        p=os.path.join(dst,r); os.makedirs(os.path.dirname(p), exist_ok=True)
        if CLONE(os.fsencode(os.path.join(SRC,r)), os.fsencode(p), 0)!=0:
            raise OSError(ctypes.get_errno(), "clonefile")
d=stage('s_nofsync'); timed("copy 20k files, 1MiB blocks, no fsync", lambda: copy_all(d, fsync=0))
d=stage('s_fsync');   timed("copy 20k files, per-file os.fsync", lambda: copy_all(d, fsync=1))
d=stage('s_hard');    timed("hardlink 20k files (same volume)", lambda: hardlink_all(d))
if CLONE:
    d=stage('s_clone'); timed("clonefile 20k files (APFS CoW)", lambda: clone_all(d))

# single large file throughput, no fsync
big=os.path.join(S,'big.bin')
if not os.path.exists(big):
    with open(os.path.join(SRC,'d000','f00000.dat'),'rb') as f, open(big,'wb') as g:
        while True:
            b=f.read(1<<20)
            if not b: break
            g.write(b)
def bigcopy():
    with open(big,'rb') as f, open(os.path.join(S,'big.bin.copy'),'wb') as g:
        while True:
            b=f.read(1<<20)
            if not b: break
            g.write(b)
t=time.time(); bigcopy(); d=time.time()-t
sz=os.path.getsize(big)
print("1MiB-chunk copy single %d MiB file: %.3fs  %.0f MiB/s" % (sz//2**20, d, (sz/2**20)/d))
# whole-file read (what synccli.copy_file does) on 1 file, RSS delta
def rss(): return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
before=rss()
with open(big,'rb') as f: data=f.read()
after=rss()
print("synccli.copy_file style read(): maxrss %d -> %d MiB (delta %d MiB) for %d MiB file" %
      (before//2**20, after//2**20, (after-before)//2**20, sz//2**20))
