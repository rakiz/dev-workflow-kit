for n in ('snap-20261116-120000-00','snap-20261116-130000-00'): os.makedirs(os.path.join(root,n))
print("list_snapshots:", snaputil.list_snapshots(root))

# flock auto-release on process death
lf=os.path.join(root,'.lock'); fd=os.open(lf, os.O_CREAT|os.O_RDWR)
fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
import subprocess
r=subprocess.run([sys.executable,'-c',
