The incremental no-change run linked all 30,000 files but still took 11.7 s, about the same as a full copy. Hardlink creation looks like the cost, not data copying. I'll isolate per-file metadata costs (empty create, hardlink, lstat) before setting the budget.
[0m$ [0mcd /private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1 && cat > micro.py <<'EOF'
import os, sys, time, json, shutil
sys.dont_write_bytecode = True
BASE = "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1"
SNAP = os.path.join(BASE, "runE", "snap-x")
rels = []
for dp, dn, fn in os.walk(SNAP):
    for n in fn:
        if n != "MANIFEST.json":
            rels.append(os.path.relpath(os.path.join(dp, n), SNAP))
rels.sort()
out = os.path.join(BASE, "micro_out")
mode = sys.argv[1]
shutil.rmtree(out, ignore_errors=True); os.makedirs(out)
made = set()
def mk(rel):
    d = os.path.dirname(os.path.join(out, rel))
    if d not in made:
        os.makedirs(d, exist_ok=True); made.add(d)
t0 = time.perf_counter()
if mode == "link":
    for r in rels:
        mk(r); os.link(os.path.join(SNAP, r), os.path.join(out, r))
elif mode == "empty":
    for r in rels:
        mk(r); open(os.path.join(out, r), "wb").close()
elif mode == "lstat":
    for r in rels:
        os.lstat(os.path.join(SNAP, r))
elif mode == "mkdirs":
    for r in rels:
        mk(r)
print(json.dumps({"mode": mode, "files": len(rels), "seconds": round(time.perf_counter() - t0, 3)}))
