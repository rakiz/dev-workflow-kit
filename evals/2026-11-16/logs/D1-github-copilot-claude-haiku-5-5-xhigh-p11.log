import subprocess, shutil, os, json, time, sys
BASE = "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1"
T = os.path.join(BASE, "tree")
def clean(*paths):
    for p in paths:
        shutil.rmtree(p, ignore_errors=True)
    subprocess.run(["sync"]); time.sleep(2)
def run(args):
    out = subprocess.run([sys.executable, os.path.join(BASE, "proto.py")] + args,
                         capture_output=True, text=True, timeout=900)
    lines = [l for l in out.stdout.splitlines() if l.startswith("{\"mode\"")]
    if out.returncode or not lines:
        print("FAILED", args, out.stderr[-500:]); return None
    return json.loads(lines[-1])
results = []
which = sys.argv[1]
if which == "full":
    for i in range(3):
        d = os.path.join(BASE, f"trial_sync{i}"); clean(d); os.makedirs(d)
        r = subprocess.run(["python3", "-c", f"import sys,time;sys.path.insert(0,'/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-87362');import synccli;t=time.perf_counter();synccli.sync('{T}','{d}');print('SYNCCLI', round(time.perf_counter()-t,3))"], capture_output=True, text=True, timeout=900)
        print("synccli full", r.stdout.strip(), r.stderr[-200:])
        clean(d)
    for i in range(5):
        d = os.path.join(BASE, f"trial_full{i}"); clean(d); os.makedirs(d)
        print("proto full nofsync", run(["full", T, d]))
        clean(d)
    for i in range(3):
        d = os.path.join(BASE, f"trial_fsync{i}"); clean(d); os.makedirs(d)
        print("proto full fsync", run(["full", T, d, "--fsync"]))
        clean(d)
elif which == "read":
    for i in range(3):
        print("scan", run(["scan", T, "x"]))
        print("read", run(["read", T, "x"]))
        print("hash", run(["hash", T, "x"]))
elif which == "incr":
    E = os.path.join(BASE, "runE", "snap-x")
    for i in range(3):
        d = os.path.join(BASE, f"trial_inc0_{i}"); clean(d); os.makedirs(d)
        print("incr nochange", run(["full", T, d, "--base", E]))
        clean(d)
elif which == "incr1pct":
    E = os.path.join(BASE, "runE", "snap-x")
    for i in range(3):
        d = os.path.join(BASE, f"trial_inc1_{i}"); clean(d); os.makedirs(d)
        print("incr 1pct", run(["full", T, d, "--base", E]))
        clean(d)
