[0m$ [0mcat > /private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1/gen_tree.py <<'EOF'
import os, random, math, sys
ROOT = sys.argv[1]
N_FILES = 30000
TARGET = 1_000_000_000
rng = random.Random(1)
# lognormal sizes, rescaled to ~1 GB total
sizes = [max(1, int(rng.lognormvariate(8.5, 1.6))) for _ in range(N_FILES)]
scale = TARGET / sum(sizes)
sizes = [max(1, int(s * scale)) for s in sizes]
block = os.urandom(1 << 20)
total = 0
for i, sz in enumerate(sizes):
    d = os.path.join(ROOT, f"eval-{i // 100:03d}", f"sub-{(i // 10) % 10}")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"r{i:05d}.dat"), "wb") as f:
        left = sz
        while left > 0:
            n = min(left, len(block))
            f.write(block[:n]); left -= n
    total += sz
print("files", N_FILES, "bytes", total, "median", sorted(sizes)[N_FILES // 2], "max", max(sizes))
EOF
