[0m$ [0mcat > /private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1/proto.py <<'EOF'
"""Scratch prototype of the DESIGN-d1 copy path (NOT part of the repo).
Usage: proto.py MODE SRC SNAPROOT [BASE_SNAP_DIR] [--fsync]
MODE: scan | read | hash | full | synccli
"""
import os, sys, json, hashlib, time, resource, shutil
sys.dont_write_bytecode = True
CHUNK = 1 << 20
RACY_NS = 2_000_000_000  # 2 s margin (FAT granularity)

def walk_entries(src, errors):
    out = []
    for dirpath, dirnames, filenames in os.walk(src, onerror=errors.append):
        for name in filenames:
            full = os.path.join(dirpath, name)
            out.append((os.path.relpath(full, src), full))
    return out

def copy_hash(full, dst, fsync):
    """Stream-copy full -> dst while hashing; fstat before/after to detect torn reads."""
    fd = os.open(full, os.O_RDONLY | os.O_NOFOLLOW if False else os.O_RDONLY)
    h = hashlib.sha256()
    try:
        st0 = os.fstat(fd)
        with os.fdopen(fd, "rb") as fsrc, open(dst, "wb") as fdst:
            fd = None
            while True:
                buf = fsrc.read(CHUNK)
                if not buf:
                    break
                h.update(buf)
                fdst.write(buf)
            st1 = os.fstat(fsrc.fileno())
            if fsync:
                fdst.flush(); os.fsync(fdst.fileno())
    finally:
        if fd is not None:
            os.close(fd)
    torn = (st0.st_size, st0.st_mtime_ns, st0.st_ctime_ns) != (st1.st_size, st1.st_mtime_ns, st1.st_ctime_ns)
    return [st1.st_size, st1.st_mtime_ns, st1.st_ctime_ns, st1.st_ino, h.hexdigest(), torn]

def main():
    mode, src, snaproot = sys.argv[1], sys.argv[2], sys.argv[3]
    base = sys.argv[4] if len(sys.argv) > 4 and not sys.argv[4].startswith("--") else None
    fsync = "--fsync" in sys.argv
    t0 = time.perf_counter()
    errors = []
    if mode == "synccli":
        sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-87362")
        import synccli
        synccli.sync(src, snaproot)
        n = None
    elif mode == "scan":
        n = len(walk_entries(src, errors))
        for _, full in walk_entries(src, errors):
            os.lstat(full)
    elif mode in ("read", "hash"):
        n = 0
        for _, full in walk_entries(src, errors):
            h = hashlib.sha256() if mode == "hash" else None
            with open(full, "rb") as f:
                while True:
                    b = f.read(CHUNK)
                    if not b: break
                    if h: h.update(b)
            n += 1
    elif mode == "full":
        start_ns = time.time_ns()
        staging = os.path.join(snaproot, ".staging-x")
        snap = os.path.join(snaproot, "snap-x")
        os.makedirs(staging)
        baseline = {}
        if base:
            bm = json.load(open(os.path.join(base, "MANIFEST.json")))
            baseline = bm["files"]; bstart = bm["started_ns"]
        entries = walk_entries(src, errors)
        manifest = {}
        linked = copied = 0
        made = set()
        for rel, full in entries:
            st = os.lstat(full)
            key = [st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino]
            b = baseline.get(rel)
            dst = os.path.join(staging, rel)
            d = os.path.dirname(dst)
            if d not in made:
                os.makedirs(d, exist_ok=True); made.add(d)
            if b and b[:4] == key and b[1] < bstart - RACY_NS and b[2] < bstart - RACY_NS:
                os.link(os.path.join(base, rel), dst)
                manifest[rel] = b; linked += 1
            else:
                manifest[rel] = copy_hash(full, dst, fsync); copied += 1
        n = len(entries)
        doc = {"started_ns": start_ns, "files": manifest}
        tmp = os.path.join(staging, "MANIFEST.json.tmp")
        with open(tmp, "w") as f:
            json.dump(doc, f, separators=(",", ":"))
            f.flush(); os.fsync(f.fileno())
        os.rename(tmp, os.path.join(staging, "MANIFEST.json"))
        os.rename(staging, snap)
        print(json.dumps({"linked": linked, "copied": copied, "manifest_bytes":
                          os.path.getsize(os.path.join(snap, "MANIFEST.json"))}))
    el = time.perf_counter() - t0
    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss  # bytes on darwin
    print(json.dumps({"mode": mode, "fsync": fsync, "base": bool(base), "entries": n,
                      "seconds": round(el, 3), "max_rss_MB": round(rss / 1e6, 1), "errors": len(errors)}))

main()
EOF
