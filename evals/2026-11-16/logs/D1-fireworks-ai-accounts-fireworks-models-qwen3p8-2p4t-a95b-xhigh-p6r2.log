All mechanism claims verified. One last check — flock must be released when the holder dies (the crash-recovery premise):
[0m$ [0mpython3 - <<'EOF'
import fcntl, os, signal, subprocess, sys, tempfile, time
W = tempfile.mkdtemp(prefix="verify_flock_")
lp = os.path.join(W, ".lock")
child = subprocess.Popen([sys.executable, "-c",
    "import fcntl,os,time;"
    f"fd=os.open({lp!r}, os.O_CREAT|os.O_RDWR);"
    "fcntl.flock(fd, fcntl.LOCK_EX);"
    "print('held', flush=True); time.sleep(60)"], stdout=subprocess.PIPE, text=True)
assert child.stdout.readline().strip() == "held"
fd = os.open(lp, os.O_CREAT|os.O_RDWR)
try:
    fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB); print("acquired while child alive (!)")
except BlockingIOError:
    print("blocked while child alive: True")
os.kill(child.pid, signal.SIGKILL); child.wait()
time.sleep(0.2)
try:
    fcntl.flock(fd, fcntl.LOCK_EX|fcntl.LOCK_NB)
    print("acquired after SIGKILL of holder: True")
except BlockingIOError:
    print("still blocked after kill (!)")
