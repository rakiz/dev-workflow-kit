print("B2 held fd reads after rmtree:", os.read(fd, 10))
os.close(fd)

# --- C. hardlink: newer snapshot survives rmtree of older; mtime preserved ---
os.rename(os.path.join(root, ".trash"), os.path.join(root, ".trash2"))  # keep root clean
shutil.rmtree(os.path.join(root, ".trash2"))
# rebuild snap1
st1 = os.path.join(root, ".staging-s1"); os.makedirs(os.path.join(st1, "tree", "evals"))
src = os.path.join(W, "src", "evals"); os.makedirs(src)
with open(os.path.join(src, "keep.bin"), "wb") as f: f.write(b"K"*1000)
os.utime(os.path.join(src, "keep.bin"), (1000000, 1000000))  # fixed old mtime
synccli.copy_file(os.path.join(src, "keep.bin"), os.path.join(st1, "tree", "evals", "keep.bin"))
pub_staging(".staging-s1", "snap-20261116-120001-00")
# snap2 links unchanged file from snap1
st2 = os.path.join(root, ".staging-s2"); os.makedirs(os.path.join(st2, "tree", "evals"))
prev = snaputil.safe_snapshot_path(root, "snap-20261116-120001-00", "evals/keep.bin")
new  = os.path.join(st2, "tree", "evals", "keep.bin")
os.link(prev, new)
pub_staging(".staging-s2", "snap-20261116-120002-00")
print("C1 link preserves mtime:", os.stat(new).st_mtime == 1000000)
shutil.rmtree(os.path.join(root, "snap-20261116-120001-00"))   # prune older
p2 = snaputil.safe_snapshot_path(root, "snap-20261116-120002-00", "evals/keep.bin")
print("C2 newer snapshot intact after older rmtree:", open(p2,"rb").read(3), os.stat(p2).st_size)

# --- D. flock collision ---
lockpath = os.path.join(root, ".lock")
fd1 = os.open(lockpath, os.O_CREAT|os.O_RDWR)
