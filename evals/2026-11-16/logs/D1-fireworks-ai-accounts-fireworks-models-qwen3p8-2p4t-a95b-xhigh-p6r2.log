def pub(staging, final): os.rename(os.path.join(root, staging), os.path.join(root, final))

# --- C. hardlink survival + mtime facts ---
st1 = os.path.join(root, ".staging-s1"); os.makedirs(os.path.join(st1, "tree", "evals"))
src = os.path.join(W, "src", "evals"); os.makedirs(src)
