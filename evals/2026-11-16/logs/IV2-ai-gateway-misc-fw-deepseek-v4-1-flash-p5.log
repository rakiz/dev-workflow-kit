try:
    out=os.path.join(tmp,"out"); cp=os.path.join(tmp,"cache","state.json")
    os.makedirs(os.path.dirname(cp))
    open(cp,"w").write(json.dumps({"small_transactions.csv":{"registry_version":"999","data":{"x":1}}}))
    rep=reportgen.run(R, IN, out, cp)
    st=cache.load_state(cp)
    print("future ok, version:", st["small_transactions.csv"]["registry_version"], "all current:", all(v["registry_version"]==cache.REGISTRY_VERSION for v in st.values()))
finally: shutil.rmtree(tmp, ignore_errors=True)

# generated_from consistency
