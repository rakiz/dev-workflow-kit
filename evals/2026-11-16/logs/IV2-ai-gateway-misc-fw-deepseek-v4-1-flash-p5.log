try:
    out=os.path.join(tmp,"out"); cp=os.path.join(tmp,"cache","state.json")
    r1=reportgen.run(R, IN, out, cp); r2=reportgen.run(R, IN, out, cp)
    print("gf devices:", r1["files"]["small_devices.csv"]["generated_from"], r2["files"]["small_devices.csv"]["generated_from"])
    print("reports equal:", r1==r2)
finally: shutil.rmtree(tmp, ignore_errors=True)
