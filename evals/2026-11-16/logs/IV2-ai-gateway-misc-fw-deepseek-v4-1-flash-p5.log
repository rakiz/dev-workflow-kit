try:
    inp=os.path.join(tmp,"in"); os.makedirs(inp)
    open(os.path.join(inp,"t.csv"),"w").write("item,label\n1,alpha\nbad,beta\n")
    rules=os.path.join(tmp,"rules.toml"); open(rules,"w").write('[transforms]\nitem = "round2"\n')
    out=os.path.join(tmp,"out"); cp=os.path.join(tmp,"cache","state.json")
    try: reportgen.run(rules, inp, out, cp); print("NO RAISE BAD")
    except reportgen.ValidationError as e: print("invariant raise:", e)
    print("html:", os.path.exists(os.path.join(out,"report.html")), "json:", os.path.exists(os.path.join(out,"report.json")), "cache:", os.path.exists(cp))
finally: shutil.rmtree(tmp, ignore_errors=True)

# future cache
