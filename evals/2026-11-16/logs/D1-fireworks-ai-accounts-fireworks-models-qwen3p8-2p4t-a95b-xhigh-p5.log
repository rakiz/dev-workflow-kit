for dd in dirs: os.makedirs(os.path.join(d7, dd), exist_ok=True)
for rel in rels:
    with open(os.path.join(SRC, rel), "rb") as fi, open(os.path.join(d7, rel), "wb") as fo:
        shutil.copyfileobj(fi, fo, 1 << 20); fo.flush(); os.fsync(fo.fileno())
t_full = t() - t0
print(f"8 FULL backup precreated+fsync: {t_full:.2f}s = {t_full/N*1e6:.0f} us/file, {N*50*1024/t_full/1e6:.0f} MB/s")

# 9. incremental unchanged the backupctl way: precreated dirs + pure links
d9 = os.path.join(BASE, "micro9")
t0 = t()
for dd in dirs: os.makedirs(os.path.join(d9, dd), exist_ok=True)
for rel in rels:
    os.link(snaputil.safe_snapshot_path(ROOT, base_snap, rel), os.path.join(d9, rel))
t_link = t() - t0
print(f"9 link-tree precreated: {t_link:.2f}s = {t_link/N*1e6:.0f} us/file")

# cleanup micro trees to keep disk tidy
