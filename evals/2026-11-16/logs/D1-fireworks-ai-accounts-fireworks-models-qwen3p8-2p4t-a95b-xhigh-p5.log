        shutil.copyfileobj(fi, fo, 1 << 20)
print(f"2 copy precreated dirs: {(t()-t0)/N*1e6:7.1f} us/file (no fsync, no makedirs)")

# 3. same + fsync
d3 = os.path.join(BASE, "micro3")
for rel in rels: os.makedirs(os.path.join(d3, os.path.dirname(rel)), exist_ok=True)
t0 = t()
for rel in rels:
    with open(os.path.join(SRC, rel), "rb") as fi, open(os.path.join(d3, rel), "wb") as fo:
        shutil.copyfileobj(fi, fo, 1 << 20); fo.flush(); os.fsync(fo.fileno())
print(f"3 copy + fsync:         {(t()-t0)/N*1e6:7.1f} us/file (precreated dirs)")

# 4. per-file makedirs(exist_ok) cost alone
d4 = os.path.join(BASE, "micro4")
for rel in rels: os.makedirs(os.path.join(d4, os.path.dirname(rel)), exist_ok=True)
t0 = t()
for rel in rels: os.makedirs(os.path.join(d4, os.path.dirname(rel)), exist_ok=True)
print(f"4 makedirs exist_ok:     {(t()-t0)/N*1e6:7.1f} us/file (dirs already exist)")

# 5. pure os.link, dirs precreated
