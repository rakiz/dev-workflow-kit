print(f"5 link precreated dirs: {(t()-t0)/N*1e6:7.1f} us/file")

# 6. os.link + per-file makedirs (what bench.py measured)
d6 = os.path.join(BASE, "micro6")
t0 = t()
for rel in rels:
    dst = os.path.join(d6, rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    os.link(snaputil.safe_snapshot_path(ROOT, base_snap, rel), dst)
print(f"6 link + makedirs:       {(t()-t0)/N*1e6:7.1f} us/file")

# 7. dir-precreate cost from the scan list (unique dirnames)
d7 = os.path.join(BASE, "micro7")
t0 = t()
dirs = {os.path.dirname(r) for r in rels}
for dd in dirs: os.makedirs(os.path.join(d7, dd), exist_ok=True)
print(f"7 precreate {len(dirs)} dirs from scan list: {t()-t0:.3f}s total")

# 8. full backup the backupctl way: precreated dirs + chunked copy + fsync
