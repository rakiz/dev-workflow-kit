import json, os, resource, shutil, sys, tempfile, time, tracemalloc
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-62445")
import synccli, snaputil

TMP = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode"
BASE = tempfile.mkdtemp(dir=TMP)
SRC = os.path.join(BASE, "src")
ROOT = os.path.join(BASE, "backup")          # backup root
os.makedirs(SRC); os.makedirs(ROOT)
N = 20000; SIZE = 50 * 1024; TOTAL_GB = N * SIZE / 1e9

def t(): return time.monotonic()

# ---- fixture: 20,000 files x 50 KB in 200 dirs (~1.0 GB) ----
t0 = t()
data = os.urandom(1024) * (SIZE // 1024)
for i in range(N):
    d = os.path.join(SRC, f"dir_{i//100:03d}")
    if i % 100 == 0: os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"f{i:05d}.dat"), "wb") as f: f.write(data)
t_build = t() - t0
print(f"fixture: {N} files, {TOTAL_GB:.2f} GB, build {t_build:.1f}s")

# ---- A. scan+stat (synccli.build_manifest) + memory per entry ----
tracemalloc.start()
t0 = t(); man = synccli.build_manifest(SRC); t_scan = t() - t0
cur, peak = tracemalloc.get_traced_memory(); tracemalloc.stop()
mem_per_entry = peak / N
print(f"A scan build_manifest: {t_scan:.2f}s total, {t_scan/N*1e6:.1f} us/file, tracemalloc peak {peak/1e6:.1f} MB -> {mem_per_entry:.0f} B/entry")

# ---- helpers: backupctl's overridden copier (chunked + fsync + reported result) ----
CHUNK = 1 << 20
def copy_chunked(src, dst, fsync=True):
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(src, "rb") as fi, open(dst, "wb") as fo:
        shutil.copyfileobj(fi, fo, CHUNK)
        if fsync: fo.flush(); os.fsync(fo.fileno())

def full_backup(src, staging, fsync=True, limit=None):
    t0 = t(); copied = 0; nbytes = 0
    rels = synccli.scan_files(src)
    if limit: rels = rels[:limit]
    for rel in rels:
        s = os.path.join(src, rel)
        copy_chunked(s, os.path.join(staging, rel), fsync=fsync)
        copied += 1; nbytes += os.path.getsize(s)
    return t() - t0, copied, nbytes

# ---- B. full backup, chunked + per-file fsync (the headline number) ----
st1 = os.path.join(ROOT, "staging", "run-full")
t_full, copied, nbytes = full_backup(SRC, st1, fsync=True)
print(f"B full copy chunked+fsync: {t_full:.1f}s, {nbytes/1e6:.0f} MB, {nbytes/t_full/1e6:.0f} MB/s, {t_full/copied*1e6:.0f} us/file")

# ---- C. fsync overhead + whole-read baseline on a 2,000-file subset ----
sub = os.path.join(BASE, "sub_src"); os.makedirs(sub)
rels = synccli.scan_files(SRC)[:2000]
for rel in rels:
    d = os.path.join(sub, rel); os.makedirs(os.path.dirname(d), exist_ok=True)
    shutil.copyfile(os.path.join(SRC, rel), d)
dt_nf, _, nb_nf = full_backup(sub, os.path.join(BASE, "sub_dst_nf"), fsync=False)
dt_f,  _, _     = full_backup(sub, os.path.join(BASE, "sub_dst_f"),  fsync=True)
fsync_us = (dt_f - dt_nf) / 2000 * 1e6
print(f"C subset 2000: nofsync {dt_nf:.2f}s ({nb_nf/dt_nf/1e6:.0f} MB/s), fsync {dt_f:.2f}s -> fsync overhead ~{fsync_us:.0f} us/file")

# whole-read (synccli.copy_file) throughput + memory blowup on one 50 MB file
t0 = t()
for rel in rels: synccli.copy_file(os.path.join(sub, rel), os.path.join(BASE, "sub_dst_wr", rel))
dt_wr = t() - t0
print(f"C synccli.copy_file whole-read: {dt_wr:.2f}s ({nb_nf/dt_wr/1e6:.0f} MB/s)")
big = os.path.join(BASE, "big50m.bin")
with open(big, "wb") as f: f.write(os.urandom(1024)* (50*1024*1024//1024))
tracemalloc.start()
synccli.copy_file(big, os.path.join(BASE, "big50m.copy"))
cur, peak = tracemalloc.get_traced_memory(); tracemalloc.stop()
print(f"C whole-read 50 MB file: tracemalloc peak {peak/1e6:.0f} MB (unbounded in file size)")
tracemalloc.start()
copy_chunked(big, os.path.join(BASE, "big50m.copy2"), fsync=False)
cur, peak2 = tracemalloc.get_traced_memory(); tracemalloc.stop()
print(f"C chunked 1 MiB same file: peak {peak2/1e6:.2f} MB (constant)")

# ---- D. index write/load ----
def commit(staging, name):
    idx = os.path.join(staging, "snapshot.json")
    tmpidx = idx + ".tmp"
    with open(tmpidx, "w") as f:
        json.dump({"format": 1, "files": man}, f)
        f.flush(); os.fsync(f.fileno())
    os.rename(tmpidx, idx)
    dfd = os.open(staging, os.O_RDONLY); os.fsync(dfd); os.close(dfd)
    os.rename(staging, os.path.join(ROOT, name))
    rfd = os.open(ROOT, os.O_RDONLY); os.fsync(rfd); os.close(rfd)

t0 = t(); commit(st1, "snap-20261116-000000-00"); t_commit = t() - t0
idx_path = os.path.join(ROOT, "snap-20261116-000000-00", "snapshot.json")
idx_bytes = os.path.getsize(idx_path)
tracemalloc.start()
t0 = t()
with open(idx_path) as f: base_idx = json.load(f)["files"]
t_load = t() - t0
cur, peak = tracemalloc.get_traced_memory(); tracemalloc.stop()
print(f"D index: {idx_bytes/1e6:.2f} MB ({idx_bytes/N:.0f} B/entry), commit {t_commit:.2f}s, json.load {t_load:.2f}s, peak {peak/1e6:.1f} MB -> {peak/N:.0f} B/entry")

t0 = t(); ch = synccli.changed_files(base_idx, man); t_diff = t() - t0
print(f"D changed_files(20k,20k) identical: {len(ch)} changed, {t_diff*1e3:.0f} ms")

# ---- E. incremental run, nothing changed (scan + diff + 20k hardlinks + index) ----
def link_tree(base_name, new_manifest, changed, staging):
    t0 = t(); nlink = 0
    ch = set(changed)
    for rel, st in new_manifest.items():
        dst = os.path.join(staging, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if rel in ch:
            copy_chunked(os.path.join(SRC, rel), dst, fsync=True)
        else:
            os.link(snaputil.safe_snapshot_path(ROOT, base_name, rel), dst)
            nlink += 1
    return t() - t0, nlink

t0 = t(); man2 = synccli.build_manifest(SRC); t_scan2 = t() - t0
ch2 = synccli.changed_files(base_idx, man2)
st2 = os.path.join(ROOT, "staging", "run-inc0"); os.makedirs(os.path.dirname(st2), exist_ok=True)
t_link, nlink = link_tree("snap-20261116-000000-00", man2, ch2, st2)
man = man2; commit(st2, "snap-20261116-010000-00")
print(f"E incremental unchanged: changed={len(ch2)}, scan {t_scan2:.2f}s + link {t_link:.2f}s ({t_link/nlink*1e6:.0f} us/file, {nlink} links) + commit {t_commit:.2f}s ~ total {t_scan2+t_link+t_diff+t_commit:.2f}s")
stn = os.stat(os.path.join(ROOT, "snap-20261116-000000-00", "dir_000", "f00000.dat"))
print(f"E dedup check: st_nlink of base file after link-run = {stn.st_nlink}")

# ---- F. incremental run, 5% changed (1,000 files rewritten) ----
t0 = t()
for i in range(0, 1000):
    p = os.path.join(SRC, f"dir_{i//100:03d}", f"f{i:05d}.dat")
    with open(p, "wb") as f: f.write(data[::-1])
t_touch = t() - t0
t0 = t(); man3 = synccli.build_manifest(SRC); t_scan3 = t() - t0
ch3 = synccli.changed_files(base_idx, man3)
st3 = os.path.join(ROOT, "staging", "run-inc5")
t_mix, nlink3 = link_tree("snap-20261116-010000-00", man3, ch3, st3)
man = man3; commit(st3, "snap-20261116-020000-00")
print(f"F incremental 5%: touched {1000} in {t_touch:.1f}s; changed detected={len(ch3)}; scan {t_scan3:.2f}s + copy/link {t_mix:.2f}s + commit ~ total {t_scan3+t_mix+t_diff+t_commit:.2f}s")

# ---- G. retention/prune cost + apparent vs true disk ----
t0 = t()
apparent = {n: snaputil.snapshot_disk_usage(ROOT, n) for n in snaputil.list_snapshots(ROOT)}
t_du = t() - t0
true_bytes = 0; seen = set()
for n in snaputil.list_snapshots(ROOT):
    for dp, dn, fn in os.walk(os.path.join(ROOT, n)):
        for f in fn:
            stt = os.stat(os.path.join(dp, f))
            if stt.st_ino not in seen: seen.add(stt.st_ino); true_bytes += stt.st_size
print(f"G disk: apparent per snapshot {{ {', '.join(f'{k}:{v/1e6:.0f}MB' for k,v in apparent.items())} }}, true unique {true_bytes/1e6:.0f} MB; du-scan took {t_du:.1f}s")
t0 = t(); deleted = snaputil.prune_snapshots(ROOT, 2); t_prune = t() - t0
print(f"G prune(keep=2) deleted {deleted} in {t_prune:.1f}s (1 GB rmtree); remaining {snaputil.list_snapshots(ROOT)}")

# ---- H. crash-leftover sweep cost (rmtree of a staging tree) ----
stx = os.path.join(ROOT, "staging", "run-dead")
full_backup(SRC, stx, fsync=False, limit=2000)
t0 = t(); shutil.rmtree(stx); t_sweep = t() - t0
print(f"H sweep: rmtree of 2000-file staging leftover: {t_sweep:.2f}s")

print(f"Z process peak RSS: {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.0f} MB")
print("BASE", BASE)
