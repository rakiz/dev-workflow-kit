[0m$ [0mcd /tmp/bx && cat > proto.py <<'EOF'
import os, sys, time, json, hashlib, shutil, resource, stat
SRC="/tmp/bx/src"; 
FSYNC = os.environ.get("FSYNC","1")=="1"
HASH = os.environ.get("HASH","1")=="1"
def scan(root):
    out={}
    for dp,dns,fns in os.walk(root):
        for n in fns:
            p=os.path.join(dp,n); st=os.lstat(p)
            out[os.path.relpath(p,root)]={"size":st.st_size,"mtime_ns":st.st_mtime_ns,"ctime_ns":st.st_ctime_ns}
    return out
def copy(src,dst,fsync,hash_):
    h=hashlib.sha256() if hash_ else None
    fd=os.open(src,os.O_RDONLY)
    try:
        st=os.fstat(fd)
        with os.fdopen(os.open(dst,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600),"wb",buffering=0) as o:
            while True:
                b=os.read(fd,1<<20)
                if not b: break
                if h: h.update(b)
                o.write(b)
            if fsync: os.fsync(o.fileno())
        os.utime(dst,ns=(st.st_atime_ns,st.st_mtime_ns))
        os.chmod(dst,stat.S_IMODE(st.st_mode))
    finally: os.close(fd)
    return h.hexdigest() if h else None
def run(tag, prev_root, prev_idx):
    t0=time.perf_counter()
    cur=scan(SRC); t_scan=time.perf_counter()-t0
    stg=f"/tmp/bx/bk/.staging-{tag}"; shutil.rmtree(stg,ignore_errors=True); os.makedirs(stg)
    made=set(); nl=nc=0; t1=time.perf_counter(); tl=tc=0
    idx={}
    for rel,s in sorted(cur.items()):
        d=os.path.dirname(rel)
        if d not in made: os.makedirs(os.path.join(stg,d),exist_ok=True); made.add(d)
        o=prev_idx.get(rel)
        if o and o["size"]==s["size"] and o["mtime_ns"]==s["mtime_ns"] and o["ctime_ns"]==s["ctime_ns"]:
            a=time.perf_counter(); os.link(os.path.join(prev_root,rel),os.path.join(stg,rel)); tl+=time.perf_counter()-a; nl+=1
            idx[rel]=dict(s,sha256=o.get("sha256"))
        else:
            a=time.perf_counter(); hx=copy(os.path.join(SRC,rel),os.path.join(stg,rel),FSYNC,HASH); tc+=time.perf_counter()-a; nc+=1
            idx[rel]=dict(s,sha256=hx)
    t_cp=time.perf_counter()-t1
    t2=time.perf_counter()
    if FSYNC:
        for dp,dns,fns in os.walk(stg):
            fd=os.open(dp,os.O_RDONLY); os.fsync(fd); os.close(fd)
    os.makedirs(stg+"/.backupctl")
    with open(stg+"/.backupctl/index.jsonl","w") as f:
        for rel,s in idx.items(): f.write(json.dumps([rel,s["size"],s["mtime_ns"],s["ctime_ns"],s["sha256"]],separators=(",",":"))+"\n")
        f.flush(); os.fsync(f.fileno())
    final=f"/tmp/bx/bk/snap-{tag}"; os.rename(stg,final)
    t_commit=time.perf_counter()-t2
    print(f"{tag}: scan {t_scan:.2f}s  materialize {t_cp:.2f}s (link {nl} in {tl:.2f}s, copy {nc} in {tc:.2f}s)  finalize(dirsync+index+rename) {t_commit:.2f}s  TOTAL {time.perf_counter()-t0:.2f}s  maxrss {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.0f}MB")
    return final, idx
if __name__=="__main__":
    shutil.rmtree("/tmp/bx/bk",ignore_errors=True); os.makedirs("/tmp/bx/bk")
    print("FSYNC",FSYNC,"HASH",HASH)
    r1,i1=run("a","",{})
    r2,i2=run("b",r1,i1)
EOF
