import os,time,shutil,sys
from concurrent.futures import ThreadPoolExecutor
prev="/tmp/bx/bk/snap-a"
files=[]
for dp,dn,fn in os.walk(prev):
    for n in fn:
        if ".backupctl" in dp: continue
        files.append(os.path.relpath(os.path.join(dp,n),prev))
print(len(files))
def go(workers,tag):
    stg=f"/tmp/bx/lk-{tag}"; shutil.rmtree(stg,ignore_errors=True)
    dirs={os.path.dirname(f) for f in files}
    for d in dirs: os.makedirs(os.path.join(stg,d),exist_ok=True)
    t=time.perf_counter()
    if workers==1:
        for f in files: os.link(os.path.join(prev,f),os.path.join(stg,f))
    else:
        with ThreadPoolExecutor(workers) as ex: list(ex.map(lambda f: os.link(os.path.join(prev,f),os.path.join(stg,f)),files))
    print(tag,workers,"threads: link",round(time.perf_counter()-t,2),"s")
    t=time.perf_counter(); shutil.rmtree(stg); print("   rmtree",round(time.perf_counter()-t,2),"s")
for w in (1,4,8): go(w,f"w{w}")
