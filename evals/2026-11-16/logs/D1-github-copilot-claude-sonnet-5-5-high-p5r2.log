import os,sys,time,json,shutil,resource,tracemalloc
sys.path.insert(0,"/tmp/bx")
import proto
from proto import scan, copy
from concurrent.futures import ThreadPoolExecutor
SRC=proto.SRC
def run(tag,prev_root,prev_idx,W=4):
    t0=time.perf_counter(); cur=scan(SRC); ts=time.perf_counter()-t0
    stg=f"/tmp/bx/bk/.staging-{tag}"; shutil.rmtree(stg,ignore_errors=True); os.makedirs(stg)
    t1=time.perf_counter()
    for d in {os.path.dirname(r) for r in cur}: os.makedirs(os.path.join(stg,d),exist_ok=True)
    def one(item):
        rel,s=item; o=prev_idx.get(rel)
        if o and o["size"]==s["size"] and o["mtime_ns"]==s["mtime_ns"] and o["ctime_ns"]==s["ctime_ns"]:
            os.link(os.path.join(prev_root,rel),os.path.join(stg,rel)); return rel,dict(s,sha256=o["sha256"]),0
        return rel,dict(s,sha256=copy(os.path.join(SRC,rel),os.path.join(stg,rel),True,True)),1
    with ThreadPoolExecutor(W) as ex: res=list(ex.map(one,sorted(cur.items())))
    tm=time.perf_counter()-t1; t2=time.perf_counter()
    for dp,dn,fn in os.walk(stg):
        fd=os.open(dp,os.O_RDONLY); os.fsync(fd); os.close(fd)
    os.makedirs(stg+"/.backupctl"); idx={r:s for r,s,_ in res}
    with open(stg+"/.backupctl/index.jsonl","w") as f:
        for r,s in idx.items(): f.write(json.dumps([r,s["size"],s["mtime_ns"],s["ctime_ns"],s["sha256"]],separators=(",",":"))+"\n")
        f.flush(); os.fsync(f.fileno())
    final=f"/tmp/bx/bk/snap-{tag}"; os.rename(stg,final)
    print(f"{tag}: scan {ts:.2f} materialize {tm:.2f} (copied {sum(c for _,_,c in res)}) finalize {time.perf_counter()-t2:.2f} TOTAL {time.perf_counter()-t0:.2f}s maxrss {resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6:.0f}MB")
    return final,idx
shutil.rmtree("/tmp/bx/bk",ignore_errors=True); os.makedirs("/tmp/bx/bk")
def df(): return int(os.popen("df -k /tmp/bx | tail -1").read().split()[2])
d0=df(); r1,i1=run("a","",{}); d1=df(); r2,i2=run("b",r1,i1); d2=df(); r3,i3=run("c",r2,i2); d3=df()
print("df delta KB: full",d1-d0,"incr-b",d2-d1,"incr-c",d3-d2)
# one changed file
p=SRC+"/d000/s00/f00000.dat"; open(p,"ab").write(b"x")
r4,i4=run("d",r3,i3)
