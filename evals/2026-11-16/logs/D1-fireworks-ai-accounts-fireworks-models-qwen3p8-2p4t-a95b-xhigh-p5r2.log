import os, sys, json, time, shutil
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-62543")
import synccli

BK = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/bkperf"
src, dst1 = os.path.join(BK, "src"), os.path.join(BK, "dst1")

def link_pass(target):
    n = 0
    for dirpath, dirnames, filenames in os.walk(dst1):
        for name in filenames:
            if name == synccli.MANIFEST_NAME:
                continue
            full = os.path.join(dirpath, name)
            tgt = os.path.join(target, os.path.relpath(full, dst1))
            os.makedirs(os.path.dirname(tgt), exist_ok=True)
            os.link(full, tgt)
            n += 1
    return n

st0 = os.statvfs(BK)
t0 = time.time()
n = link_pass(os.path.join(BK, "dst2"))
t_link = time.time() - t0
st1 = os.statvfs(BK)
meta = (st0.f_bfree - st1.f_bfree) * st0.f_frsize
print(f"os.link x{n} (with makedirs): {t_link:.2f}s -> {t_link/n*1e6:.0f} us/link")
print(f"disk used by {n} links: {meta/1e6:.1f} MB -> ~{meta/n:.0f} B/link metadata")

# big-file throughput: whole-read (copy_file) vs chunked copyfileobj
big = os.path.join(BK, "big.bin")
buf = os.urandom(50 * 1024)
with open(big, "wb") as f:
    for _ in range(10240):
        f.write(buf)
szb = os.path.getsize(big)
t0 = time.time()
synccli.copy_file(big, os.path.join(BK, "big_whole.bin"))
t_whole = time.time() - t0
t0 = time.time()
with open(big, "rb") as a, open(os.path.join(BK, "big_chunk.bin"), "wb") as b:
    shutil.copyfileobj(a, b, 65536)
t_chunk = time.time() - t0
print(f"single {szb/1e6:.0f} MB file: whole-read copy_file {t_whole:.2f}s ({szb/1e6/t_whole:.0f} MB/s), chunked-64KB {t_chunk:.2f}s ({szb/1e6/t_chunk:.0f} MB/s)")

# small-file per-file overhead: 20k x 1 KB
small = os.path.join(BK, "small_src")
buf1k = os.urandom(1024)
for d in range(40):
    dd = os.path.join(small, f"run-{d:04d}")
    os.makedirs(dd, exist_ok=True)
    for i in range(500):
        with open(os.path.join(dd, f"f-{i:05d}.dat"), "wb") as f:
            f.write(buf1k)
t0 = time.time()
synccli.sync(small, os.path.join(BK, "small_dst"))
t_small = time.time() - t0
bytes_small = 20000 * 1024
r_w = szb / t_chunk
t_pf = (t_small - bytes_small / r_w) / 20000
print(f"sync 20k x 1KB ({bytes_small/1e6:.0f} MB): {t_small:.2f}s -> per-file overhead ~{t_pf*1e6:.0f} us/file (after subtracting bytes @ {r_w/1e6:.0f} MB/s)")

# steady-state backupctl run simulation: 1% of files changed
buf2 = os.urandom(50 * 1024)
for i in range(200):
    with open(os.path.join(src, "run-0000", f"f-{i:05d}.dat"), "wb") as f:
        f.write(buf2)
prev = json.load(open(os.path.join(dst1, synccli.MANIFEST_NAME)))
t0 = time.time(); new = synccli.build_manifest(src); t_scan = time.time() - t0
t0 = time.time(); changed = synccli.changed_files(prev, new); t_cmp = time.time() - t0
changed_set = set(changed)
stage = os.path.join(BK, "stage")
t0 = time.time()
nlink = 0
for rel, state in new.items():
    if rel in changed_set:
        continue
    tgt = os.path.join(stage, rel)
    os.makedirs(os.path.dirname(tgt), exist_ok=True)
    os.link(os.path.join(dst1, rel), tgt)
    nlink += 1
t_links = time.time() - t0
t0 = time.time()
for rel in changed:
    synccli.copy_file(os.path.join(src, rel), os.path.join(stage, rel))
t_copy = time.time() - t0
t0 = time.time()
with open(os.path.join(stage, "manifest.json"), "w") as f:
    json.dump(new, f, separators=(",", ":"))
t_man = time.time() - t0
print(f"steady-state sim: changed={len(changed)} (expect 200), scan={t_scan:.2f}s, cmp={t_cmp:.3f}s, links({nlink})={t_links:.2f}s, copy({len(changed)})={t_copy:.2f}s, manifest={t_man:.3f}s, TOTAL={t_scan+t_cmp+t_links+t_copy+t_man:.2f}s")
items = [(rel, rel in new) for rel in prev]
print("deletions via collect_stale:", synccli.collect_stale(items))
