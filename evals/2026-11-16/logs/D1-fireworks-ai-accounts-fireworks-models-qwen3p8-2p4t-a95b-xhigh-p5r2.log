def cp(r):
    synccli.copy_file(os.path.join(BK, "small_src", r), os.path.join(sd, r))
t0 = time.time()
with ThreadPoolExecutor(max_workers=8) as ex:
    list(ex.map(cp, srels))
t_cpt = time.time() - t0
print(f"threaded(8) copy_file 20k x 1KB (dirs pre-made): {t_cpt:.2f}s -> {t_cpt/20000*1e6:.0f} us/file")
