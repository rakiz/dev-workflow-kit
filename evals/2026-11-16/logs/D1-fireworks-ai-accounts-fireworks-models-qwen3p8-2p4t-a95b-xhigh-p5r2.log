# raw os.link, dirs pre-created (isolates the syscall from makedirs)
b = os.path.join(BK, "lnk_b")
for d in {os.path.dirname(r) for r in rels}:
    os.makedirs(os.path.join(b, d), exist_ok=True)
t0 = time.time()
for r in rels:
    os.link(os.path.join(dst1, r), os.path.join(b, r))
t_raw = time.time() - t0
print(f"raw os.link x{len(rels)} (dirs pre-made): {t_raw:.2f}s -> {t_raw/len(rels)*1e6:.0f} us/link")

# threaded raw links, 8 workers
c = os.path.join(BK, "lnk_c")
for d in {os.path.dirname(r) for r in rels}:
    os.makedirs(os.path.join(c, d), exist_ok=True)
def one(r):
    os.link(os.path.join(dst1, r), os.path.join(c, r))
t0 = time.time()
with ThreadPoolExecutor(max_workers=8) as ex:
    list(ex.map(one, rels))
t_thr = time.time() - t0
print(f"threaded(8) os.link x{len(rels)}: {t_thr:.2f}s -> {t_thr/len(rels)*1e6:.0f} us/link effective, speedup {t_raw/t_thr:.1f}x")

