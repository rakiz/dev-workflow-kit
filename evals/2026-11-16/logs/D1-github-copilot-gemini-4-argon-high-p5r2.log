import json, os, shutil, tempfile, time, synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst1 = os.path.join(tmp, "dst1")
    dst2 = os.path.join(tmp, "dst2")
    os.makedirs(src)
    os.makedirs(dst1)
    os.makedirs(dst2)

    # Create 2,000 files across 20 subdirs, 51,200 bytes each (~100 MB total; 1/10th of 20,000 files / 1 GB)
    payload = b"x" * 51200
    t0 = time.perf_counter()
    for d in range(20):
        sub = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(sub)
        for f in range(100):
            with open(os.path.join(sub, f"file_{f:03d}.bin"), "wb") as fp:
                fp.write(payload)
    t_create = time.perf_counter() - t0

    # 1. Measure synccli.build_manifest (2,000 files)
    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_scan = time.perf_counter() - t0

    # 2. Measure synccli.sync (full copy of 2,000 files, ~100 MB)
    t0 = time.perf_counter()
    synccli.sync(src, dst1)
    t_sync = time.perf_counter() - t0

    # 3. Measure hardlinking 2,000 unchanged files to dst2
    t0 = time.perf_counter()
    for d in range(20):
        os.makedirs(os.path.join(dst2, f"dir_{d:02d}"), exist_ok=True)
    for rel in manifest:
        os.link(os.path.join(dst1, rel), os.path.join(dst2, rel))
    t_link = time.perf_counter() - t0

    # 4. Measure JSON dump + fsync for 20,000 entries
    big_manifest = {f"dir_{i//1000:02d}/file_{i%1000:04d}.bin": {"size": 51200, "mtime": 1700000000.123456, "mtime_ns": 1700000000123456789, "ino": i} for i in range(20000)}
    mpath = os.path.join(tmp, "manifest20k.json")
    t0 = time.perf_counter()
    with open(mpath, "w", encoding="utf-8") as fp:
        json.dump(big_manifest, fp)
        fp.flush()
        os.fsync(fp.fileno())
    t_json_write = time.perf_counter() - t0
    msize = os.path.getsize(mpath)

    t0 = time.perf_counter()
    with open(mpath, "r", encoding="utf-8") as fp:
        _ = json.load(fp)
    t_json_read = time.perf_counter() - t0

    print(f"BENCHMARK RESULTS (2,000 files, 102.4 MB):")
    print(f"  create_2k:     {t_create:.3f}s")
    print(f"  build_manifest:{t_scan:.3f}s ({t_scan/2000*1e6:.1f} us/file)")
    print(f"  sync_full_2k:  {t_sync:.3f}s ({t_sync/2000*1e6:.1f} us/file, {100.0/t_sync:.1f} MiB/s)")
    print(f"  hardlink_2k:   {t_link:.3f}s ({t_link/2000*1e6:.1f} us/file)")
    print(f"  json_write_20k:{t_json_write:.3f}s (size={msize} bytes)")
    print(f"  json_read_20k: {t_json_read:.3f}s")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
'
