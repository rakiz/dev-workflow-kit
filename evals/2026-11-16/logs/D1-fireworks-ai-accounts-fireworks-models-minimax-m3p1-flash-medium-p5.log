import ctypes, os, shutil, time
libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib", use_errno=True)
COPYFILE_CLONE = 0x00000002
def clone(src, dst):
    r = libc.copyfile(src.encode(), dst.encode(), None, COPYFILE_CLONE)
    if r != 0:
        raise OSError(ctypes.get_errno(), "copyfile failed")
