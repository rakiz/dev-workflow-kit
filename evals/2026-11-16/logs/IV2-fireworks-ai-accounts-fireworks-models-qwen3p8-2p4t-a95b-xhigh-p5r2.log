g2 = {n: r2["files"][n]["generated_from"] for n in sorted(r2["files"])}
print("repro3: fresh generated_from:", g1)
print("repro3: cached generated_from:", g2)
print("repro3: DIVERGENCE:", g1 != g2)
shutil.rmtree(tmp, ignore_errors=True)
