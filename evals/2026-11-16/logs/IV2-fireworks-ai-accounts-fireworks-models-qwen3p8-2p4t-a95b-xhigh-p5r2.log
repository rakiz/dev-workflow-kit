inp = os.path.join(tmp, "in"); os.makedirs(inp)
open(os.path.join(inp, "a.csv"), "w").write("item\n1\n")
open(os.path.join(inp, "b.csv"), "w").write("item\nx\n")
rules = os.path.join(tmp, "rules.toml")
open(rules, "w").write('[transforms]\nitem = "boom"\n')
