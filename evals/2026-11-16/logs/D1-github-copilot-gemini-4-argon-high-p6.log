import os, time, tempfile, json, shutil, synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst_full = os.path.join(tmp, "dst_full")
    dst_incr = os.path.join(tmp, "dst_incr")
    os.makedirs(src)
    os.makedirs(dst_full)
    os.makedirs(dst_incr)

    # 20,000 files * 51,200 bytes = 1,024,000,000 bytes (1.024 GB) across 100 dirs
    payload = b"x" * 51200
    for d in range(100):
        dp = os.path.join(src, f"dir_{d:03d}")
        os.makedirs(dp)
        for f in range(200):
            with open(os.path.join(dp, f"file_{f:04d}.bin"), "wb") as fp:
                fp.write(payload)

    # Full backup measurement
    t0 = time.perf_counter()
    m1 = synccli.build_manifest(src)
    t_manifest1 = time.perf_counter() - t0

    t0 = time.perf_counter()
    created_dirs = set()
    for rel, st in m1.items():
        s = os.path.join(src, rel)
        d = os.path.join(dst_full, rel)
        parent = os.path.dirname(d)
        if parent not in created_dirs:
            os.makedirs(parent, exist_ok=True)
            created_dirs.add(parent)
        with open(s, "rb") as fsrc, open(d, "wb") as fdst:
            shutil.copyfileobj(fsrc, fdst, length=1048576)
        os.utime(d, (st["mtime"], st["mtime"]))
    t_copy_full = time.perf_counter() - t0

    mp1 = os.path.join(dst_full, synccli.MANIFEST_NAME)
    t0 = time.perf_counter()
    with open(mp1, "w", encoding="utf-8") as fp:
        json.dump(m1, fp, indent=2)
        fp.flush()
        os.fsync(fp.fileno())
    t_json1 = time.perf_counter() - t0

    # Incremental backup measurement: 1% changed (200 files = 10.24 MB), 99% unchanged (19,800 files hardlinked)
    for f in range(200):
        p = os.path.join(src, "dir_000", f"file_{f:04d}.bin")
        with open(p, "wb") as fp:
            fp.write(payload + b"y")

    t0 = time.perf_counter()
    m2 = synccli.build_manifest(src)
    t_manifest2 = time.perf_counter() - t0

    t0 = time.perf_counter()
    with open(mp1, "r", encoding="utf-8") as fp:
        old_m = json.load(fp)
    to_copy = set(synccli.changed_files(old_m, m2))
    t_diff = time.perf_counter() - t0

    t0 = time.perf_counter()
    created_dirs2 = set()
    for rel, st in m2.items():
        d = os.path.join(dst_incr, rel)
        parent = os.path.dirname(d)
        if parent not in created_dirs2:
            os.makedirs(parent, exist_ok=True)
            created_dirs2.add(parent)
        if rel in to_copy:
            s = os.path.join(src, rel)
            with open(s, "rb") as fsrc, open(d, "wb") as fdst:
                shutil.copyfileobj(fsrc, fdst, length=1048576)
            os.utime(d, (st["mtime"], st["mtime"]))
        else:
            os.link(os.path.join(dst_full, rel), d)
    t_incr_apply = time.perf_counter() - t0

    print(f"Full (20k files, 1.024 GB): manifest={t_manifest1:.3f}s, copy+utime={t_copy_full:.3f}s, json+fsync={t_json1:.3f}s, TOTAL={t_manifest1+t_copy_full+t_json1:.3f}s")
    print(f"Incr (1% changed, 99% link): manifest={t_manifest2:.3f}s, diff={t_diff:.3f}s, apply={t_incr_apply:.3f}s, TOTAL={t_manifest2+t_diff+t_incr_apply+t_json1:.3f}s")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
