import os, time, tempfile, json, shutil, tracemalloc, synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    os.makedirs(dst)
    # 20,000 files * 51,200 bytes = 1,024,000,000 bytes (~1.0 GiB) across 100 subdirs
    payload = b"x" * 51200
    for d in range(100):
        dp = os.path.join(src, f"dir_{d:03d}")
        os.makedirs(dp)
        for f in range(200):
            with open(os.path.join(dp, f"file_{f:04d}.bin"), "wb") as fp:
                fp.write(payload)

    tracemalloc.start()
    t0 = time.perf_counter()
    rels = synccli.scan_files(src)
    t_scan = time.perf_counter() - t0

    t0 = time.perf_counter()
    m = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0
    mem_after_manifest, peak_manifest = tracemalloc.get_traced_memory()

    t0 = time.perf_counter()
    for rel in m:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
    t_copy = time.perf_counter() - t0

    mp = os.path.join(dst, synccli.MANIFEST_NAME)
    t0 = time.perf_counter()
    with open(mp, "w", encoding="utf-8") as fp:
        json.dump(m, fp, indent=2)
    t_json_write = time.perf_counter() - t0
    msize = os.path.getsize(mp)

    t0 = time.perf_counter()
    with open(mp, "r", encoding="utf-8") as fp:
        m2 = json.load(fp)
    t_json_read = time.perf_counter() - t0

    t0 = time.perf_counter()
    diff = synccli.changed_files(m2, m)
    t_diff = time.perf_counter() - t0
    _, peak_total = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    print(f"20,000 files (1.024 GB):")
    print(f"  scan_files:     {t_scan:.3f}s")
    print(f"  build_manifest: {t_manifest:.3f}s (mem={mem_after_manifest/1e6:.2f} MB, peak={peak_manifest/1e6:.2f} MB)")
    print(f"  copy_file loop: {t_copy:.3f}s")
    print(f"  json.dump:      {t_json_write:.3f}s (manifest size={msize/1e6:.2f} MB)")
    print(f"  json.load:      {t_json_read:.3f}s")
    print(f"  changed_files:  {t_diff:.3f}s")
    print(f"  Total full run: {t_manifest + t_copy + t_json_write:.3f}s (peak traced mem={peak_total/1e6:.2f} MB)")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
