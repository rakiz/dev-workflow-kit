+def _reusable(entry, digest, rules_fp):
+    """True when a cache entry may be reused as-is: the file is
+    unchanged, the rules mapping is unchanged and the entry was produced
+    under the current transform registry version."""
+    if not entry:
+        return False
+    if entry.get("digest") != digest or entry.get("rules_fp") != rules_fp:
+        return False
+    if entry.get("registry_version") != cache.REGISTRY_VERSION:
+        return False
+    if not isinstance(entry.get("rows"), int):
+        return False
+    if not isinstance(entry.get("generated_from"), int):
+        return False
+    summary = entry.get("summary")
+    return isinstance(summary, dict) and isinstance(summary.get("columns"), dict)
+
+
