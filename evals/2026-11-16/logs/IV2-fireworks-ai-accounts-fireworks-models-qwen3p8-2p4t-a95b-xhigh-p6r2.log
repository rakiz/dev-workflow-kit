+            value = transforms.apply("boolean", raw)
+            self.assertEqual(value, 1.0)
+            self.assertIsInstance(value, float)
+        for raw in ("no", "NO", "No", "false", "FALSE", "False"):
+            value = transforms.apply("boolean", raw)
+            self.assertEqual(value, 0.0)
+            self.assertIsInstance(value, float)
+
+    def test_other_inputs_raise(self):
