import os, time, tempfile, shutil

with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as dst_copy, tempfile.TemporaryDirectory() as dst_link:
    n_files = 2000
    payload = b"x" * 51200
    for d in range(20):
        os.makedirs(os.path.join(src, f"dir_{d:02d}"), exist_ok=True)
        os.makedirs(os.path.join(dst_copy, f"dir_{d:02d}"), exist_ok=True)
        os.makedirs(os.path.join(dst_link, f"dir_{d:02d}"), exist_ok=True)
    rels = []
    for i in range(n_files):
        rel = os.path.join(f"dir_{i%20:02d}", f"file_{i:05d}.dat")
        rels.append(rel)
        with open(os.path.join(src, rel), "wb") as f:
            f.write(payload)

    t0 = time.perf_counter()
    for rel in rels:
        s = os.path.join(src, rel)
        d = os.path.join(dst_copy, rel)
        with open(s, "rb") as fsrc, open(d, "wb") as fdst:
            shutil.copyfileobj(fsrc, fdst, length=1024*1024)
    t_chunked = time.perf_counter() - t0

    t0 = time.perf_counter()
    for rel in rels:
        os.link(os.path.join(dst_copy, rel), os.path.join(dst_link, rel))
    t_link = time.perf_counter() - t0

    print(f"n_files={n_files}: chunked_copy={t_chunked:.3f}s, hardlink={t_link:.3f}s")
'
