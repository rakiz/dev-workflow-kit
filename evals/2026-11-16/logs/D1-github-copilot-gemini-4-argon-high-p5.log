import os, time, json, tempfile, tracemalloc, synccli, shutil

with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as dst:
    n_files = 2000
    payload = b"x" * 51200  # 50 KB * 2000 = 100 MB (1/10th of 20,000 files / 1 GB)
    for d in range(20):
        os.makedirs(os.path.join(src, f"dir_{d:02d}"), exist_ok=True)
    t0 = time.perf_counter()
    for i in range(n_files):
        p = os.path.join(src, f"dir_{i%20:02d}", f"file_{i:05d}.dat")
        with open(p, "wb") as f:
            f.write(payload)
    t_create = time.perf_counter() - t0

    tracemalloc.start()
    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0
    mem_curr, mem_peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    t0 = time.perf_counter()
    for rel in manifest:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
    t_copy = time.perf_counter() - t0

    t0 = time.perf_counter()
    m_json = json.dumps(manifest, indent=2)
    t_json = time.perf_counter() - t0

    print(f"n_files={n_files} (100 MB): build_manifest={t_manifest:.3f}s, copy_file={t_copy:.3f}s, json_dumps={t_json:.3f}s, json_bytes={len(m_json)}, manifest_mem_peak={mem_peak} bytes")
'
