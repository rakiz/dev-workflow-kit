import os, time, tempfile, json, shutil, resource, random, sys
sys.path.insert(0,'.')
import synccli
random.seed(1)
base=tempfile.mkdtemp(prefix="bk_")
src=os.path.join(base,"src"); dst=os.path.join(base,"dst"); os.makedirs(src)
N=30000; total=0
t=time.time()
for i in range(N):
    d=os.path.join(src,"r%03d"%(i%300),"s%02d"%(i%17)); os.makedirs(d,exist_ok=True)
    sz=int(random.lognormvariate(9.5,1.6)); sz=min(sz,20_000_000)
    with open(os.path.join(d,"f%d.dat"%i),"wb") as f: f.write(os.urandom(min(sz,1<<20)) * (sz//(1<<20)+1) if sz>(1<<20) else os.urandom(sz))
print("gen",round(time.time()-t,1))
def rss(): return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6
t=time.time(); files=synccli.scan_files(src); t_scan=time.time()-t
tot=sum(os.stat(os.path.join(src,f)).st_size for f in files)
print("files",len(files),"bytes",tot, "scan_files s",round(t_scan,3))
t=time.time(); m=synccli.build_manifest(src); print("build_manifest s",round(time.time()-t,3))
print("manifest json bytes",len(json.dumps(m,indent=2)), "compact", len(json.dumps(m)))
t=time.time(); tmp=synccli.sync(src,dst); print("full sync s",round(time.time()-t,2),"copied",len(tmp),"rss MB(peak)",round(rss(),1))
t=time.time(); c=synccli.sync(src,dst); print("noop sync s",round(time.time()-t,3),"copied",len(c))
# hardlink-based snapshot: link all
t=time.time(); l=os.path.join(base,"lnk")
for f in files:
    p=os.path.join(l,f); os.makedirs(os.path.dirname(p),exist_ok=True); os.link(os.path.join(dst,f),p)
print("hardlink all s",round(time.time()-t,2))
# fsync pass cost estimate: open+fsync each file in dst
t=time.time()
for f in files:
    fd=os.open(os.path.join(dst,f),os.O_RDONLY); os.fsync(fd); os.close(fd)
print("fsync pass (already flushed) s",round(time.time()-t,2))
# streaming copy with F_FULLFSYNC? plain copy via shutil to new tree
t=time.time(); d3=os.path.join(base,"d3")
for f in files:
    p=os.path.join(d3,f); os.makedirs(os.path.dirname(p),exist_ok=True); shutil.copyfile(os.path.join(src,f),p)
print("shutil.copyfile full s",round(time.time()-t,2))
t=time.time(); shutil.rmtree(l); print("rmtree linked tree s",round(time.time()-t,2))
shutil.rmtree(base)
