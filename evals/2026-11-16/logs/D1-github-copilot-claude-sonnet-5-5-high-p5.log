[0m$ [0mcd /private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-74504 && cat > /tmp/bench2_d1.py <<'EOF'
import os, time, tempfile, random, resource, shutil, sys
random.seed(1)
base=tempfile.mkdtemp(prefix="bk2_")
src=os.path.join(base,"src"); os.makedirs(src)
files=[]; tot=0
for i in range(30000):
    d=os.path.join(src,"r%03d"%(i%300),"s%02d"%(i%17)); os.makedirs(d,exist_ok=True)
    sz=min(int(random.lognormvariate(9.2,1.5)),20_000_000)
    p=os.path.join(d,"f%d.dat"%i)
    with open(p,"wb") as f: f.write(os.urandom(sz))
    files.append(os.path.relpath(p,src)); tot+=sz
print("files",len(files),"bytes",tot)
def copy(fsync, dstroot, fullfsync=False):
    import fcntl
    made=set()
    for rel in files:
        s=os.path.join(src,rel); d=os.path.join(dstroot,rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd,exist_ok=True); made.add(dd)
        with open(s,"rb") as a, open(d,"wb") as b:
            st0=os.fstat(a.fileno())
            while True:
                buf=a.read(1<<20)
                if not buf: break
                b.write(buf)
            st1=os.fstat(a.fileno())
            assert st0.st_mtime_ns==st1.st_mtime_ns
            if fsync:
                b.flush()
                if fullfsync: fcntl.fcntl(b.fileno(), fcntl.F_FULLFSYNC)
                else: os.fsync(b.fileno())
for name,kw in (("stream no fsync",dict(fsync=False)),("stream + fsync",dict(fsync=True)),("stream + F_FULLFSYNC",dict(fsync=True,fullfsync=True))):
    dstroot=os.path.join(base,name.replace(" ","_")); t=time.time(); copy(dstroot=dstroot,**kw); print(name, round(time.time()-t,1),"s")
print("peak rss MB", resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1e6)
shutil.rmtree(base)
