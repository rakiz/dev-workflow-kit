import os, sys, time, tempfile, random, json, shutil, resource, tracemalloc
sys.path.insert(0,'/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-74504')
import synccli
random.seed(2)
base=tempfile.mkdtemp(prefix="bk3_"); src=os.path.join(base,"src"); os.makedirs(src)
tot=0
for i in range(30000):
    d=os.path.join(src,"r%03d"%(i%300),"s%02d"%(i%17)); os.makedirs(d,exist_ok=True)
    sz=min(int(random.lognormvariate(9.2,1.5)),20_000_000); tot+=sz
    with open(os.path.join(d,"f%d.dat"%i),"wb") as f: f.write(os.urandom(sz))
print("bytes",tot)
def tolerant_manifest(root):
    m={}
    for rel in synccli.scan_files(root):
        st=os.lstat(os.path.join(root,rel)); m[rel]={"size":st.st_size,"mtime_ns":st.st_mtime_ns,"mode":st.st_mode&0o7777}
    return m
def run(prev, name):
    t0=time.time(); stg=os.path.join(base,".staging-"+name); os.makedirs(stg+"/tree")
    m=tolerant_manifest(src); t1=time.time()
    old=json.load(open(prev+"/manifest.json"))["files"] if prev else {}
    ch=set(synccli.changed_files(old,m)); t2=time.time()
    made=set(); nl=nc=0
    for rel in m:
        d=os.path.join(stg,"tree",rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd,exist_ok=True); made.add(dd)
        if rel in ch:
            s=os.path.join(src,rel)
            with open(s,"rb") as a, open(d,"wb") as b:
                while True:
                    buf=a.read(1<<20)
                    if not buf: break
                    b.write(buf)
                b.flush(); os.fsync(b.fileno())
            os.utime(d,ns=(m[rel]["mtime_ns"],m[rel]["mtime_ns"])); nc+=1
        else:
            os.link(os.path.join(prev,"tree",rel),d); nl+=1
    t3=time.time()
    # verify pass
    for rel,s in m.items():
        assert os.lstat(os.path.join(stg,"tree",rel)).st_size==s["size"]
    t4=time.time()
    json.dump({"files":m},open(stg+"/manifest.json.tmp","w")); os.replace(stg+"/manifest.json.tmp",stg+"/manifest.json")
    os.rename(stg,os.path.join(base,name)); t5=time.time()
    print(f"{name}: scan {t1-t0:.2f} load+diff {t2-t1:.2f} copy/link {t3-t2:.2f} (copied {nc} linked {nl}) verify {t4-t3:.2f} commit {t5-t4:.2f} TOTAL {t5-t0:.2f}")
    return os.path.join(base,name)
s1=run(None,"snap-1")
s2=run(s1,"snap-2")
# modify 1% files
files=list(synccli.scan_files(src))
for rel in random.sample(files,300):
    with open(os.path.join(src,rel),"ab") as f: f.write(b"x")
s3=run(s2,"snap-3")
tracemalloc.start(); m=tolerant_manifest(src); cur,peak=tracemalloc.get_traced_memory(); print("manifest mem MB",cur/1e6,"per file B",cur/len(m)); 
s=json.dumps({"files":m}); print("json B/file",len(s)/len(m))
t=time.time(); shutil.rmtree(s1); print("rmtree 1 snapshot (links mostly shared)",round(time.time()-t,2))
shutil.rmtree(base)
