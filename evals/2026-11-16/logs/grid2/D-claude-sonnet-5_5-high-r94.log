import os, time, shutil, hashlib, json
from concurrent.futures import ThreadPoolExecutor
SRC='.scratch/src'
def scan(root):
    out={}
    def rec(p, rel):
        with os.scandir(p) as it:
            for e in it:
                r = e.name if not rel else rel+'/'+e.name
                if e.is_dir(follow_symlinks=False): rec(e.path, r)
                elif e.is_file(follow_symlinks=False):
                    st=e.stat(follow_symlinks=False)
                    out[r]={"size":st.st_size,"mtime_ns":st.st_mtime_ns,"ctime_ns":st.st_ctime_ns}
    rec(root,''); return out
def full(jobs, dst):
    shutil.rmtree(dst, ignore_errors=True); os.makedirs(dst+'.staging')
    t0=time.perf_counter(); m=scan(SRC); t1=time.perf_counter()
    rels=list(m); chunks=[rels[i::jobs] for i in range(jobs)]
    def job(c):
        made=set()
        for rel in c:
            d=os.path.join(dst+'.staging',rel); dd=os.path.dirname(d)
            if dd not in made: os.makedirs(dd,exist_ok=True); made.add(dd)
            h=hashlib.sha256()
            with open(os.path.join(SRC,rel),'rb') as a, open(d,'wb') as b:
                while True:
                    buf=a.read(1<<20)
                    if not buf: break
                    h.update(buf); b.write(buf)
                os.fsync(b.fileno()); os.utime(b.fileno(), ns=(m[rel]["mtime_ns"],)*2)
            m[rel]["sha256"]=h.hexdigest()
    with ThreadPoolExecutor(jobs) as ex: list(ex.map(job, chunks))
    t2=time.perf_counter()
    for rel in rels:
        s=os.lstat(os.path.join(dst+'.staging',rel)); assert s.st_size==m[rel]["size"]
    t3=time.perf_counter()
    open(dst+'.staging/idx.json','w').write(json.dumps(m,separators=(',',':')))
    os.rename(dst+'.staging', dst); t4=time.perf_counter()
    print(f"jobs={jobs}: scan {t1-t0:.2f} copy {t2-t1:.2f} verify {t3-t2:.2f} index+publish {t4-t3:.2f} total {t4-t0:.2f}")
for j in (1,4,8): full(j, f'.scratch/full{j}')
for j in (1,4,8): shutil.rmtree(f'.scratch/full{j}', ignore_errors=True)
EOF
