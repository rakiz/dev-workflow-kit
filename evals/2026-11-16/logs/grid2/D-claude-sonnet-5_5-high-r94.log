import os, sys, time, shutil, subprocess
from concurrent.futures import ThreadPoolExecutor
sys.path.insert(0,'.')
SRC='.scratch/src'; BASE='.scratch/dst2'
rels=[]
for dp,dn,fn in os.walk(SRC):
    for f in fn: rels.append(os.path.relpath(os.path.join(dp,f),SRC))
def df():
    out=subprocess.check_output(['df','-k','.scratch']).decode().split('\n')[1].split()
    return int(out[3])
def link_job(chunk, dst):
    for rel in chunk:
        d=os.path.join(dst,rel); os.makedirs(os.path.dirname(d),exist_ok=True); os.link(os.path.join(BASE,rel), d)
for jobs in (1,4,8):
    dst=f'.scratch/lk{jobs}'; shutil.rmtree(dst, ignore_errors=True)
    chunks=[rels[i::jobs] for i in range(jobs)]
    a=df(); t=time.perf_counter()
    with ThreadPoolExecutor(jobs) as ex: list(ex.map(lambda c: link_job(c,dst), chunks))
    dt=time.perf_counter()-t
    print(f"link jobs={jobs}: {dt:.2f}s  df-delta KiB={a-df()}")
def copy_job(chunk, dst):
    for rel in chunk:
        d=os.path.join(dst,rel); os.makedirs(os.path.dirname(d),exist_ok=True)
        with open(os.path.join(SRC,rel),'rb') as a, open(d,'wb') as b:
            while True:
                buf=a.read(1<<20)
                if not buf: break
                b.write(buf)
for jobs in (1,4,8):
    dst=f'.scratch/cp{jobs}'; shutil.rmtree(dst, ignore_errors=True)
    chunks=[rels[i::jobs] for i in range(jobs)]
    t=time.perf_counter()
    with ThreadPoolExecutor(jobs) as ex: list(ex.map(lambda c: copy_job(c,dst), chunks))
    print(f"copy jobs={jobs}: {time.perf_counter()-t:.2f}s")
    shutil.rmtree(dst)
for j in (1,4,8): shutil.rmtree(f'.scratch/lk{j}', ignore_errors=True)
