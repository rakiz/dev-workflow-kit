import os, random, sys
root = sys.argv[1]; random.seed(1)
total = 0; n = 0
os.makedirs(root, exist_ok=True)
chunk = os.urandom(1<<20)
def mk(path, size):
    with open(path,'wb') as f:
        off = random.randrange(0, 1<<19)
        f.write((chunk*((size>>20)+2))[off:off+size])
plan = [(27500, 4000, 24000), (2300, 100_000, 400_000), (120, 1_000_000, 3_000_000)]
i = 0
for count, lo, hi in plan:
    for _ in range(count):
        d = os.path.join(root, "d%03d" % (i % 500), "s%02d" % (i % 7))
        os.makedirs(d, exist_ok=True)
        s = random.randint(lo, hi); mk(os.path.join(d, "f%06d.dat" % i), s); total += s; n += 1; i += 1
print(n, "files", total/1e6, "MB")
