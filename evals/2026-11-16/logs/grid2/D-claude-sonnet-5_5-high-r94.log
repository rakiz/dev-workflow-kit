import os, sys, time, shutil, hashlib, json
sys.path.insert(0,'.')
import synccli
SRC='.scratch/src'
def T(label, fn):
    t=time.perf_counter(); r=fn(); dt=time.perf_counter()-t; print(f"{label}: {dt:.2f}s"); return r

# purge not possible without sudo; note warm cache
m = T("synccli.scan_files", lambda: synccli.scan_files(SRC))
man = T("synccli.build_manifest", lambda: synccli.build_manifest(SRC))
print("files", len(man), "manifest json bytes (indent=2):", len(json.dumps(man, indent=2)))
shutil.rmtree('.scratch/dst1', ignore_errors=True)
T("synccli.sync full (existing, read()-whole-file, no fsync)", lambda: synccli.sync(SRC, '.scratch/dst1'))
T("synccli.sync no-op second", lambda: synccli.sync(SRC, '.scratch/dst1'))

# prototype scan: scandir + lstat ns
def scan_ns(root):
    out={}
    def rec(p, rel):
        with os.scandir(p) as it:
            for e in it:
                r = rel + e.name if not rel else rel + '/' + e.name
                if e.is_dir(follow_symlinks=False): rec(e.path, r)
                elif e.is_file(follow_symlinks=False):
                    st=e.stat(follow_symlinks=False)
                    out[r]={"size":st.st_size,"mtime_ns":st.st_mtime_ns,"ctime_ns":st.st_ctime_ns}
    rec(root,'')
    return out
nm = T("prototype scan_ns (scandir+lstat)", lambda: scan_ns(SRC))
# measured peak mem of manifest
import tracemalloc
tracemalloc.start(); nm2 = scan_ns(SRC); cur,peak = tracemalloc.get_traced_memory(); tracemalloc.stop()
print("manifest in-memory (tracemalloc) MB:", cur/1e6, "bytes/file", cur/len(nm2))

def copy_stream(src, dst, h=True):
    hh = hashlib.sha256()
    with open(src,'rb') as a, open(dst,'wb') as b:
        while True:
            buf=a.read(1<<20)
            if not buf: break
            if h: hh.update(buf)
            b.write(buf)
        return hh.hexdigest(), b
def run_full(dstroot, fsync_mode, hashing=True):
    shutil.rmtree(dstroot, ignore_errors=True); os.makedirs(dstroot)
    made=set(); paths=[]
    for rel,st in nm.items():
        d=os.path.join(dstroot,rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd, exist_ok=True); made.add(dd)
        hh=hashlib.sha256()
        with open(os.path.join(SRC,rel),'rb') as a, open(d,'wb') as b:
            while True:
                buf=a.read(1<<20)
                if not buf: break
                if hashing: hh.update(buf)
                b.write(buf)
            if fsync_mode=='each': os.fsync(b.fileno())
        os.utime(d, ns=(st["mtime_ns"], st["mtime_ns"]))
        paths.append(d)
    if fsync_mode=='batch':
        for d in paths:
            fd=os.open(d, os.O_RDONLY); os.fsync(fd); os.close(fd)
    return len(paths)
T("proto full copy, sha256, no fsync", lambda: run_full('.scratch/dst2','none'))
T("proto full copy, no hash, no fsync", lambda: run_full('.scratch/dst3','none', False))
T("proto full copy, sha256, fsync each file", lambda: run_full('.scratch/dst4','each'))
T("proto full copy, sha256, batch fsync after (reopen)", lambda: run_full('.scratch/dst5','batch'))
# sha256 raw throughput
buf=os.urandom(1<<20); t=time.perf_counter()
h=hashlib.sha256()
for _ in range(1024): h.update(buf)
print("sha256 throughput MB/s:", 1074/ (time.perf_counter()-t))

# hardlink pass
def link_all(dstroot, base):
    os.makedirs(dstroot, exist_ok=True); made=set()
    for rel in nm:
        d=os.path.join(dstroot,rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd, exist_ok=True); made.add(dd)
        os.link(os.path.join(base,rel), d)
shutil.rmtree('.scratch/dst6', ignore_errors=True)
T("hardlink 29920 files (no-change incremental link pass)", lambda: link_all('.scratch/dst6','.scratch/dst2'))
# validate base via lstat compare
def verify_base(base):
    bad=0
    for rel,st in nm.items():
        s=os.lstat(os.path.join(base,rel))
        if s.st_size!=st["size"] or s.st_mtime_ns!=st["mtime_ns"]: bad+=1
    return bad
print("bad", T("lstat-verify base tree", lambda: verify_base('.scratch/dst2')))
# rename (publish) + rmtree prune cost
T("rename snapshot dir", lambda: os.rename('.scratch/dst6','.scratch/dst6.trash'))
T("rmtree hardlinked 29920-file snapshot", lambda: shutil.rmtree('.scratch/dst6.trash'))
T("rmtree full copy snapshot", lambda: shutil.rmtree('.scratch/dst5'))
