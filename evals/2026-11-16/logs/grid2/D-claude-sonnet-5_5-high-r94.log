def cp(sel, dst, hashing=False):
    shutil.rmtree(dst, ignore_errors=True); made=set(); nb=0
    t=time.perf_counter()
    for rel,sz in sel:
        d=os.path.join(dst,rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd,exist_ok=True); made.add(dd)
        h=hashlib.sha256()
        with open(os.path.join(SRC,rel),'rb') as a, open(d,'wb') as b:
            while True:
                buf=a.read(1<<20)
                if not buf: break
                if hashing: h.update(buf)
                b.write(buf)
        nb+=sz
    dt=time.perf_counter()-t; return dt, nb
for name,sel in (("big>=1MB",[r for r in rels if r[1]>=1_000_000]),("mid",[r for r in rels if 100_000<=r[1]<1_000_000]),("small",[r for r in rels if r[1]<100_000])):
    dt,nb=cp(sel,'.scratch/dstx',True); print(f"{name}: files={len(sel)} bytes={nb/1e6:.0f}MB time={dt:.2f}s per-file={dt/len(sel)*1e3:.2f}ms MB/s={nb/1e6/dt:.0f}")
shutil.rmtree('.scratch/dstx')
