import os, time, tempfile, shutil, synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    dst2 = os.path.join(tmp, "dst2")
    os.makedirs(src)
    # 1000 files of 50 KB = 50 MB across 20 dirs
    data = b"x" * (50 * 1024)
    for d in range(20):
        dp = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(dp)
        for f in range(50):
            with open(os.path.join(dp, f"file_{f:03d}.dat"), "wb") as fp:
                fp.write(data)
    t0 = time.perf_counter()
    m = synccli.build_manifest(src)
    t1 = time.perf_counter()
    os.makedirs(dst)
    for rel in m:
        s = os.path.join(src, rel)
        d = os.path.join(dst, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            shutil.copyfileobj(fs, fd, 256 * 1024)
    t2 = time.perf_counter()
    os.makedirs(dst2)
    for rel in m:
        s = os.path.join(dst, rel)
        d = os.path.join(dst2, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        os.link(s, d)
    t3 = time.perf_counter()
    print(f"1000 files (50MB): build_manifest={t1-t0:.3f}s, chunked_copy={t2-t1:.3f}s, hardlink={t3-t2:.3f}s")
finally:
    shutil.rmtree(tmp)
'
