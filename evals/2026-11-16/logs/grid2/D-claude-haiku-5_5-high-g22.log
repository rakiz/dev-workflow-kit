import os, time, shutil
base = "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/probe/tree2"
src = base + "/src"; shutil.rmtree(base, ignore_errors=True)
for d in range(300):
    p = f"{src}/d{d:03d}"; os.makedirs(p); blob = os.urandom(33_333)
    for f in range(100):
        open(f"{p}/f{f:03d}.bin", "wb").write(blob)
files = [os.path.join(r, n) for r, _, fs in os.walk(src) for n in fs]
def run(label, fsync, chunked):
    dst = base + "/dst_" + label; shutil.rmtree(dst, ignore_errors=True)
    t = time.perf_counter()
    for f in files:
        rel = os.path.relpath(f, src); out = os.path.join(dst, rel)
        os.makedirs(os.path.dirname(out), exist_ok=True)
        tmp = out + ".part"
        with open(f, "rb") as fi, open(tmp, "wb") as fo:
            if chunked:
                shutil.copyfileobj(fi, fo, 1 << 20)
            else:
                fo.write(fi.read())
            if fsync:
                fo.flush(); os.fsync(fo.fileno())
        os.replace(tmp, out)
    el = time.perf_counter() - t
    print(f"{label}: {el:.2f}s", flush=True)
run("tmp_rename_chunked", False, True)
run("tmp_rename_chunked_fsync", True, True)
shutil.rmtree(base)
