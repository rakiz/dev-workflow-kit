import os, sys, time, json, shutil
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-17516")
import synccli

base = "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/probe/tree"
src, dst = base + "/src", base + "/dst"
shutil.rmtree(base, ignore_errors=True)
N_DIRS, FILES_PER_DIR, SIZE = 300, 100, 33_333   # 30,000 files, ~1.0 GB
t0 = time.perf_counter()
for d in range(N_DIRS):
    p = f"{src}/d{d:03d}"; os.makedirs(p)
    blob = os.urandom(SIZE)
    for f in range(FILES_PER_DIR):
        with open(f"{p}/f{f:03d}.bin", "wb") as fh:
            fh.write(blob)
print(f"generated in {time.perf_counter()-t0:.1f}s", flush=True)
total = sum(os.path.getsize(os.path.join(r, n)) for r, _, fs in os.walk(src) for n in fs)
print("files", N_DIRS*FILES_PER_DIR, "bytes", total, flush=True)

for label, fn in [
    ("scan_files", lambda: synccli.scan_files(src)),
    ("build_manifest (scan+stat)", lambda: synccli.build_manifest(src)),
]:
    times = []
    for _ in range(3):
        t = time.perf_counter(); fn(); times.append(time.perf_counter()-t)
    print(label, ["%.3f" % x for x in times], flush=True)

t = time.perf_counter(); copied = synccli.sync(src, dst); t_init = time.perf_counter()-t
print("initial sync (copy all)", "%.2fs" % t_init, "copied", len(copied), flush=True)
t = time.perf_counter(); copied = synccli.sync(src, dst); t_noop = time.perf_counter()-t
print("second sync (no-op)", "%.2fs" % t_noop, "copied", len(copied), flush=True)

# cold-cache-ish: drop nothing (cannot purge page cache without root); report as warm
# fresh destination again to repeat the full copy
shutil.rmtree(dst)
t = time.perf_counter(); copied = synccli.sync(src, dst); t2 = time.perf_counter()-t
print("initial sync repeat (fresh dst)", "%.2fs" % t2, flush=True)
shutil.rmtree(base)
