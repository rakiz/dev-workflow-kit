import os, sys, time, shutil, hashlib, tracemalloc
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-17516")
import synccli
base = "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/probe/tree3"
src, snap, snap2 = base + "/src", base + "/snap", base + "/snap2"
shutil.rmtree(base, ignore_errors=True)
for d in range(300):
    p = f"{src}/d{d:03d}"; os.makedirs(p); blob = os.urandom(33_333)
    for f in range(100):
        open(f"{p}/f{f:03d}.bin", "wb").write(blob)
time.sleep(5)  # let dirty pages flush so timings reflect steady state
files = [os.path.join(r, n) for r, _, fs in os.walk(src) for n in fs]

def timed(label, fn, reps=3):
    ts = []
    for _ in range(reps):
        t = time.perf_counter(); r = fn(); ts.append(time.perf_counter() - t)
    print(f"{label}: " + " ".join(f"{x:.2f}" for x in ts) + " s", flush=True)
    return r

def sha_only():
    for f in files:
        h = hashlib.sha256()
        with open(f, "rb") as fi:
            for chunk in iter(lambda: fi.read(1 << 20), b""):
                h.update(chunk)
        h.hexdigest()
timed("sha256 read-only pass over 1GB", sha_only)

def copy_hash_fsync(dst):
    def run():
        shutil.rmtree(dst, ignore_errors=True)
        for f in files:
            out = os.path.join(dst, os.path.relpath(f, src))
            os.makedirs(os.path.dirname(out), exist_ok=True)
            h = hashlib.sha256(); part = out + ".part"
            with open(f, "rb") as fi, open(part, "wb") as fo:
                for chunk in iter(lambda: fi.read(1 << 20), b""):
                    h.update(chunk); fo.write(chunk)
                fo.flush(); os.fsync(fo.fileno())
            os.utime(part, ns=(os.stat(f).st_atime_ns, os.stat(f).st_mtime_ns))
            os.replace(part, out)
    return run
timed("copy+sha256+fsync+rename (1GB, 30k files)", copy_hash_fsync(snap), reps=2)

def link_all():
    shutil.rmtree(snap2, ignore_errors=True)
    for f in files:
        out = os.path.join(snap2, os.path.relpath(f, src))
        os.makedirs(os.path.dirname(out), exist_ok=True)
        os.link(os.path.join(snap, os.path.relpath(f, src)), out)
timed("hardlink-reuse 30k files (no data copy)", link_all)

tracemalloc.start()
synccli.build_manifest(src)
cur, peak = tracemalloc.get_traced_memory()
tracemalloc.stop()
print(f"build_manifest peak heap: {peak/1e6:.1f} MB for {len(files)} files = {peak/len(files):.0f} B/file", flush=True)

# symlink behaviour of existing scan_files
sl = base + "/sl"; os.makedirs(sl + "/realdir"); open(sl + "/realdir/x", "w").write("1")
open(sl + "/file.txt", "w").write("2"); os.symlink(sl + "/realdir", sl + "/linkdir"); os.symlink(sl + "/file.txt", sl + "/linkfile")
print("scan_files with symlinks:", synccli.scan_files(sl))
