import os, tempfile, json, shutil
import reportgen, cache, transforms

tmp = tempfile.mkdtemp()
inp = os.path.join(tmp, "in"); os.makedirs(inp)
with open(os.path.join(inp, "b.csv"), "w") as fh:
    fh.write("status\nYES\nno\nTrue\nfalse\n")
r = os.path.join(tmp, "r.toml")
with open(r, "w") as fh:
    fh.write('[transforms]\nstatus = "boolean"\n')
