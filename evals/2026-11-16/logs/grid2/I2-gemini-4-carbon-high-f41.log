 import csv
 import hashlib
 import json
+import math
 import os
 
 DEFAULT_CACHE_PATH = os.path.join("cache", "state.json")
 
 REGISTRY_VERSION = "2"
 
 
+def _parse_version(value):
+    if isinstance(value, bool) or value is None:
+        return None
+    if isinstance(value, int):
+        return (value,)
+    if isinstance(value, float):
+        if not math.isfinite(value):
+            return None
+        whole = int(value)
+        return (whole,) if value == whole else (whole, 1)
+    if isinstance(value, str):
+        s = value.strip()
+        if s.startswith(("v", "V")):
+            s = s[1:]
+        s = s.split("-", 1)[0]
+        if not s:
+            return None
+        parts = s.split(".")
+        if all(p.isascii() and p.isdigit() for p in parts):
+            nums = [int(p) for p in parts]
+            while len(nums) > 1 and nums[-1] == 0:
+                nums.pop()
+            return tuple(nums)
+    return None
+
+
+def _is_future_version(value):
+    current = _parse_version(REGISTRY_VERSION)
+    parsed = _parse_version(value)
+    if current is None or parsed is None:
+        return False
+    return parsed > current
+
+
+def _has_future_version(obj):
+    if isinstance(obj, dict):
+        for key, value in obj.items():
+            if key == "summary":
+                continue
+            if (key == "version" or key.endswith("_version")) and _is_future_version(value):
+                return True
+            if _has_future_version(value):
+                return True
+    elif isinstance(obj, list):
+        return any(_has_future_version(item) for item in obj)
+    return False
+
+
