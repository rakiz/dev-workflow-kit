+def _parse_version(value):
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        return (value,)
+    if isinstance(value, str):
+        parts = value.strip().lstrip("vV").split(".")
+        if parts and all(p.isdigit() for p in parts):
+            return tuple(int(p) for p in parts)
+    return None
+
+
+def _is_future_version(value):
+    parsed = _parse_version(value)
+    current = _parse_version(REGISTRY_VERSION)
+    if parsed is None or current is None:
+        return False
+    n = max(len(parsed), len(current))
+    parsed = parsed + (0,) * (n - len(parsed))
+    current = current + (0,) * (n - len(current))
+    return parsed > current
+
+
+def _has_future_schema(data):
+    if not isinstance(data, dict):
+        return True
+    for key in _VERSION_KEYS:
+        if key in data and not isinstance(data[key], dict):
+            if _is_future_version(data[key]):
+                return True
+    for val in data.values():
+        if isinstance(val, dict):
+            for key in _VERSION_KEYS:
+                if key in val and _is_future_version(val[key]):
+                    return True
+    return False
