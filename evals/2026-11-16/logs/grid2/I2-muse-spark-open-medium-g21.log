+def boolean(value):
+    """yes/true -> 1.0, no/false -> 0.0 (case-insensitive)."""
+    cleaned = value.strip().lower()
+    if cleaned in ("yes", "true"):
+        return 1.0
+    if cleaned in ("no", "false"):
+        return 0.0
+    raise TransformError("not a boolean: %r" % value)
+
+
