import os, time, tempfile, shutil, sys
sys.path.insert(0, '.')
import synccli

tmp = tempfile.mkdtemp(dir='/tmp' if os.path.isdir('/tmp') else None)
src = os.path.join(tmp, 'src')
os.makedirs(src)
# 20000 small files (2 KB) + 40 medium files (2 MB) = ~40 MB + 40 MB ~ 80 MB
os.makedirs(os.path.join(src, 'sub'))
t0 = time.perf_counter()
for i in range(20000):
    with open(os.path.join(src, 'f%05d.txt' % i), 'w') as f:
        f.write('x' * 2048)
for i in range(40):
    with open(os.path.join(src, 'sub', 'm%02d.bin' % i), 'wb') as f:
        f.write(os.urandom(2 * 1024 * 1024))
t_make = time.perf_counter() - t0
total = sum(os.stat(os.path.join(d, fn)).st_size for d, _, fns in os.walk(src) for fn in fns)
nfiles = sum(len(fns) for _, _, fns in os.walk(src))
print(f"tree: {nfiles} files, {total/1e6:.1f} MB, created in {t_make:.1f}s")

# 1) scan+stat throughput
t0 = time.perf_counter()
m = synccli.build_manifest(src)
t_scan = time.perf_counter() - t0
print(f"build_manifest (scan+stat): {t_scan:.2f}s -> {nfiles/t_scan:.0f} files/s")

# 2) copy throughput with synccli.copy_file
dst = os.path.join(tmp, 'dst'); os.makedirs(dst)
t0 = time.perf_counter()
for rel in m:
    synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
t_copy = time.perf_counter() - t0
print(f"synccli.copy_file all files: {t_copy:.2f}s -> {total/t_copy/1e6:.0f} MB/s")

# 3) copy throughput with shutil.copyfile for comparison
dst2 = os.path.join(tmp, 'dst2'); os.makedirs(dst2)
t0 = time.perf_counter()
for rel in m:
    d = os.path.join(dst2, rel)
    os.makedirs(os.path.dirname(d) or '.', exist_ok=True)
    shutil.copyfile(os.path.join(src, rel), d)
t_sh = time.perf_counter() - t0
print(f"shutil.copyfile all files:   {t_sh:.2f}s -> {total/t_sh/1e6:.0f} MB/s")

# 4) hashing throughput for content-addressed store
import hashlib
t0 = time.perf_counter()
h = 0
for rel in m:
    with open(os.path.join(src, rel), 'rb') as f:
        hashlib.sha256(f.read()).hexdigest()
t_hash = time.perf_counter() - t0
print(f"sha256 (whole-file read):    {t_hash:.2f}s -> {total/t_hash/1e6:.0f} MB/s")
shutil.rmtree(tmp)
