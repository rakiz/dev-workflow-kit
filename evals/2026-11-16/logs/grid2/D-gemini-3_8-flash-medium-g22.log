import os, time, tempfile, shutil

# Test stat speed
tmp = tempfile.mkdtemp()
n = 10000
for i in range(n):
    with open(os.path.join(tmp, f'f_{i}.txt'), 'w') as f:
        f.write('x')

t0 = time.perf_counter()
for entry in os.scandir(tmp):
    st = entry.stat()
t1 = time.perf_counter()
print(f'scandir + stat for {n} files: {t1-t0:.4f}s ({n/(t1-t0):.1f} files/s)')

# Test copy speed for 10000 small files
tmp_dst = tempfile.mkdtemp()
t0 = time.perf_counter()
for entry in os.scandir(tmp):
    src = entry.path
    dst = os.path.join(tmp_dst, entry.name)
    with open(src, 'rb') as fsrc, open(dst, 'wb') as fdst:
        fdst.write(fsrc.read())
t1 = time.perf_counter()
print(f'open/read/write for {n} small files: {t1-t0:.4f}s ({n/(t1-t0):.1f} files/s)')

# Test 1GB bulk I/O write speed
big_file = os.path.join(tmp, 'big.bin')
data = b'0' * (1024 * 1024 * 64) # 64MB chunk
t0 = time.perf_counter()
with open(big_file, 'wb') as f:
    for _ in range(16): # 1GB
        f.write(data)
    f.flush()
    os.fsync(f.fileno())
t1 = time.perf_counter()
print(f'1GB sequential write + fsync: {t1-t0:.4f}s ({(1024/(t1-t0)):.1f} MB/s)')

shutil.rmtree(tmp)
shutil.rmtree(tmp_dst)
"
