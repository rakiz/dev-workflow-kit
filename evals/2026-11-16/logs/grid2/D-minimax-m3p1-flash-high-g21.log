import fcntl, os, time
F_NOCACHE = 48
tot = 0
t0 = time.perf_counter()
files = 0
for dp, dn, fn in os.walk("src"):
    for f in fn:
        p = os.path.join(dp, f)
        fd = os.open(p, os.O_RDONLY)
        try:
            fcntl.fcntl(fd, F_NOCACHE, 1)
        except OSError as e:
            print("F_NOCACHE failed:", e); raise SystemExit
        while True:
            b = os.read(fd, 1 << 20)
            if not b: break
            tot += len(b)
        os.close(fd); files += 1
dt = time.perf_counter() - t0
print("cold-ish read: %d files, %d bytes in %.3f s -> %.1f MiB/s" % (files, tot, dt, tot/(1<<20)/dt))
