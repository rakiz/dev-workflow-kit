import json, os, tempfile, sys
import synccli

# (5) copy_file leaves a partial destination file when the read fails mid-way
class Boom:
    def __init__(self, f): self.f = f
    def __enter__(self): return self
    def __exit__(self, *a): return False
    def read(self, *a):
        data = self.f.read(*a)
        if data:
            raise OSError(5, "simulated I/O error")
        return data
    def __exit__(self, *a): pass
    def close(self): self.f.close()

real_open = open
def fake_open(path, mode="r", *a, **k):
    if isinstance(path, str) and path.endswith("src.bin") and "rb" in mode:
        return Boom(real_open(path, mode, *a, **k))
    return real_open(path, mode, *a, **k)

d = tempfile.mkdtemp()
src = os.path.join(d, "src.bin"); dst = os.path.join(d, "dst.bin")
real_open(src, "wb").write(b"x" * 100000)
synccli.open = fake_open
synccli.copy_file(src, dst)
synccli.open = real_open
print("after simulated mid-read failure: dst exists =", os.path.exists(dst),
      "size =", os.stat(dst).st_size if os.path.exists(dst) else None,
