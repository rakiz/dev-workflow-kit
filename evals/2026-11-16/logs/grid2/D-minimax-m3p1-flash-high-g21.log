with real_open(os.path.join(d2, synccli.MANIFEST_NAME), "w") as f:
    f.write('{"a.txt": {"size": 5, "mtim')   # half-written manifest
try:
    synccli.sync(d2, os.path.join(d2, "dst"))
    print("sync survived")
except Exception as e:
    print("sync died on half-written manifest:", type(e).__name__, e)
