import fcntl, os, shutil, tempfile
root = tempfile.mkdtemp()
# flock behaviour
lp = os.path.join(root, "run.lock")
fd = os.open(lp, os.O_CREAT | os.O_RDWR, 0o644)
fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
print("locked ok")
fd2 = os.open(lp, os.O_CREAT | os.O_RDWR, 0o644)
try:
    fcntl.flock(fd2, fcntl.LOCK_EX | fcntl.LOCK_NB)
    print("second lock acquired (unexpected)")
except OSError as e:
    print("second lock blocked:", e.errno, e.strerror)
# same-process second fd on flock: BSD flock is per-file-descriptor, so second fd blocks
print("---- rename atomicity ----")
a = os.path.join(root, "staging/run-1"); b = os.path.join(root, "snap-1")
os.makedirs(a); open(os.path.join(a, "index.json"), "w").write("{}")
os.rename(a, b)
print("published:", os.path.exists(os.path.join(b, "index.json")), "staging gone:", not os.path.exists(a))
# rename dir over existing non-empty dir
try:
    os.rename(b, b)
    print("rename onto itself ok")
except OSError as e:
    print("err", e)
# commonpath containment
print("commonpath:", os.path.commonpath([os.path.realpath(root), os.path.realpath(os.path.join(root, "snap-1"))]))
outside = os.path.realpath("/etc/passwd")
print("outside commonpath:", os.path.commonpath([os.path.realpath(root), outside]))
