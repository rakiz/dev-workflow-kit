import os, tempfile
import synccli

# (5) partial destination file when the read fails mid-way
class Boom:
    def __init__(self, f): self.f = f; self.sent = False
    def __enter__(self): return self
    def __exit__(self, *a): self.f.close(); return False
    def read(self, n=-1):
        if not self.sent:
            self.sent = True
            data = self.f.read(40000)
            return data
        raise OSError(5, "simulated I/O error")

real_open = open
def fake_open(path, mode="r", *a, **k):
    if isinstance(path, str) and path.endswith("src.bin") and "rb" in mode:
        return Boom(real_open(path, mode, *a, **k))
    return real_open(path, mode, *a, **k)

d = tempfile.mkdtemp()
src = os.path.join(d, "src.bin"); dst = os.path.join(d, "dst.bin")
real_open(src, "wb").write(b"x" * 100000)
synccli.open = fake_open
synccli.copy_file(src, dst)
synccli.open = real_open
print("source=%d bytes; destination after mid-read failure exists=%s size=%d"
      % (100000, os.path.exists(dst), os.stat(dst).st_size))

# (6) a half-written manifest in the DESTINATION kills the next sync()
d2 = tempfile.mkdtemp(); dst2 = tempfile.mkdtemp()
real_open(os.path.join(d2, "a.txt"), "wb").write(b"hello")
with real_open(os.path.join(dst2, synccli.MANIFEST_NAME), "w") as f:
