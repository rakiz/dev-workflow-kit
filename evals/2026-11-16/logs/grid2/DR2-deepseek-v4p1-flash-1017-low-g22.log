# syncd

Daemon that keeps a destination directory continuously in sync with a source
directory, using a manifest (`.syncd_manifest.json`) and a journal
(`.syncd_journal.log`). See DESIGN.md for the design it implements.

- `python3 -m syncd SRC DST` to run.

===STATE===
"""Manifest, lock and journal state for syncd."""
import json
import os

MANIFEST_NAME = ".syncd_manifest.json"
JOURNAL_NAME = ".syncd_journal.log"
LOCK_NAME = "syncd.lock"


def snapshot(root):
    """Return {relpath: {"size": int, "mtime": int}} for every file under root."""
    result = {}
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            full = os.path.join(dirpath, name)
            rel = os.path.relpath(full, root)
            st = os.stat(full)
            result[rel] = {"size": st.st_size, "mtime": int(st.st_mtime)}
    return result


def load_manifest(dst_root):
    path = os.path.join(dst_root, MANIFEST_NAME)
    if not os.path.exists(path):
        return {}
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def commit_manifest(dst_root, manifest):
    path = os.path.join(dst_root, MANIFEST_NAME)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(manifest, f)


def acquire_lock(run_dir):
    """Refuse to start if another syncd instance already owns run_dir."""
    path = os.path.join(run_dir, LOCK_NAME)
    if os.path.exists(path):
        raise RuntimeError("syncd already running")
    with open(path, "w", encoding="utf-8") as f:
        f.write(str(os.getpid()))
    return path


def release_lock(path):
    os.remove(path)


def journal_append(dst_root, rel, state):
    path = os.path.join(dst_root, JOURNAL_NAME)
    with open(path, "a", encoding="utf-8") as f:
        f.write(json.dumps({"rel": rel, "state": state}) + "\n")


def replay_journal(dst_root, manifest):
    """Fold journal entries into the manifest, in append order."""
    path = os.path.join(dst_root, JOURNAL_NAME)
    if not os.path.exists(path):
        return manifest
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            entry = json.loads(line)
            manifest[entry["rel"]] = entry["state"]
    return manifest

===SYNCD===
"""syncd: keep dst continuously in sync with src. See DESIGN.md."""
import os
import time

from state import (
    acquire_lock,
    commit_manifest,
    journal_append,
    load_manifest,
    release_lock,
    snapshot,
)

POLL_SECONDS = 0.5
DEBOUNCE_SECONDS = 0.2


class SyncDaemon:
    def __init__(self, src_root, dst_root):
        self.src_root = src_root
        self.dst_root = dst_root
        self.pending = {}      # rel -> state waiting for its quiet period
        self.quiet_since = {}  # rel -> time of the last observed change
        self.observed = {}     # rel -> state seen at the last scan
        self.synced = {}       # rel -> state of the last completed copy

    def poll(self):
        now = time.time()
        new = snapshot(self.src_root)
        manifest = load_manifest(self.dst_root)
        for rel, state in new.items():
            prev = manifest.get(rel)
            if prev is None or prev != state:
                self.pending[rel] = state
                if self.observed.get(rel) != state:
                    self.quiet_since[rel] = now
                    self.observed[rel] = state
        for rel in list(self.pending):
            if now - self.quiet_since.get(rel, now) >= DEBOUNCE_SECONDS:
                self.flush_one(rel)

    def flush_one(self, rel):
        state = self.pending[rel]
        src = os.path.join(self.src_root, rel)
        dst = os.path.join(self.dst_root, rel)
        with open(src, "rb") as f:
            data = f.read()
        os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
        with open(dst, "wb") as f:
            f.write(data)
        check = os.stat(src)
        if (check.st_size, int(check.st_mtime)) != (state["size"], state["mtime"]):
            self.quiet_since[rel] = time.time()
            self.pending[rel] = {
                "size": check.st_size,
                "mtime": int(check.st_mtime),
            }
        else:
            self.pending.pop(rel, None)
        self.synced[rel] = state
        journal_append(self.dst_root, rel, state)

    def run(self):
        while True:
            lock = acquire_lock(self.dst_root)
            self.poll()
            release_lock(lock)
            manifest = load_manifest(self.dst_root)
            manifest.update(self.synced)
            commit_manifest(self.dst_root, manifest)
            time.sleep(POLL_SECONDS)


def main():
    import sys

    if len(sys.argv) != 3:
        print("usage: python3 -m syncd SRC DST", file=sys.stderr)
        return 2
    SyncDaemon(sys.argv[1], sys.argv[2]).run()
    return 0


if __name__ == "__main__":
    main()
