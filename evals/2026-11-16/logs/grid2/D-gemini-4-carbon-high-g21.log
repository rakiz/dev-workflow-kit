import json, os, shutil, sys, tempfile, time, tracemalloc
import synccli, snaputil

TMP_BASE = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode"
os.makedirs(TMP_BASE, exist_ok=True)

with tempfile.TemporaryDirectory(dir=TMP_BASE) as root:
    src = os.path.join(root, "src")
    dst1 = os.path.join(root, "snap-1")
    dst2 = os.path.join(root, "snap-2")
    os.makedirs(src)

    # Create 20,000 files totaling ~1 GiB (1,073,741,824 bytes):
    # 19,900 small files x 16 KiB = 318.4 MiB across 200 subdirs
    # 100 artifact files x 7.55 MiB = 755 MiB
    t0 = time.perf_counter()
    small_buf = b"x" * 16384
    large_buf = b"y" * (7553024)  # 19900*16384 + 100*7553024 = 1,081,344,000 (~1.007 GiB)
    for d in range(200):
        dpath = os.path.join(src, f"run_{d:03d}", "metrics")
        os.makedirs(dpath)
        n_small = 100 if d < 199 else 0
        for i in range(n_small):
            with open(os.path.join(dpath, f"result_{i:04d}.json"), "wb") as f:
                f.write(small_buf)
        if d < 100:
            with open(os.path.join(dpath, "checkpoint.bin"), "wb") as f:
                f.write(large_buf)
    t_setup = time.perf_counter() - t0

    # 1. Measure synccli.scan_files and synccli.build_manifest + memory
    tracemalloc.start()
    t0 = time.perf_counter()
    files = synccli.scan_files(src)
    t_scan = time.perf_counter() - t0

    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0
    mem_curr, mem_peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    total_bytes = sum(v["size"] for v in manifest.values())

    # 2. Measure full backup with chunked copy (1 MiB buffer) + dir cache + fsync manifest
    tracemalloc.start()
    t0 = time.perf_counter()
    created_dirs = set()
    os.makedirs(dst1, exist_ok=True)
    for rel in files:
        s = os.path.join(src, rel)
        d = os.path.join(dst1, rel)
        parent = os.path.dirname(d)
        if parent not in created_dirs:
            os.makedirs(parent, exist_ok=True)
            created_dirs.add(parent)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            shutil.copyfileobj(fs, fd, length=1048576)
        st = manifest[rel]
        os.utime(d, (st["mtime"], st["mtime"]))
    t_copy = time.perf_counter() - t0

    t0 = time.perf_counter()
    idx_tmp = os.path.join(dst1, ".index.json.tmp")
    idx_dst = os.path.join(dst1, ".index.json")
    with open(idx_tmp, "w", encoding="utf-8") as f:
        json.dump(manifest, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(idx_tmp, idx_dst)
    t_idx = time.perf_counter() - t0
    copy_curr, copy_peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    idx_size = os.stat(idx_dst).st_size

    # 3. Measure incremental unchanged run using hardlinks (os.link)
    t0 = time.perf_counter()
    new_manifest = synccli.build_manifest(src)
    changed = set(synccli.changed_files(manifest, new_manifest))
    created_dirs2 = set()
    os.makedirs(dst2, exist_ok=True)
    for rel in new_manifest:
        d = os.path.join(dst2, rel)
        parent = os.path.dirname(d)
        if parent not in created_dirs2:
            os.makedirs(parent, exist_ok=True)
            created_dirs2.add(parent)
        if rel not in changed:
            os.link(os.path.join(dst1, rel), d)
    t_incr = time.perf_counter() - t0

    print(f"files={len(files)}, total_bytes={total_bytes} ({total_bytes/1024**3:.3f} GiB)")
    print(f"scan_files={t_scan:.3f}s, build_manifest={t_manifest:.3f}s")
    print(f"manifest mem_curr={mem_curr/1024**2:.2f} MiB, mem_peak={mem_peak/1024**2:.2f} MiB ({mem_curr/len(files):.1f} B/file)")
    print(f"full_copy={t_copy:.3f}s ({total_bytes/1024**2/t_copy:.1f} MiB/s, {len(files)/t_copy:.0f} files/s)")
    print(f"index_write_fsync={t_idx:.3f}s, index_bytes={idx_size} ({idx_size/len(files):.1f} B/file)")
    print(f"copy_loop mem_peak={copy_peak/1024**2:.2f} MiB")
    print(f"incremental_0pct_changed (build_manifest + 20k os.link)={t_incr:.3f}s")
