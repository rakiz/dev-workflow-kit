import json, os, shutil, stat, tempfile, time, hashlib
import synccli

TMP_BASE = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode"

def bench_case(n_files, total_target_bytes):
    with tempfile.TemporaryDirectory(dir=TMP_BASE) as root:
        src = os.path.join(root, "src")
        staging = os.path.join(root, ".staging", "run-1")
        snap = os.path.join(root, "snap-20261117-120000-000001")
        os.makedirs(src)
        os.makedirs(staging)

        # Mix: 99.5% small files + 0.5% larger files totaling ~1.00 GiB
        n_large = 100
        n_small = n_files - n_large
        small_sz = 12288 if n_files == 20000 else 8192
        large_sz = (total_target_bytes - n_small * small_sz) // n_large
        small_buf = b"x" * small_sz
        large_buf = b"y" * large_sz

        n_dirs = n_files // 100
        per_dir_small = n_small // n_dirs
        rem_small = n_small % n_dirs
        for d in range(n_dirs):
            dp = os.path.join(src, f"dir_{d:04d}", "sub")
            os.makedirs(dp)
            cnt = per_dir_small + (1 if d < rem_small else 0)
            for i in range(cnt):
                with open(os.path.join(dp, f"res_{i:04d}.json"), "wb") as f:
                    f.write(small_buf)
            if d < n_large:
                with open(os.path.join(dp, "artifact.bin"), "wb") as f:
                    f.write(large_buf)

        # Phase 1a: synccli.scan_files + file_state
        t0 = time.perf_counter()
        rels = synccli.scan_files(src)
        t_scan = time.perf_counter() - t0

        t0 = time.perf_counter()
        manifest = {}
        for rel in rels:
            st = os.stat(os.path.join(src, rel))
            manifest[rel] = {
                "size": st.st_size,
                "mtime": st.st_mtime,
                "mtime_ns": st.st_mtime_ns,
                "mode": stat.S_IMODE(st.st_mode),
            }
        t_stat = time.perf_counter() - t0

        # Phase 2: Copy + utime + chmod + os.fsync per file
        t0 = time.perf_counter()
        target_dst = os.path.join(staging, "eval_0")
        made_dirs = set()
        for rel, meta in manifest.items():
            s = os.path.join(src, rel)
            d = os.path.join(target_dst, rel)
            parent = os.path.dirname(d)
            if parent not in made_dirs:
                os.makedirs(parent, exist_ok=True)
                made_dirs.add(parent)
            with open(s, "rb") as fs, open(d, "wb") as fd:
                shutil.copyfileobj(fs, fd, length=1048576)
                os.fsync(fd.fileno())
            os.chmod(d, meta["mode"])
            os.utime(d, ns=(meta["mtime_ns"], meta["mtime_ns"]))
        t_copy = time.perf_counter() - t0

        # Phase 3: Write snapshot index + sha256 + fsync + atomic rename
        t0 = time.perf_counter()
        payload = {"version": 1, "targets": {"eval_0": {"files": manifest, "skipped": []}}}
        raw = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
        digest = hashlib.sha256(raw).hexdigest()
        envelope = {"sha256": digest, "payload_json": raw.decode("utf-8")}
        idx_path = os.path.join(staging, ".snapshot_index.json")
        with open(idx_path, "w", encoding="utf-8") as f:
            json.dump(envelope, f)
            f.flush()
            os.fsync(f.fileno())
        os.rename(staging, snap)
        dfd = os.open(root, os.O_RDONLY)
        os.fsync(dfd)
        os.close(dfd)
        t_commit = time.perf_counter() - t0

        actual_bytes = sum(m["size"] for m in manifest.values())
        print(
            f"N_files={len(manifest)} ({actual_bytes/1024**3:.3f} GiB): "
            f"scan={t_scan:.3f}s, stat={t_stat:.3f}s, copy+fsync+meta={t_copy:.3f}s, "
            f"index+commit={t_commit:.3f}s, TOTAL={t_scan+t_stat+t_copy+t_commit:.3f}s, "
            f"idx_MB={os.stat(os.path.join(snap, \".snapshot_index.json\")).st_size/1024**2:.2f}"
        )

