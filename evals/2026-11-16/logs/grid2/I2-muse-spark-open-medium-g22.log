import tempfile, os, json, reportgen, cache, shutil

def test_invariant():
    tmp=tempfile.mkdtemp()
    inp=os.path.join(tmp,'in')
    os.makedirs(inp)
    with open(os.path.join(inp,'a.csv'),'w') as f:
        f.write('item,val\n1,ok\n')
    with open(os.path.join(inp,'b.csv'),'w') as f:
        f.write('item,val\n1,maybe\n')
    rules=os.path.join(tmp,'rules.toml')
    with open(rules,'w') as f:
        f.write('[transforms]\nval = \"boolean\"\n')
    out=os.path.join(tmp,'out')
    cpath=os.path.join(tmp,'cache','state.json')
    try:
        reportgen.run(rules, inp, out, cpath)
        print('should have raised')
    except reportgen.ValidationError as e:
        print('ValidationError ok:', e)
    print('report.json exists?', os.path.exists(os.path.join(out,'report.json')))
    print('report.html exists?', os.path.exists(os.path.join(out,'report.html')))
    print('cache exists?', os.path.exists(cpath))
    if os.path.exists(cpath):
        print(open(cpath).read())
    shutil.rmtree(tmp)

    # test unhandled crash: inject transform that raises TypeError
    import transforms
    orig=transforms.REGISTRY.get('crash')
    def crash(v):
        raise TypeError('boom')
    transforms.REGISTRY['crash']=crash
    tmp=tempfile.mkdtemp()
    inp=os.path.join(tmp,'in')
    os.makedirs(inp)
    with open(os.path.join(inp,'a.csv'),'w') as f:
        f.write('item,val\n1,x\n')
    rules=os.path.join(tmp,'rules.toml')
    with open(rules,'w') as f:
        f.write('[transforms]\nval = \"crash\"\n')
    out=os.path.join(tmp,'out')
    cpath=os.path.join(tmp,'cache','state.json')
    # pre-create a successful report to test cleanup
    os.makedirs(out)
    with open(os.path.join(out,'report.json'),'w') as f:
        f.write('old')
    try:
        reportgen.run(rules, inp, out, cpath)
    except Exception as e:
        print('crash caught:', type(e).__name__, e)
    print('after crash report.json exists?', os.path.exists(os.path.join(out,'report.json')))
    print('after crash cache exists?', os.path.exists(cpath))
    shutil.rmtree(tmp)
    if orig is None:
        transforms.REGISTRY.pop('crash', None)
    print('invariant tests done')

test_invariant()
