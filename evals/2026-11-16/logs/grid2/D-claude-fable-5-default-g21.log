# scale check: 20000 small files (~1KB) to see per-file overhead dominating
import os, time, tempfile, sys
sys.path.insert(0,'.')
import synccli
src=tempfile.mkdtemp(); dst=tempfile.mkdtemp()
for i in range(20000):
    d=os.path.join(src,f"d{i%200}"); os.makedirs(d,exist_ok=True)
    with open(os.path.join(d,f"f{i}.txt"),"wb") as f: f.write(b"x"*1024)
t0=time.time(); copied=synccli.sync(src,dst); t=time.time()-t0
print("20000 x 1KB full sync:", t, "s ->", t/20000*1e6, "us/file")
t0=time.time(); copied=synccli.sync(src,dst); t2=time.time()-t0
print("no-op incremental:", t2)
import shutil; shutil.rmtree(src); shutil.rmtree(dst)
