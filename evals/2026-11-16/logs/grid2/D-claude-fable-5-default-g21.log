import os, time, tempfile, random, sys
sys.path.insert(0, '.')
import synccli

src = tempfile.mkdtemp(); dst = tempfile.mkdtemp()
random.seed(1)
NFILES = 5000
AVG = 25 * 1024  # ~25KB avg -> ~125MB total
t0 = time.time()
for i in range(NFILES):
    d = os.path.join(src, f"d{i%50}")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, f"f{i}.bin"), "wb") as f:
        f.write(os.urandom(AVG))
print("gen", time.time()-t0)

t0 = time.time()
m = synccli.build_manifest(src)
t_scan = time.time()-t0
print("scan+stat", len(m), "files:", t_scan)

t0 = time.time()
copied = synccli.sync(src, dst)
t_sync = time.time()-t0
total = sum(s["size"] for s in m.values())
print("full sync", len(copied), "files,", total/1e6, "MB:", t_sync, "s ->", total/1e6/t_sync, "MB/s")

# hash cost for comparison
import hashlib
t0=time.time()
for rel in list(m)[:1000]:
    h=hashlib.sha256()
    with open(os.path.join(src, rel),'rb') as f: h.update(f.read())
t_hash=time.time()-t0
print("sha256 1000 files:", t_hash)

import shutil; shutil.rmtree(src); shutil.rmtree(dst)
