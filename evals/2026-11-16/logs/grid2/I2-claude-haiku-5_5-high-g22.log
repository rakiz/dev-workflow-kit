+        self.assertEqual(
+            report["files"]["t.csv"]["summary"]["columns"]["item"]["distinct"], 1)
+
+    def test_future_version_entry_is_treated_as_empty(self):
+        inp = self.write_inputs({"t.csv": "item,label\n1,alpha\n"})
+        rules = self.write_rules('item = "round2"\n')
