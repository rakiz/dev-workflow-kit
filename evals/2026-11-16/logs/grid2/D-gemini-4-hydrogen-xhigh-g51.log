import os, sys, time, tempfile, json, shutil, hashlib
sys.path.insert(0, os.getcwd())
import synccli, snaputil

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    os.makedirs(src)
    # 30,000 files across 300 dirs (~34 KB each -> ~1.02 GB total = 1,020,000,000 bytes)
    t0 = time.perf_counter()
    payload = b"a" * 34000
    for d in range(300):
        ddir = os.path.join(src, f"run_{d:03d}")
        os.makedirs(ddir)
        for f in range(100):
            with open(os.path.join(ddir, f"item_{f:02d}.dat"), "wb") as fp:
                fp.write(payload)
    t_setup = time.perf_counter() - t0
    print(f"Setup 30,000 files (~1.02 GB): {t_setup:.3f}s")

    # 1. synccli.build_manifest (os.walk + sort + os.stat)
    t0 = time.perf_counter()
    m_synccli = synccli.build_manifest(src)
    t_build = time.perf_counter() - t0
    print(f"synccli.build_manifest(30k): {t_build:.3f}s (entries={len(m_synccli)})")

    # 2. Single-pass os.scandir manifest build
    def fast_scan(root):
        res = {}
        stack = [root]
        while stack:
            cur = stack.pop()
            with os.scandir(cur) as it:
                for entry in it:
                    if entry.is_dir(follow_symlinks=False):
                        if not entry.name.startswith("."):
                            stack.append(entry.path)
                    elif entry.is_file(follow_symlinks=False):
                        st = entry.stat(follow_symlinks=False)
                        rel = os.path.relpath(entry.path, root)
                        res[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode}
        return res

    t0 = time.perf_counter()
    m_fast = fast_scan(src)
    t_fast_scan = time.perf_counter() - t0
    print(f"fast_scan os.scandir(30k): {t_fast_scan:.3f}s (entries={len(m_fast)})")

    # 3. synccli.sync initial full backup (30k files, 1.02 GB)
    dst_synccli = os.path.join(tmp, "dst_synccli")
    os.makedirs(dst_synccli)
    t0 = time.perf_counter()
    synccli.sync(src, dst_synccli)
    t_synccli_full = time.perf_counter() - t0
    print(f"synccli.sync initial full (30k, 1.02 GB): {t_synccli_full:.3f}s")

    # 4. Streaming copy + SHA-256 + chmod 0o444 + utime (no per-file fsync)
    dst_stream = os.path.join(tmp, "dst_stream")
    os.makedirs(dst_stream)
    t0 = time.perf_counter()
    buf = bytearray(262144)
    mv = memoryview(buf)
    created_dirs = set()
    manifest_out = {}
    for rel, st_info in m_fast.items():
        s = os.path.join(src, rel)
        d = os.path.join(dst_stream, rel)
        pdir = os.path.dirname(d)
        if pdir not in created_dirs:
            os.makedirs(pdir, exist_ok=True)
            created_dirs.add(pdir)
        h = hashlib.sha256()
        with open(s, "rb") as fsrc, open(d, "wb") as fdst:
            while True:
                n = fsrc.readinto(mv)
                if not n:
                    break
                h.update(mv[:n])
                fdst.write(mv[:n])
        os.utime(d, ns=(st_info["mtime_ns"], st_info["mtime_ns"]))
        os.chmod(d, st_info["mode"] & 0o555)
        manifest_out[rel] = {"size": st_info["size"], "mtime_ns": st_info["mtime_ns"], "mode": st_info["mode"], "sha256": h.hexdigest()}
    t_stream = time.perf_counter() - t0
    print(f"Stream+SHA256+utime+chmod (30k, 1.02 GB, no per-file fsync): {t_stream:.3f}s")

    # 5. JSON serialize + write + fsync + parse for 30k entries with sha256
    mpath = os.path.join(tmp, "manifest.json")
    t0 = time.perf_counter()
    raw = json.dumps(manifest_out, separators=(",", ":")).encode("utf-8")
    with open(mpath, "wb") as fp:
        fp.write(raw)
        fp.flush()
        os.fsync(fp.fileno())
    t_jwrite = time.perf_counter() - t0
    t0 = time.perf_counter()
    with open(mpath, "rb") as fp:
        parsed = json.loads(fp.read())
    t_jread = time.perf_counter() - t0
    print(f"Manifest JSON write+fsync: {t_jwrite:.3f}s ({len(raw)/1e6:.2f} MB) | read+parse: {t_jread:.3f}s")

    # 6. Incremental no-op: scan + diff + os.link 30k files
    dst_inc = os.path.join(tmp, "snap-20261117-150000-01")
    os.makedirs(dst_inc)
    for d in range(300):
        os.makedirs(os.path.join(dst_inc, f"run_{d:03d}"), exist_ok=True)
    t0 = time.perf_counter()
    for rel in m_fast:
        os.link(os.path.join(dst_stream, rel), os.path.join(dst_inc, rel))
    t_link30k = time.perf_counter() - t0
    print(f"os.link 30k unchanged files: {t_link30k:.3f}s")

    # 7. snaputil.snapshot_disk_usage(tmp, snap) and shutil.rmtree(snap)
    t0 = time.perf_counter()
    sz = snaputil.snapshot_disk_usage(tmp, "snap-20261117-150000-01")
    t_du = time.perf_counter() - t0
    t0 = time.perf_counter()
    shutil.rmtree(dst_inc)
    t_rm = time.perf_counter() - t0
    print(f"snaputil.snapshot_disk_usage(30k): {t_du:.3f}s (bytes={sz}) | rmtree(30k): {t_rm:.3f}s")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
