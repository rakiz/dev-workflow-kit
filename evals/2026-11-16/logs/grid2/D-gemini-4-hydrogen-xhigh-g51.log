    os.makedirs(tree_src, exist_ok=True)
    os.makedirs(mdir, exist_ok=True)

    # Phase 1: Single-pass os.scandir
    t0 = time.perf_counter()
    entries = []
    dir_rels = set([""])
    stack = [src]
    while stack:
        cur = stack.pop()
        with os.scandir(cur) as it:
            for entry in it:
                if entry.is_dir(follow_symlinks=False):
                    rel_d = os.path.relpath(entry.path, src)
                    dir_rels.add(rel_d)
                    stack.append(entry.path)
                elif entry.is_file(follow_symlinks=False):
                    st = entry.stat(follow_symlinks=False)
                    rel = os.path.relpath(entry.path, src)
                    entries.append((rel, st.st_size, st.st_mtime_ns, stat.S_IMODE(st.st_mode)))
    entries.sort(key=lambda x: x[0])
    t_scan = time.perf_counter() - t0

    # Pre-create directories
    t0 = time.perf_counter()
    for drel in sorted(dir_rels):
        if drel:
            os.makedirs(os.path.join(tree_src, drel), exist_ok=True)
    t_mkdirs = time.perf_counter() - t0

    # Phase 2: 8-worker streaming copy + sha256 + os.fsync + utime + chmod
    t0 = time.perf_counter()
    def worker(item):
        rel, sz, mtime_ns, mode = item
        s = os.path.join(src, rel)
        d = os.path.join(tree_src, rel)
        h = hashlib.sha256()
        buf = bytearray(262144)
        mv = memoryview(buf)
        copied = 0
        with open(s, "rb") as fs, open(d, "wb") as fd:
            while True:
                n = fs.readinto(mv)
                if not n:
                    break
                h.update(mv[:n])
                fd.write(mv[:n])
                copied += n
            fd.flush()
            os.fsync(fd.fileno())
        os.utime(d, ns=(mtime_ns, mtime_ns))
        os.chmod(d, mode & 0o555)
        return rel, {"size": copied, "mtime_ns": mtime_ns, "mode": mode, "sha256": h.hexdigest()}

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        results = list(ex.map(worker, entries, chunksize=64))
    manifest_files = dict(results)
    t_copy = time.perf_counter() - t0

    # Phase 3: Dir fsyncs + per-source manifest + top manifest + .COMPLETE + atomic rename
    t0 = time.perf_counter()
    for drel in dir_rels:
        p = tree_src if not drel else os.path.join(tree_src, drel)
        dfd = os.open(p, os.O_RDONLY)
        try:
            os.fsync(dfd)
        finally:
            os.close(dfd)

    src_m_bytes = json.dumps({"source_id": "evals", "files": manifest_files, "skipped": []}, separators=(",", ":")).encode("utf-8")
    src_m_path = os.path.join(mdir, "evals.json")
    with open(src_m_path + ".tmp", "wb") as fp:
        fp.write(src_m_bytes)
        fp.flush()
        os.fsync(fp.fileno())
    os.replace(src_m_path + ".tmp", src_m_path)

    # Compute tree_digest_sha256
    th = hashlib.sha256()
    for rel, meta in manifest_files.items():
        th.update(f"evals\0{rel}\0{meta['size']}\0{meta['sha256']}\n".encode("utf-8"))
    tree_digest = th.hexdigest()

    top_bytes = json.dumps({"version": 1, "sources": {"evals": {"file_count": len(manifest_files), "manifest_sha256": hashlib.sha256(src_m_bytes).hexdigest()}}}, separators=(",", ":")).encode("utf-8")
    top_path = os.path.join(staging, ".backup_manifest.json")
    with open(top_path + ".tmp", "wb") as fp:
        fp.write(top_bytes)
        fp.flush()
        os.fsync(fp.fileno())
    os.replace(top_path + ".tmp", top_path)

    complete_bytes = json.dumps({"version": 1, "snapshot_id": "snap-20261117-143000-01", "file_count": len(manifest_files), "total_bytes": sum(m["size"] for m in manifest_files.values()), "manifest_sha256": hashlib.sha256(top_bytes).hexdigest(), "tree_digest_sha256": tree_digest}, separators=(",", ":")).encode("utf-8")
    cpath = os.path.join(staging, ".COMPLETE")
    with open(cpath + ".tmp", "wb") as fp:
        fp.write(complete_bytes)
        fp.flush()
        fcntl.fcntl(fp.fileno(), fcntl.F_FULLFSYNC)
    os.replace(cpath + ".tmp", cpath)

    final_snap = os.path.join(broot, "snap-20261117-143000-01")
    os.rename(staging, final_snap)
    bfd = os.open(broot, os.O_RDONLY)
    try:
        os.fsync(bfd)
    finally:
        os.close(bfd)
    t_commit = time.perf_counter() - t0
    t_total = time.perf_counter() - t_total0

    print(f"End-to-end 30k files / 1.02 GB:")
    print(f"  scan+sort: {t_scan:.3f}s")
    print(f"  mkdirs(300): {t_mkdirs:.3f}s")
    print(f"  8-worker copy+hash+fsync+utime+chmod: {t_copy:.3f}s")
    print(f"  commit (dir fsyncs + manifests + tree_digest + F_FULLFSYNC seal + rename): {t_commit:.3f}s")
    print(f"  TOTAL: {t_total:.3f}s ({1020.0/t_total:.1f} MB/s, {30000/t_total:.0f} files/s)")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
