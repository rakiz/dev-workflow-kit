import os, sys, time, tempfile, shutil, hashlib, concurrent.futures, ctypes

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    os.makedirs(src)
    payload = b"a" * 34000
    files = []
    for d in range(300):
        ddir = os.path.join(src, f"run_{d:03d}")
        os.makedirs(ddir)
        for f in range(100):
            p = os.path.join(ddir, f"item_{f:02d}.dat")
            with open(p, "wb") as fp:
                fp.write(payload)
            files.append(f"run_{d:03d}/item_{f:02d}.dat")

    # Test parallel copy+hash with 4 workers vs 1 worker
    dst_par = os.path.join(tmp, "dst_par")
    os.makedirs(dst_par)
    for d in range(300):
        os.makedirs(os.path.join(dst_par, f"run_{d:03d}"), exist_ok=True)
    def copy_one(rel):
        s = os.path.join(src, rel)
        d = os.path.join(dst_par, rel)
        h = hashlib.sha256()
        buf = bytearray(262144)
        mv = memoryview(buf)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            while True:
                n = fs.readinto(mv)
                if not n:
                    break
                h.update(mv[:n])
                fd.write(mv[:n])
        return h.hexdigest()

    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        list(ex.map(copy_one, files, chunksize=64))
    print(f"Parallel 8-thread stream+SHA256 (30k, 1.02 GB): {time.perf_counter()-t0:.3f}s")

    # Test per-file os.fsync in 8 threads
    def fsync_one(rel):
        fd = os.open(os.path.join(dst_par, rel), os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        list(ex.map(fsync_one, files, chunksize=64))
    print(f"Parallel 8-thread os.fsync (30k files): {time.perf_counter()-t0:.3f}s")

    # Test macOS clonefile(2) via libc on directory tree!
    libc = ctypes.CDLL("libc.dylib")
    clonefile = libc.clonefile
    clonefile.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
    clonefile.restype = ctypes.c_int
    dst_clone = os.path.join(tmp, "dst_clone")
    t0 = time.perf_counter()
    rc = clonefile(dst_par.encode(), dst_clone.encode(), 0)
    print(f"APFS clonefile entire 30k-file dir: rc={rc}, time={time.perf_counter()-t0:.4f}s")

    # Test parallel os.link with 8 threads
    dst_par_link = os.path.join(tmp, "dst_par_link")
    os.makedirs(dst_par_link)
    for d in range(300):
        os.makedirs(os.path.join(dst_par_link, f"run_{d:03d}"), exist_ok=True)
    def link_one(rel):
        os.link(os.path.join(dst_par, rel), os.path.join(dst_par_link, rel))
    t0 = time.perf_counter()
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        list(ex.map(link_one, files, chunksize=64))
    print(f"Parallel 8-thread os.link (30k files): {time.perf_counter()-t0:.3f}s")

    # Test os.fsync on 300 dirs + os.sync()
    t0 = time.perf_counter()
    for d in range(300):
        dfd = os.open(os.path.join(dst_par, f"run_{d:03d}"), os.O_RDONLY)
