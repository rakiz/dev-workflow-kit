     1	"""snaputil: snapshot helpers for backup roots (listing, pruning, sizes)."""
     2	import argparse
     3	import os
     4	import shutil
     5	import sys
     6	
     7	
     8	def list_snapshots(backup_root):
     9	    """Return the snapshot directory names under backup_root, oldest first.
    10	
    11	    Snapshot directories live directly under backup_root and are named
    12	    like snap-20261112-150000-07: a date, a time, and a run sequence
    13	    number, separated by dashes. Entries that are not such directories
    14	    are ignored.
    15	    """
    16	    names = []
    17	    for entry in os.scandir(backup_root):
    18	        if entry.name.startswith("snap-") and entry.is_dir():
    19	            names.append(entry.name)
    20	    return sorted(names)
    21	
    22	
    23	def prune_snapshots(backup_root, keep):
    24	    """Delete all but the newest keep snapshots under backup_root.
    25	
    26	    Snapshots are ordered oldest first and only the oldest ones are
    27	    removed, so the newest snapshot is never deleted. Returns the list
    28	    of deleted snapshot names, oldest first.
    29	    """
    30	    names = list_snapshots(backup_root)
    31	    if len(names) <= keep:
    32	        return []
    33	    doomed = names[:len(names) - keep]
    34	    for name in doomed:
    35	        shutil.rmtree(os.path.join(backup_root, name))
    36	    return doomed
    37	
    38	
    39	def snapshot_disk_usage(backup_root, snapshot_name):
    40	    """Return the total size in bytes of all regular files in one snapshot.
    41	
    42	    Files are counted recursively; an empty or missing snapshot counts
    43	    as zero bytes.
    44	    """
    45	    total = 0
    46	    for dirpath, dirnames, filenames in os.walk(
    47	        os.path.join(backup_root, snapshot_name)
    48	    ):
    49	        for name in filenames:
    50	            total += os.stat(os.path.join(dirpath, name)).st_size
    51	    return total
    52	
    53	
    54	def safe_snapshot_path(backup_root, snapshot_name, rel_path):
    55	    """Map a relative path stored in a snapshot manifest back under the
    56	    snapshot directory.
    57	
    58	    The returned path never points outside backup_root/<snapshot_name>:
    59	    any ".." segments in rel_path are normalized away before the join,
    60	    so a stored path cannot climb out of its snapshot.
    61	    """
    62	    rel = os.path.normpath(rel_path)
    63	    return os.path.join(backup_root, snapshot_name, rel)
    64	
    65	
    66	def is_stale(snapshot_dir, ref_epoch):
    67	    """Return True when the snapshot directory is older than ref_epoch.
    68	
    69	    ref_epoch is a reference time in seconds since the epoch, as captured
    70	    earlier by the caller (e.g. from a previous stat). A snapshot whose
    71	    directory was modified at exactly ref_epoch is not stale.
    72	    """
    73	    return os.stat(snapshot_dir).st_mtime <= ref_epoch
    74	
    75	
    76	def main(argv=None):
    77	    parser = argparse.ArgumentParser(prog="snaputil")
    78	    parser.add_argument("backup_root")
    79	    parser.add_argument("--prune", type=int, metavar="KEEP", default=None)
    80	    args = parser.parse_args(argv)
    81	    if args.prune is not None:
    82	        deleted = prune_snapshots(args.backup_root, args.prune)
    83	        for name in deleted:
    84	            print("deleted", name)
    85	    for name in list_snapshots(args.backup_root):
    86	        size = snapshot_disk_usage(args.backup_root, name)
    87	        print(name, size)
    88	    return 0
    89	
    90	
    91	if __name__ == "__main__":
    92	    sys.exit(main())
