import time, tempfile, shutil, os, reportgen, cache
tmp = tempfile.mkdtemp()
try:
    out = os.path.join(tmp, "out")
    cpath = os.path.join(tmp, "cache", "state.json")
    t0 = time.perf_counter()
    reportgen.run("rules.example.toml", "input", out, cpath)
    t1 = time.perf_counter()
    reportgen.run("rules.example.toml", "input", out, cpath)
    t2 = time.perf_counter()
    print(f"Run 1 (cold): {(t1-t0)*1000:.2f} ms")
    print(f"Run 2 (warm, buggy): {(t2-t1)*1000:.2f} ms")
    t3 = time.perf_counter()
    for name in os.listdir("input"):
        if name.endswith(".csv"):
            cache.file_digest(os.path.join("input", name))
    t4 = time.perf_counter()
    print(f"Digest only: {(t4-t3)*1000:.2f} ms")
finally:
    shutil.rmtree(tmp)
