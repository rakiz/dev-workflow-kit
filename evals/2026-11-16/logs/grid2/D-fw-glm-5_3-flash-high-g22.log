import os, time, shutil, synccli, tempfile

base = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/bench_tree"
shutil.rmtree(base, ignore_errors=True)
src = os.path.join(base, "src")
os.makedirs(src)

N = 10000
FSIZE = 64 * 1024  # 64 KiB per file -> ~640 MB
chunk = os.urandom(64 * 1024)
t0 = time.perf_counter()
for i in range(N):
    d = os.path.join(src, "d%02d" % (i % 50))
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "f%05d.bin" % i), "wb") as f:
        f.write(chunk)
gen_s = time.perf_counter() - t0
total = N * FSIZE
print(f"generated {total/1e6:.0f} MB, {N} files in {gen_s:.1f}s")

# 1. scan + stat rate (synccli.scan_files + synccli.file_state)
t0 = time.perf_counter()
rels = synccli.scan_files(src)
man = {r: synccli.file_state(os.path.join(src, r)) for r in rels}
scan_s = time.perf_counter() - t0
print(f"scan+stat: {len(rels)} files in {scan_s:.3f}s -> {len(rels)/scan_s:.0f} files/s")

# 2. full-copy throughput with synccli.copy_file
dst = os.path.join(base, "dst")
os.makedirs(dst)
t0 = time.perf_counter()
for r in rels:
    synccli.copy_file(os.path.join(src, r), os.path.join(dst, r))
copy_s = time.perf_counter() - t0
print(f"synccli.copy_file full copy: {copy_s:.2f}s -> {total/1e6/copy_s:.0f} MB/s")

# 3. same via shutil.copyfile (chunked)
dst2 = os.path.join(base, "dst2")
os.makedirs(dst2)
t0 = time.perf_counter()
for r in rels:
    shutil.copyfile(os.path.join(src, r), os.path.join(dst2, r))
sh_s = time.perf_counter() - t0
print(f"shutil.copyfile full copy: {sh_s:.2f}s -> {total/1e6/sh_s:.0f} MB/s")

# 4. hardlink rate (incremental path)
dst3 = os.path.join(base, "dst3")
os.makedirs(dst3)
t0 = time.perf_counter()
for r in rels:
    os.link(os.path.join(src, r), os.path.join(dst3, r))
link_s = time.perf_counter() - t0
print(f"os.link x{N}: {link_s:.3f}s -> {N/link_s:.0f} links/s")
