import csv, datetime, glob
for p in sorted(glob.glob("input/*.csv")):
    with open(p, newline="") as f:
        r = csv.DictReader(f)
        bad_dates = []
        empty_counts = {k: 0 for k in r.fieldnames}
        rows = 0
        for row in r:
            rows += 1
            for k, v in row.items():
                if v == "":
                    empty_counts[k] += 1
            if "date" in row:
                m, d, y = row["date"].split("/")
                try:
                    datetime.date(int(y), int(m), int(d))
                except ValueError:
                    bad_dates.append(row["date"])
        print(p, "rows=", rows, "empty=", empty_counts, "bad_dates=", len(bad_dates), bad_dates[:5])
