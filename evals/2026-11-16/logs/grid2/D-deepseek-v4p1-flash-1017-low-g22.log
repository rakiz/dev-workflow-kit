t_copy_synccli = time.time() - t0
shutil.rmtree(dst); os.makedirs(dst)

def chunked(srcf, dstf):
    os.makedirs(os.path.dirname(dstf) or ".", exist_ok=True)
    with open(srcf, "rb") as a, open(dstf, "wb") as b:
        while True:
            c = a.read(1024*1024)
            if not c: break
            b.write(c)

t0 = time.time()
