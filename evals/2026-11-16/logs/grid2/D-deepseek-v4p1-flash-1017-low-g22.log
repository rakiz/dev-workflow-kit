print("copy synccli.copy_file s", round(t_copy_synccli,3), "MB/s", round(total/t_copy_synccli/1e6,1))
print("copy chunked s", round(t_copy_chunk,3), "MB/s", round(total/t_copy_chunk/1e6,1))
print("os.sync s", round(t_sync,3))
