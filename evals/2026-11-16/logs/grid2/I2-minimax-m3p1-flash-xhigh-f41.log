+# Keys a state file may use to carry a schema/registry version. An entry
+# carries one of them too (see make_entry).
+VERSION_KEYS = ("registry_version", "version", "schema_version")
 
+
+def _version_key(value):
+    """Comparable version key for `value` (a tuple of ints), or None when
+    the value does not describe a numeric version."""
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        parts = (value,)
+    elif isinstance(value, float):
+        parts = (int(value),)
+    elif isinstance(value, str):
+        text = value.strip()
+        if not text:
+            return None
+        chunks = text.split(".")
+        if not all(chunk.isdigit() for chunk in chunks):
+            return None
+        parts = tuple(int(chunk) for chunk in chunks)
+    else:
+        return None
+    while len(parts) > 1 and parts[-1] == 0:
+        parts = parts[:-1]
+    return parts
+
+
+CURRENT_VERSION_KEY = _version_key(REGISTRY_VERSION)
+
+
+def is_future_version(value):
+    """True when `value` describes a version newer than the current
+    REGISTRY_VERSION."""
+    if CURRENT_VERSION_KEY is None:
+        return False
+    key = _version_key(value)
+    return key is not None and key > CURRENT_VERSION_KEY
+
+
+def entry_version(entry):
+    """The registry version an entry was produced under, or None when the
+    entry does not carry one."""
+    if not isinstance(entry, dict):
+        return None
+    for key in VERSION_KEYS:
+        if key in entry:
+            return entry[key]
+    return None
+
+
+def entry_is_current(entry):
+    """True when `entry` was produced under the current registry
+    version. An entry stamped with another version — older or newer — is
+    never reused: its summary may have been derived by other rules."""
+    key = _version_key(entry_version(entry))
+    return key is not None and key == CURRENT_VERSION_KEY
+
