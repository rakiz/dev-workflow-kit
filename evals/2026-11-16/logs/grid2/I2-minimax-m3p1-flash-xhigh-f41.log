+class BooleanTransformTests(unittest.TestCase):
+    """The `boolean` transform: yes/no/true/false, case-insensitively."""
+
+    def test_affirmative_forms_are_one(self):
+        for text in ("yes", "YES", "Yes", "yEs", "true", "TRUE", "True"):
+            self.assertEqual(transforms.apply("boolean", text), 1.0)
+
+    def test_negative_forms_are_zero(self):
+        for text in ("no", "NO", "No", "nO", "false", "FALSE", "False"):
+            self.assertEqual(transforms.apply("boolean", text), 0.0)
+
+    def test_other_input_raises_transform_error(self):
+        for text in ("maybe", "", "1", "0", "y", "n", "yes please"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", text)
+
+    def test_boolean_column_in_a_report(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-bool-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        inp = os.path.join(tmp, "in")
+        os.makedirs(inp)
+        with open(os.path.join(inp, "flags.csv"), "w") as fh:
+            fh.write("id,active\n1,yes\n2,NO\n3,True\n")
+        rules_path = os.path.join(tmp, "rules.toml")
+        with open(rules_path, "w") as fh:
+            fh.write('[transforms]\nactive = "boolean"\n')
+        out = os.path.join(tmp, "out")
+        report = reportgen.run(rules_path, inp, out,
+                               os.path.join(tmp, "cache", "state.json"))
+        col = report["files"]["flags.csv"]["summary"]["columns"]["active"]
+        self.assertEqual(col["distinct"], 2)
+        self.assertEqual(col["sample"], [0.0, 1.0])
+        self.assertEqual(col["numeric_sum"], 1.0)
+        self.assertEqual(report["files"]["flags.csv"]["summary"]["skipped_rows"],
+                         [])
+
