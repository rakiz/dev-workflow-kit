+class FutureCacheVersionTests(unittest.TestCase):
+    """A state file written by a newer schema is not understood: it is
+    treated as an empty cache, the run is done in full and a valid state
+    file is written back."""
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-future-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+
+    def run_tool(self):
+        return reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+
+    def write_state(self, state):
+        os.makedirs(os.path.dirname(self.cache_path), exist_ok=True)
+        with open(self.cache_path, "w") as fh:
+            json.dump(state, fh, indent=2, sort_keys=True)
+
+    def test_entry_from_a_future_registry_version_is_not_reused(self):
+        self.run_tool()
+        state = cache.load_state(self.cache_path)
+        for entry in state.values():
+            entry["registry_version"] = "999"
+        self.write_state(state)
+        report = self.run_tool()
+        self.assertEqual(report["total_rows"], 12012)
+        rewritten = cache.load_state(self.cache_path)
+        self.assertEqual(set(rewritten), set(state))
+        for entry in rewritten.values():
+            self.assertEqual(entry["registry_version"], cache.REGISTRY_VERSION)
+
+    def test_entry_from_an_older_registry_version_is_not_reused(self):
+        self.run_tool()
+        state = cache.load_state(self.cache_path)
+        for entry in state.values():
+            entry["registry_version"] = "1"
+        self.write_state(state)
+        report = self.run_tool()
+        self.assertEqual(report["total_rows"], 12012)
+        rewritten = cache.load_state(self.cache_path)
+        self.assertEqual(set(rewritten), set(state))
+        for entry in rewritten.values():
+            self.assertEqual(entry["registry_version"], cache.REGISTRY_VERSION)
+
+    def test_state_file_from_a_future_schema_version_is_ignored(self):
+        self.run_tool()
+        state = cache.load_state(self.cache_path)
+        self.write_state({"version": "999", "files": state})
+        report = self.run_tool()
+        self.assertEqual(report["total_rows"], 12012)
+        rewritten = cache.load_state(self.cache_path)
+        self.assertEqual(set(rewritten), set(state))
+        for entry in rewritten.values():
+            self.assertEqual(entry["registry_version"], cache.REGISTRY_VERSION)
+
+    def test_damaged_state_file_does_not_crash_the_run(self):
+        self.run_tool()
+        with open(self.cache_path, "w") as fh:
+            fh.write("{not json")
+        report = self.run_tool()
+        self.assertEqual(report["total_rows"], 12012)
+
