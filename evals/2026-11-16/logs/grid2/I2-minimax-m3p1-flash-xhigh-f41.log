+class ReportDeterminismTests(unittest.TestCase):
+    """A report must not depend on whether the cache was warm."""
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-determin-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+
+    def run_tool(self):
+        return reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+
+    def read_report_json(self):
+        with open(os.path.join(self.out, "report.json")) as fh:
+            return fh.read()
+
+    def test_cold_and_cached_runs_produce_the_same_report(self):
+        cold = self.run_tool()
+        cold_json = self.read_report_json()
+        warm = self.run_tool()
+        warm_json = self.read_report_json()
+        self.assertEqual(cold, warm)
+        self.assertEqual(cold_json, warm_json)
+
+    def test_cached_run_reports_the_same_generated_from(self):
+        cold = self.run_tool()
+        warm = self.run_tool()
+        for name in cold["files"]:
+            self.assertEqual(cold["files"][name]["generated_from"],
+                             warm["files"][name]["generated_from"])
+
+
