    # Phase 1: Scan via synccli.scan_files + lstat
    t0 = time.perf_counter()
    rels = synccli.scan_files(src)
    cand = {}
    for rel in rels:
        if rel == synccli.MANIFEST_NAME:
            continue
        st = os.lstat(os.path.join(src, rel))
        if stat.S_ISREG(st.st_mode):
            cand[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode & 0o777}
    t_scan = time.perf_counter() - t0

    # Phase 2: Diff via synccli.changed_files
    t0 = time.perf_counter()
    to_copy = synccli.changed_files({}, cand)
    t_diff = time.perf_counter() - t0

    # Phase 3: Copy via .part + fstat check + os.fsync + utime + chmod(ro) + replace
    t0 = time.perf_counter()
    dst_base = os.path.join(staging, "sources", "evals")
    seen_dirs = set()
    committed = {}
    for rel in to_copy:
        sp = os.path.join(src, rel)
        dp = os.path.join(dst_base, rel)
        dd = os.path.dirname(dp)
        if dd not in seen_dirs:
            os.makedirs(dd, exist_ok=True)
            seen_dirs.add(dd)
        part = dp + ".part"
        with open(sp, "rb") as fs:
            pre = os.fstat(fs.fileno())
            with open(part, "wb") as fd:
                shutil.copyfileobj(fs, fd, length=1048576)
                os.fsync(fd.fileno())
            post = os.fstat(fs.fileno())
        os.utime(part, ns=(post.st_atime_ns, post.st_mtime_ns))
        os.chmod(part, post.st_mode & 0o555)
        os.replace(part, dp)
        committed[rel] = {"size": post.st_size, "mtime_ns": post.st_mtime_ns, "mode": post.st_mode & 0o777}
    t_copy = time.perf_counter() - t0

    # Phase 4: Write manifest + F_FULLFSYNC + atomic rename + F_FULLFSYNC root
    t0 = time.perf_counter()
    body = json.dumps({"version": 1, "sources": {"evals": {"files": committed}}}, separators=(",", ":"), sort_keys=True).encode("utf-8")
    digest = hashlib.sha256(body).hexdigest()
    envelope = json.dumps({"sha256": digest, "payload": json.loads(body)}).encode("utf-8")
    m_tmp = os.path.join(staging, "manifest.json.tmp")
    m_fin = os.path.join(staging, "manifest.json")
    with open(m_tmp, "wb") as fp:
        fp.write(envelope)
        fp.flush()
        fsync_durable(fp.fileno())
    os.replace(m_tmp, m_fin)
    os.chmod(m_fin, 0o444)
    sfd = os.open(staging, os.O_RDONLY)
    fsync_durable(sfd)
    os.close(sfd)

    snap_path = os.path.join(broot, "snap-20261117-150000-0001")
    os.rename(staging, snap_path)
    bfd = os.open(broot, os.O_RDONLY)
    fsync_durable(bfd)
    os.close(bfd)
    t_commit = time.perf_counter() - t0

    # Verify incremental run (0% changed -> 25,000 hardlinks!)
    t0 = time.perf_counter()
    staging2 = os.path.join(broot, ".staging-bench2")
    dst_base2 = os.path.join(staging2, "sources", "evals")
    os.makedirs(dst_base2)
    rels2 = synccli.scan_files(src)
    cand2 = {rel: {"size": (st := os.lstat(os.path.join(src, rel))).st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode & 0o777} for rel in rels2}
    changed2 = set(synccli.changed_files(committed, cand2))
    seen_dirs2 = set()
    for rel in cand2:
        if rel not in changed2:
            dp2 = os.path.join(dst_base2, rel)
            dd2 = os.path.dirname(dp2)
            if dd2 not in seen_dirs2:
                os.makedirs(dd2, exist_ok=True)
                seen_dirs2.add(dd2)
            os.link(os.path.join(snap_path, "sources", "evals", rel), dp2)
    snap_path2 = os.path.join(broot, "snap-20261117-150001-0001")
    os.rename(staging2, snap_path2)
    t_incr = time.perf_counter() - t0

    # Verify two-phase trash rename + rmtree works cleanly with 0o444 files!
    t0 = time.perf_counter()
    trash_entry = os.path.join(trash, "snap-20261117-150000-0001.1700000000")
    os.rename(snap_path, trash_entry)
    shutil.rmtree(trash_entry)
    t_prune = time.perf_counter() - t0

    total = t_scan + t_diff + t_copy + t_commit
    print(f"Scan+lstat (synccli.scan_files + lstat): {t_scan:.3f}s")
    print(f"Diff (synccli.changed_files):            {t_diff:.4f}s")
    print(f"Copy+fstat+fsync+utime+chmod+replace:    {t_copy:.3f}s ({25000/t_copy:.0f} files/s)")
    print(f"Manifest+F_FULLFSYNC+atomic rename:      {t_commit:.3f}s")
    print(f"TOTAL full 1.000 GiB / 25,000 files:     {total:.3f}s")
    print(f"Incremental 0%-changed (25k hardlinks):  {t_incr:.3f}s (changed={len(changed2)})")
    print(f"Two-phase trash rename + rmtree (25k):   {t_prune:.3f}s")
'
