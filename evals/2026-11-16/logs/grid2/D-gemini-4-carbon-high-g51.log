import fcntl, json, os, shutil, sys, tempfile, time, tracemalloc

with tempfile.TemporaryDirectory(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode") as tmp:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    os.makedirs(dst)

    # Full 25,000 files totaling 1,024 MiB (1 GiB):
    # 24,900 small files * 36 KiB = 875.39 MiB + 100 medium files * 1,522 KiB = 148.63 MiB -> 1,024.02 MiB (1.00 GiB)
    payload_small = b"a" * (36 * 1024)
    payload_med = b"b" * (1522 * 1024)
    for d in range(250):
        dpath = os.path.join(src, f"eval_{d:04d}")
        os.makedirs(dpath)
        for f in range(100):
            idx = d * 100 + f
            with open(os.path.join(dpath, f"out_{f:03d}.json"), "wb") as fp:
                fp.write(payload_med if idx < 100 else payload_small)

    # 1. Scan + stat (single-pass scandir with size, mtime_ns, mode)
    tracemalloc.start()
    t0 = time.perf_counter()
    manifest = {}
    stack = [""]
    while stack:
        rel_dir = stack.pop()
        abs_dir = os.path.join(src, rel_dir) if rel_dir else src
        with os.scandir(abs_dir) as it:
            for entry in it:
                name = entry.name
                if entry.is_dir(follow_symlinks=False):
                    if not name.startswith("."):
                        stack.append(os.path.join(rel_dir, name) if rel_dir else name)
                elif entry.is_file(follow_symlinks=False):
                    st = entry.stat(follow_symlinks=False)
                    rel = os.path.join(rel_dir, name) if rel_dir else name
                    manifest[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode & 0o777}
    manifest = dict(sorted(manifest.items()))
    t_scan = time.perf_counter() - t0
    cur_mem, peak_mem = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    # 2. Full copy of 25,000 files / 1 GiB + post-fstat check + copystat
    t0 = time.perf_counter()
    seen_dirs = set()
    total_bytes = 0
    for rel, meta in manifest.items():
        sp = os.path.join(src, rel)
        dp = os.path.join(dst, rel)
        dd = os.path.dirname(dp)
        if dd not in seen_dirs:
            os.makedirs(dd, exist_ok=True)
            seen_dirs.add(dd)
        with open(sp, "rb") as fs, open(dp, "wb") as fd:
            shutil.copyfileobj(fs, fd, length=1048576)
            st2 = os.fstat(fs.fileno())
            total_bytes += st2.st_size
        os.chmod(dp, meta["mode"])
        os.utime(dp, ns=(st2.st_atime_ns, meta["mtime_ns"]))
    t_copy = time.perf_counter() - t0

    # 3. Manifest write + fsync
    m_tmp = os.path.join(dst, ".manifest.tmp")
    m_fin = os.path.join(dst, "manifest.json")
    t0 = time.perf_counter()
    with open(m_tmp, "w", encoding="utf-8") as fp:
        json.dump(manifest, fp, separators=(",", ":"))
        fp.flush()
        os.fsync(fp.fileno())
    os.replace(m_tmp, m_fin)
    t_manifest_commit = time.perf_counter() - t0
    m_size = os.path.getsize(m_fin)

    # 4. Measure 100 os.fsync vs 10 F_FULLFSYNC to see cost
    t0 = time.perf_counter()
    for i in range(100):
        p = os.path.join(tmp, f"fs_{i}")
        with open(p, "wb") as fp:
            fp.write(b"x")
            fp.flush()
            os.fsync(fp.fileno())
    t_100_fsync = time.perf_counter() - t0

    t0 = time.perf_counter()
    for i in range(10):
        p = os.path.join(tmp, f"ffs_{i}")
        with open(p, "wb") as fp:
            fp.write(b"x")
            fp.flush()
            if hasattr(fcntl, "F_FULLFSYNC"):
                fcntl.fcntl(fp.fileno(), fcntl.F_FULLFSYNC)
    t_10_fullfsync = time.perf_counter() - t0

    print(f"25,000 files ({total_bytes / (1024**3):.3f} GiB):")
    print(f"  scandir+stat: {t_scan:.3f}s ({25000/t_scan:.0f} files/s)")
    print(f"  manifest RAM: cur={cur_mem:,} B ({cur_mem/25000:.1f} B/file), peak={peak_mem:,} B ({peak_mem/25000:.1f} B/file)")
    print(f"  copy+fstat+chmod+utime: {t_copy:.3f}s ({25000/t_copy:.0f} files/s, {(total_bytes/1024**2)/t_copy:.1f} MiB/s)")
    print(f"  manifest write+fsync+replace: {t_manifest_commit:.4f}s, size={m_size:,} B ({m_size/25000:.1f} B/file)")
    print(f"  total end-to-end: {t_scan + t_copy + t_manifest_commit:.3f}s")
    print(f"  100x os.fsync: {t_100_fsync:.4f}s ({t_100_fsync*10:.2f}ms each)")
    print(f"  10x F_FULLFSYNC: {t_10_fullfsync:.4f}s ({t_10_fullfsync*100:.2f}ms each)")
