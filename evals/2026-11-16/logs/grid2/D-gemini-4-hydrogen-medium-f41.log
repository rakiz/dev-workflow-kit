import os, time, tempfile, shutil, json
d = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
src = os.path.join(d, "src")
dst = os.path.join(d, "dst")
os.makedirs(src)
# Create 2000 small files (total ~20 MB) to measure per-file stat/open/copy overhead
payload = b"x" * 10240
t0 = time.perf_counter()
for i in range(20):
    sub = os.path.join(src, f"dir_{i:02d}")
    os.makedirs(sub)
    for j in range(100):
        with open(os.path.join(sub, f"f_{j:03d}.dat"), "wb") as f:
            f.write(payload)
t_create = time.perf_counter() - t0

import synccli
t0 = time.perf_counter()
m = synccli.build_manifest(src)
t_scan = time.perf_counter() - t0

t0 = time.perf_counter()
synccli.sync(src, dst)
t_sync = time.perf_counter() - t0

# Measure streaming copy of 100MB single file
big_src = os.path.join(d, "big.bin")
big_dst = os.path.join(d, "big_dst.bin")
with open(big_src, "wb") as f:
    f.write(b"a" * (100 * 1024 * 1024))
t0 = time.perf_counter()
with open(big_src, "rb") as fs, open(big_dst, "wb") as fd:
    shutil.copyfileobj(fs, fd, length=1024*1024)
t_big = time.perf_counter() - t0

# Measure hardlink of 2000 files
hl_dst = os.path.join(d, "hl_dst")
os.makedirs(hl_dst)
for i in range(20):
    os.makedirs(os.path.join(hl_dst, f"dir_{i:02d}"))
t0 = time.perf_counter()
for rel in m:
    os.link(os.path.join(dst, rel), os.path.join(hl_dst, rel))
t_hl = time.perf_counter() - t0

shutil.rmtree(d)
print(f"2000x10KB (20MB): scan={t_scan:.4f}s, sync={t_sync:.4f}s, hardlink={t_hl:.4f}s")
print(f"100MB stream copy: {t_big:.4f}s ({100/t_big:.1f} MB/s)")
'
