import tempfile, os, time, synccli, shutil, json

# Larger file test: what limits throughput?
# Test with 1KB files (many small files = syscall bound)
src = tempfile.mkdtemp()
n = 10000
for i in range(n):
    with open(os.path.join(src, f'f{i:05d}.dat'), 'wb') as f:
        f.write(b'x'*1024)

t0 = time.perf_counter()
manifest = synccli.build_manifest(src)
t1 = time.perf_counter()
print(f'build_manifest 10k x 1KB: {t1-t0:.3f}s')

# Measure open+read+write copy for 1KB
dst = tempfile.mkdtemp()
files = synccli.scan_files(src)
t0 = time.perf_counter()
for rel in files:
    synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
t1 = time.perf_counter()
print(f'copy 10k x 1KB via copy_file: {t1-t0:.3f}s  per-file={(t1-t0)/n*1e6:.0f}us')

# Measure raw throughput with larger files
src2 = tempfile.mkdtemp()
for i in range(100):
    with open(os.path.join(src2, f'f{i}.dat'), 'wb') as f:
        f.write(b'x'*1024*1024)  # 1MB each = 100MB total
files2 = synccli.scan_files(src2)
dst2 = tempfile.mkdtemp()
t0 = time.perf_counter()
for rel in files2:
    synccli.copy_file(os.path.join(src2, rel), os.path.join(dst2, rel))
t1 = time.perf_counter()
print(f'copy 100 x 1MB: {t1-t0:.3f}s  throughput={100/(t1-t0):.1f} MB/s')

shutil.rmtree(src); shutil.rmtree(src2); shutil.rmtree(dst); shutil.rmtree(dst2)

# Check synccli constants
print(f'MANIFEST_NAME={synccli.MANIFEST_NAME}')
# snaputil check
import snaputil
print(f'snaputil functions: list_snapshots prune_snapshots snapshot_disk_usage safe_snapshot_path is_stalemain')
"

