import tempfile, os, time, synccli, shutil, json

# Measure build_manifest + scan overhead
# Create a tree resembling evals: many small files
src = tempfile.mkdtemp()
# Create 10000 small files (~10KB each = 100MB) to extrapolate
# Actually create smaller sample and measure per-file cost
import time

n = 5000
for i in range(n):
    sub = os.path.join(src, f'd{i//500:03d}')
    os.makedirs(sub, exist_ok=True)
    with open(os.path.join(sub, f'f{i:05d}.txt'), 'w') as f:
        f.write('x' * 10240)  # 10KB

t0 = time.perf_counter()
manifest = synccli.build_manifest(src)
t1 = time.perf_counter()
print(f'build_manifest {n} files: {t1-t0:.3f}s  per-file={(t1-t0)/n*1e6:.0f}us')

t0 = time.perf_counter()
files = synccli.scan_files(src)
t1 = time.perf_counter()
print(f'scan_files {n} files: {t1-t0:.3f}s')

# Copy benchmark
dst = tempfile.mkdtemp()
t0 = time.perf_counter()
for rel in files[:1000]:
    synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
t1 = time.perf_counter()
print(f'copy 1000 files (10KB each): {t1-t0:.3f}s  per-file={(t1-t0)/1000*1e6:.0f}us  throughput={1000*10240/(t1-t0)/1e6:.1f} MB/s')

# Check file_state cost
import os as _os
t0 = time.perf_counter()
for rel in files:
    synccli.file_state(os.path.join(src, rel))
t1 = time.perf_counter()
print(f'file_state {n} files: {t1-t0:.3f}s per-file={(t1-t0)/n*1e6:.0f}us')

shutil.rmtree(src); shutil.rmtree(dst)

# Also test sync full
src2 = tempfile.mkdtemp()
dst2 = tempfile.mkdtemp()
for i in range(1000):
