        while w>0:
            c=min(w,len(blob)); f.write(blob[:c]); w-=c
print("made",n,"files",sum(sizes)/1e6,"MB max",max(sizes)/1e6,"MB median",sorted(sizes)[n//2],"in",round(time.time()-t,1),"s")
