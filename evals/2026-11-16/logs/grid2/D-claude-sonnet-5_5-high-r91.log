# prototype: streaming copy w/ fstat, utime, chmod 0444
def copy_stream(src,dst):
    fd=os.open(src,os.O_RDONLY)
    try:
        st=os.fstat(fd)
        os.makedirs(os.path.dirname(dst),exist_ok=True)
        with os.fdopen(os.dup(fd),"rb") as fs, open(dst,"wb") as fd2:
            while True:
                b=fs.read(1<<20)
                if not b: break
                fd2.write(b)
        os.utime(dst,ns=(st.st_atime_ns,st.st_mtime_ns)); os.chmod(dst,0o444)
        st2=os.fstat(fd)
        assert (st2.st_size,st2.st_mtime_ns)==(st.st_size,st.st_mtime_ns)
        return st
    finally: os.close(fd)
def full():
    ent={}
    for rel in files:
        st=copy_stream(os.path.join("src",rel),os.path.join("snapA","data","src",rel))
        ent[rel]=[st.st_size,st.st_mtime_ns,st.st_ctime_ns,st.st_ino,st.st_mode]
    return ent
