import os, shutil, tempfile, time, json
import sys
sys.path.insert(0, os.getcwd())
import synccli

tmp = tempfile.mkdtemp(prefix="bench_", dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst1 = os.path.join(tmp, "dst1")
    dst2 = os.path.join(tmp, "dst2")
    dst3 = os.path.join(tmp, "dst3")
    os.makedirs(src)
    os.makedirs(dst1)
    os.makedirs(dst2)
    os.makedirs(dst3)

    # Create 5000 small files across 50 subdirs (~50 MB total, 10 KB avg) to measure per-file metadata + I/O
    n_files = 5000
    payload_small = b"x" * 10240  # 10 KB
    t0 = time.perf_counter()
    for i in range(50):
        d = os.path.join(src, f"eval_{i:03d}")
        os.makedirs(d)
        for j in range(100):
            with open(os.path.join(d, f"res_{j:03d}.json"), "wb") as f:
                f.write(payload_small)
    t_setup = time.perf_counter() - t0

    # Measure synccli.scan_files
    t0 = time.perf_counter()
    files = synccli.scan_files(src)
    t_scan = time.perf_counter() - t0

    # Measure synccli.build_manifest
    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0

    # Measure synccli.sync (first full copy using synccli.copy_file)
    t0 = time.perf_counter()
    synccli.sync(src, dst1)
    t_synccli = time.perf_counter() - t0

    # Measure single-pass scandir + buffered 256KB copy (no extra stat)
    t0 = time.perf_counter()
    buf = bytearray(262144)
    mv = memoryview(buf)
    copied = 0
    for dirpath, dirnames, filenames in os.walk(src):
        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        rel_dir = os.path.relpath(dirpath, src)
        out_dir = dst2 if rel_dir == "." else os.path.join(dst2, rel_dir)
        os.makedirs(out_dir, exist_ok=True)
        for name in filenames:
            sp = os.path.join(dirpath, name)
            dp = os.path.join(out_dir, name)
            with open(sp, "rb") as fs, open(dp, "wb") as fd:
                while True:
                    n = fs.readinto(buf)
                    if not n:
                        break
                    fd.write(mv[:n])
            copied += 1
    t_stream = time.perf_counter() - t0

    # Measure os.link for 5000 files (incremental unchanged snapshot)
    t0 = time.perf_counter()
    for dirpath, dirnames, filenames in os.walk(dst2):
        rel_dir = os.path.relpath(dirpath, dst2)
        out_dir = dst3 if rel_dir == "." else os.path.join(dst3, rel_dir)
        os.makedirs(out_dir, exist_ok=True)
        for name in filenames:
            os.link(os.path.join(dirpath, name), os.path.join(out_dir, name))
    t_link = time.perf_counter() - t0

    # Measure bulk 200 MB copy to gauge sequential disk write speed
    big_src = os.path.join(tmp, "big.bin")
    big_dst = os.path.join(tmp, "big_copy.bin")
    chunk = b"y" * (1024 * 1024)
    with open(big_src, "wb") as f:
        for _ in range(200):
            f.write(chunk)
    t0 = time.perf_counter()
    with open(big_src, "rb") as fs, open(big_dst, "wb") as fd:
        shutil.copyfileobj(fs, fd, length=1024*1024)
    t_big = time.perf_counter() - t0

    # Measure json dump/load of 25,000-entry manifest
    big_manifest = {f"eval_{i//500:03d}/res_{i%500:03d}.json": {"size": 10240, "mtime_ns": 1700000000000000000} for i in range(25000)}
    mpath = os.path.join(tmp, "m.json")
    t0 = time.perf_counter()
    with open(mpath, "w") as f:
        json.dump(big_manifest, f)
    t_jdump = time.perf_counter() - t0
    t0 = time.perf_counter()
    with open(mpath, "r") as f:
        loaded = json.load(f)
    t_jload = time.perf_counter() - t0
    m_size = os.path.getsize(mpath)

    print(f"n_files={len(files)}, t_scan={t_scan:.4f}s, t_manifest={t_manifest:.4f}s")
    print(f"t_synccli_5000x10KB={t_synccli:.4f}s ({len(files)/t_synccli:.0f} files/s)")
    print(f"t_stream_5000x10KB={t_stream:.4f}s ({copied/t_stream:.0f} files/s)")
    print(f"t_hardlink_5000={t_link:.4f}s ({copied/t_link:.0f} files/s)")
    print(f"t_big_200MB={t_big:.4f}s ({200/t_big:.1f} MB/s)")
    print(f"manifest_25k: bytes={m_size}, dump={t_jdump:.4f}s, load={t_jload:.4f}s")
finally:
    shutil.rmtree(tmp)
