import os, shutil, tempfile, time
from concurrent.futures import ThreadPoolExecutor

tmp = tempfile.mkdtemp(prefix="bench3_", dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst1 = os.path.join(tmp, "dst1")
    dst4 = os.path.join(tmp, "dst4")
    os.makedirs(src); os.makedirs(dst1); os.makedirs(dst4)

    # 2000 files x 10 KB = 20 MB
    for i in range(40):
        d = os.path.join(src, f"d_{i:02d}")
        os.makedirs(d)
        for j in range(50):
            with open(os.path.join(d, f"f_{j:03d}.bin"), "wb") as f:
                f.write(b"z" * 10240)

    def copy_one(args):
        sp, dp = args
        with open(sp, "rb") as fs, open(dp, "wb") as fd:
            shutil.copyfileobj(fs, fd, 262144)

    pairs1, pairs4 = [], []
    for i in range(40):
        os.makedirs(os.path.join(dst1, f"d_{i:02d}"), exist_ok=True)
        os.makedirs(os.path.join(dst4, f"d_{i:02d}"), exist_ok=True)
        for j in range(50):
            sp = os.path.join(src, f"d_{i:02d}", f"f_{j:03d}.bin")
            pairs1.append((sp, os.path.join(dst1, f"d_{i:02d}", f"f_{j:03d}.bin")))
            pairs4.append((sp, os.path.join(dst4, f"d_{i:02d}", f"f_{j:03d}.bin")))

    t0 = time.perf_counter()
    for p in pairs1:
        copy_one(p)
    t_1t = time.perf_counter() - t0

    t0 = time.perf_counter()
    with ThreadPoolExecutor(max_workers=4) as ex:
        list(ex.map(copy_one, pairs4))
    t_4t = time.perf_counter() - t0

    # fsync on 500 files
    t0 = time.perf_counter()
    for _, dp in pairs1[:500]:
        fd = os.open(dp, os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    t_fsync_500 = time.perf_counter() - t0

    print(f"2000x10KB 1-thread={t_1t:.4f}s ({2000/t_1t:.0f} files/s)")
    print(f"2000x10KB 4-thread={t_4t:.4f}s ({2000/t_4t:.0f} files/s)")
    print(f"500 os.fsync={t_fsync_500:.4f}s ({500/t_fsync_500:.0f} fsync/s)")
finally:
    shutil.rmtree(tmp)
