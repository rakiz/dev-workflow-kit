import os, shutil, tempfile, time

tmp = tempfile.mkdtemp(prefix="bench2_", dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst_no_fsync = os.path.join(tmp, "dst_no_fsync")
    dst_fsync = os.path.join(tmp, "dst_fsync")
    dst_link = os.path.join(tmp, "dst_link")
    os.makedirs(src)
    os.makedirs(dst_no_fsync)
    os.makedirs(dst_fsync)
    os.makedirs(dst_link)

    # 1000 files across 20 dirs
    for i in range(20):
        d = os.path.join(src, f"d_{i:02d}")
        os.makedirs(d)
        for j in range(50):
            with open(os.path.join(d, f"f_{j:03d}.txt"), "wb") as f:
                f.write(b"a" * 4096)

    # Copy without fsync (cached makedirs)
    t0 = time.perf_counter()
    for i in range(20):
        sd = os.path.join(src, f"d_{i:02d}")
        dd = os.path.join(dst_no_fsync, f"d_{i:02d}")
        os.makedirs(dd, exist_ok=True)
        for j in range(50):
            with open(os.path.join(sd, f"f_{j:03d}.txt"), "rb") as fs, open(os.path.join(dd, f"f_{j:03d}.txt"), "wb") as fd:
                fd.write(fs.read())
    t_no_fsync = time.perf_counter() - t0

    # Copy WITH per-file os.fsync (only 200 files so it's fast)
    os.makedirs(os.path.join(dst_fsync, "d_00"), exist_ok=True)
    t0 = time.perf_counter()
    for j in range(50):
        sp = os.path.join(src, "d_00", f"f_{j:03d}.txt")
        dp = os.path.join(dst_fsync, "d_00", f"f_{j:03d}.txt")
        with open(sp, "rb") as fs, open(dp, "wb") as fd:
            fd.write(fs.read())
            fd.flush()
            os.fsync(fd.fileno())
    t_fsync_50 = time.perf_counter() - t0

    # Hardlink 1000 files (warm)
    t0 = time.perf_counter()
    for i in range(20):
        sd = os.path.join(dst_no_fsync, f"d_{i:02d}")
        dd = os.path.join(dst_link, f"d_{i:02d}")
        os.makedirs(dd, exist_ok=True)
        for j in range(50):
            os.link(os.path.join(sd, f"f_{j:03d}.txt"), os.path.join(dd, f"f_{j:03d}.txt"))
    t_link_1000 = time.perf_counter() - t0

    # rmtree 1000 files
    t0 = time.perf_counter()
    shutil.rmtree(dst_link)
    t_rm_1000 = time.perf_counter() - t0

    # Test single-pass scandir vs synccli.build_manifest on 1000 files
    import sys
    sys.path.insert(0, os.getcwd())
    import synccli
    t0 = time.perf_counter()
    synccli.build_manifest(src)
    t_build_1000 = time.perf_counter() - t0

    t0 = time.perf_counter()
    def fast_scan(root):
        res = {}
        stack = [(root, "")]
        while stack:
            cur, rel_base = stack.pop()
            with os.scandir(cur) as it:
                for entry in it:
                    if entry.is_dir(follow_symlinks=False):
                        if not entry.name.startswith("."):
                            stack.append((entry.path, os.path.join(rel_base, entry.name) if rel_base else entry.name))
                    elif entry.is_file(follow_symlinks=False):
                        st = entry.stat(follow_symlinks=False)
                        rel = os.path.join(rel_base, entry.name) if rel_base else entry.name
                        res[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns}
        return res
    fast_scan(src)
    t_fast_1000 = time.perf_counter() - t0

    print(f"1000x4KB copy_no_fsync={t_no_fsync:.4f}s ({1000/t_no_fsync:.0f} files/s)")
    print(f"50x4KB copy_with_fsync={t_fsync_50:.4f}s ({50/t_fsync_50:.0f} files/s)")
    print(f"1000 hardlink={t_link_1000:.4f}s ({1000/t_link_1000:.0f} files/s)")
    print(f"1000 rmtree={t_rm_1000:.4f}s ({1000/t_rm_1000:.0f} files/s)")
    print(f"1000 synccli.build_manifest={t_build_1000:.4f}s vs fast_scandir={t_fast_1000:.4f}s")
finally:
    shutil.rmtree(tmp)
