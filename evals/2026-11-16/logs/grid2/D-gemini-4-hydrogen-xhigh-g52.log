import os, shutil, tempfile, time, json
from concurrent.futures import ThreadPoolExecutor
import sys
sys.path.insert(0, os.getcwd())
import synccli

tmp = tempfile.mkdtemp(prefix="bench_1fifth_", dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst_synccli = os.path.join(tmp, "dst_synccli")
    dst_1t = os.path.join(tmp, "dst_1t")
    dst_4t = os.path.join(tmp, "dst_4t")
    os.makedirs(src); os.makedirs(dst_synccli); os.makedirs(dst_1t); os.makedirs(dst_4t)

    # 1/5 scale of 30,000 files / 1,000 MB:
    # 5,900 x 10 KB (59 MB) + 100 x 1.41 MB (141 MB) = 6,000 files, 200 MB
    small_data = b"a" * 10240
    large_data = b"b" * (1410 * 1024)
    for d_idx in range(60):
        d = os.path.join(src, f"eval_{d_idx:03d}")
        os.makedirs(d)
        for f_idx in range(98):
            with open(os.path.join(d, f"metric_{f_idx:03d}.json"), "wb") as f:
                f.write(small_data)
        with open(os.path.join(d, "summary_a.json"), "wb") as f:
            f.write(small_data)
        if d_idx < 50:
            with open(os.path.join(d, "ckpt_1.bin"), "wb") as f:
                f.write(large_data)
            with open(os.path.join(d, "ckpt_2.bin"), "wb") as f:
                f.write(large_data)
        else:
            with open(os.path.join(d, "extra_1.json"), "wb") as f:
                f.write(small_data)
            with open(os.path.join(d, "extra_2.json"), "wb") as f:
                f.write(small_data)

    # Baseline: existing synccli.sync()
    t0 = time.perf_counter()
    copied_sync = synccli.sync(src, dst_synccli)
    t_synccli = time.perf_counter() - t0

    # Proposed pipeline 1-thread: single-pass scandir + chunked copy (256KB) + index write+fsync
    def run_pipeline(dst, workers=1, do_fsync=False):
        t_start = time.perf_counter()
        entries = []
        stack = [(src, "")]
        while stack:
            cur, rel_base = stack.pop()
            with os.scandir(cur) as it:
                for e in it:
                    if e.is_dir(follow_symlinks=False):
                        if not e.name.startswith("."):
                            rel_d = os.path.join(rel_base, e.name) if rel_base else e.name
                            os.makedirs(os.path.join(dst, rel_d), exist_ok=True)
                            stack.append((e.path, rel_d))
                    elif e.is_file(follow_symlinks=False):
                        st = e.stat(follow_symlinks=False)
                        rel_f = os.path.join(rel_base, e.name) if rel_base else e.name
                        entries.append((e.path, os.path.join(dst, rel_f), rel_f, st.st_size, st.st_mtime_ns))
        t_scan = time.perf_counter() - t_start

        t_copy0 = time.perf_counter()
        def copy_entry(item):
            sp, dp, rel_f, sz, mt = item
            with open(sp, "rb") as fs, open(dp, "wb") as fd:
                shutil.copyfileobj(fs, fd, 262144)
                if do_fsync:
                    fd.flush()
                    os.fsync(fd.fileno())
            return rel_f, {"size": sz, "mtime_ns": mt}

        manifest = {}
        if workers == 1:
            for item in entries:
                k, v = copy_entry(item)
                manifest[k] = v
        else:
            with ThreadPoolExecutor(max_workers=workers) as ex:
                for k, v in ex.map(copy_entry, entries):
                    manifest[k] = v
        t_copy = time.perf_counter() - t_copy0

        t_idx0 = time.perf_counter()
        idx_tmp = os.path.join(dst, ".snapshot_index.json.tmp")
        idx_fin = os.path.join(dst, ".snapshot_index.json")
        with open(idx_tmp, "w", encoding="utf-8") as f:
            json.dump({"files": manifest}, f)
            f.flush()
            os.fsync(f.fileno())
        os.replace(idx_tmp, idx_fin)
        t_idx = time.perf_counter() - t_idx0
        t_tot = time.perf_counter() - t_start
        return len(entries), t_scan, t_copy, t_idx, t_tot

    n1, s1, c1, i1, tot1 = run_pipeline(dst_1t, workers=1, do_fsync=False)
    n4, s4, c4, i4, tot4 = run_pipeline(dst_4t, workers=4, do_fsync=True)

    print(f"Synccli baseline ({len(copied_sync)} files, 200MB): total={t_synccli:.4f}s (5x -> {5*t_synccli:.2f}s)")
    print(f"1T no-fsync ({n1} files, 200MB): scan={s1:.4f}s copy={c1:.4f}s idx={i1:.4f}s total={tot1:.4f}s (5x -> {5*tot1:.2f}s)")
    print(f"4T with-fsync ({n4} files, 200MB): scan={s4:.4f}s copy={c4:.4f}s idx={i4:.4f}s total={tot4:.4f}s (5x -> {5*tot4:.2f}s)")
finally:
    shutil.rmtree(tmp)
