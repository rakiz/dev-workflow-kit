import json, os, tempfile, time, tracemalloc
TMP_BASE = "/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode"

def bench_case(num_files, total_mib):
    file_size = (total_mib * 1024 * 1024) // num_files
    payload = b"a" * file_size
    buf = bytearray(1024 * 1024)
    mv = memoryview(buf)
    with tempfile.TemporaryDirectory(dir=TMP_BASE) as tmp:
        src = os.path.join(tmp, "src")
        stg = os.path.join(tmp, "stg")
        num_dirs = max(1, num_files // 100)
        for d in range(num_dirs):
            os.makedirs(os.path.join(src, f"d_{d:04d}"), exist_ok=True)
        for i in range(num_files):
            with open(os.path.join(src, f"d_{i % num_dirs:04d}", f"f_{i:06d}.dat"), "wb") as f:
                f.write(payload)

        tracemalloc.start()
        t0 = time.perf_counter()
        # Scan
        manifest = {}
        stack = [("", src)]
        while stack:
            rel_d, abs_d = stack.pop()
            with os.scandir(abs_d) as it:
                entries = sorted(it, key=lambda e: e.name)
            for e in entries:
                if e.is_dir(follow_symlinks=False):
                    if not e.name.startswith("."):
                        stack.append((os.path.join(rel_d, e.name) if rel_d else e.name, e.path))
                elif e.is_file(follow_symlinks=False):
                    st = e.stat(follow_symlinks=False)
                    rel = os.path.join(rel_d, e.name) if rel_d else e.name
                    manifest[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode & 0o7777}
        t_scan = time.perf_counter() - t0
        _, mem_after_scan = tracemalloc.get_traced_memory()

        # Copy
        t1 = time.perf_counter()
        made_dirs = set()
        for rel, meta in manifest.items():
            sp = os.path.join(src, rel)
            dp = os.path.join(stg, "sources", "s0", rel)
            dd = os.path.dirname(dp)
            if dd not in made_dirs:
                os.makedirs(dd, exist_ok=True)
                made_dirs.add(dd)
            with open(sp, "rb") as fs, open(dp, "wb") as fd:
                while True:
                    n = fs.readinto(buf)
                    if not n:
                        break
                    fd.write(mv[:n])
            os.chmod(dp, meta["mode"])
        t_copy = time.perf_counter() - t1

        # Index + sync + publish
        t2 = time.perf_counter()
        idx_p = os.path.join(stg, "snapshot_index.json")
        with open(idx_p + ".tmp", "w", encoding="utf-8") as f:
            json.dump({"sources": {"s0": {"files": manifest}}}, f, separators=(",", ":"))
            f.flush()
            os.fsync(f.fileno())
        os.replace(idx_p + ".tmp", idx_p)
        os.sync()
        pub = os.path.join(tmp, "snap-20261117-120000-00")
        os.rename(stg, pub)
        dfd = os.open(tmp, os.O_RDONLY)
        os.fsync(dfd)
        os.close(dfd)
        t_commit = time.perf_counter() - t2
        t_total = time.perf_counter() - t0
        _, peak_mem = tracemalloc.get_traced_memory()
        tracemalloc.stop()
        idx_sz = os.path.getsize(os.path.join(pub, "snapshot_index.json"))
        print(f"F={num_files:6d}, B={num_files*file_size/1e9:.3f}GB ({file_size//1024:3d}KiB/f): total={t_total:.3f}s [scan={t_scan:.3f}s, copy={t_copy:.3f}s, commit={t_commit:.3f}s] | peak_mem={peak_mem/1024**2:.2f}MiB | idx={idx_sz/1024**2:.2f}MiB")

