    print(f"synccli.sync (full):    {t_synccli_full:.3f}s | copied={len(copied)} | peak_py_mem={peak_synccli_copy/1024**2:.2f}MiB | manifest_disk={manifest_bytes/1024**2:.2f}MiB")

    # 4. Measure existing synccli.sync second pass (0 changed)
    t0 = time.perf_counter()
    copied2 = synccli.sync(src, dst_synccli)
    t_synccli_noop = time.perf_counter() - t0
    print(f"synccli.sync (noop):    {t_synccli_noop:.3f}s | copied={len(copied2)}")

    # 5. Measure staged chunked copy + index write + fsync + atomic rename
    tracemalloc.start()
    t0 = time.perf_counter()
    os.makedirs(dst_stage)
    created_dirs = set()
    m_stage = fast_scan_manifest(src)
    t_scan_done = time.perf_counter()
    buf = bytearray(1024 * 1024)
    mv = memoryview(buf)
    for rel, st_info in m_stage.items():
        s_path = os.path.join(src, rel)
        d_path = os.path.join(dst_stage, "sources", "eval0", rel)
        d_dir = os.path.dirname(d_path)
        if d_dir not in created_dirs:
            os.makedirs(d_dir, exist_ok=True)
            created_dirs.add(d_dir)
        with open(s_path, "rb") as fs, open(d_path, "wb") as fd:
            while True:
                n = fs.readinto(buf)
                if not n:
                    break
                fd.write(mv[:n])
        os.chmod(d_path, st_info["mode"])
    t_copy_done = time.perf_counter()
    idx_path = os.path.join(dst_stage, "snapshot_index.json")
    with open(idx_path + ".tmp", "w", encoding="utf-8") as f:
        json.dump({"sources": {"eval0": {"files": m_stage}}}, f, separators=(",", ":"))
        f.flush()
        os.fsync(f.fileno())
    os.replace(idx_path + ".tmp", idx_path)
    os.sync()
    pub_path = os.path.join(tmp, "snap-20261117-120000-00")
    os.rename(dst_stage, pub_path)
    dir_fd = os.open(tmp, os.O_RDONLY)
    os.fsync(dir_fd)
    os.close(dir_fd)
    t_pub_done = time.perf_counter()
    _, peak_stage_mem = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    compact_idx_bytes = os.path.getsize(os.path.join(pub_path, "snapshot_index.json"))
    print(f"backupctl staged full:  total={t_pub_done-t0:.3f}s (scan={t_scan_done-t0:.3f}s, copy={t_copy_done-t_scan_done:.3f}s, idx+sync+rename={t_pub_done-t_copy_done:.3f}s) | peak_py_mem={peak_stage_mem/1024**2:.2f}MiB | compact_idx={compact_idx_bytes/1024**2:.2f}MiB")

    # 6. Measure incremental run via changed_files + os.link (0% changed, and 1% = 250 files changed)
    t0 = time.perf_counter()
    os.makedirs(dst_inc)
    with open(os.path.join(pub_path, "snapshot_index.json"), "r", encoding="utf-8") as f:
        old_idx = json.load(f)
    old_m = old_idx["sources"]["eval0"]["files"]
    new_m = fast_scan_manifest(src)
    changed_set = set(synccli.changed_files(old_m, new_m))
    created_dirs2 = set()
    for rel in new_m:
        d_path = os.path.join(dst_inc, "sources", "eval0", rel)
        d_dir = os.path.dirname(d_path)
        if d_dir not in created_dirs2:
            os.makedirs(d_dir, exist_ok=True)
            created_dirs2.add(d_dir)
        if rel not in changed_set:
            os.link(os.path.join(pub_path, "sources", "eval0", rel), d_path)
    pub_path2 = os.path.join(tmp, "snap-20261117-120001-00")
    os.rename(dst_inc, pub_path2)
    t_inc_done = time.perf_counter() - t0
    print(f"backupctl incremental (0 changed, 25k hardlinks): {t_inc_done:.3f}s | changed={len(changed_set)}")

    # 7. Check physical vs logical disk usage across 2 snapshots
    u1 = snaputil.snapshot_disk_usage(tmp, "snap-20261117-120000-00")
    u2 = snaputil.snapshot_disk_usage(tmp, "snap-20261117-120001-00")
    seen_inodes = set()
    phys_bytes = 0
    for sname in ["snap-20261117-120000-00", "snap-20261117-120001-00"]:
        for dp, dn, fn in os.walk(os.path.join(tmp, sname)):
            for nm in fn:
                st = os.lstat(os.path.join(dp, nm))
                key = (st.st_dev, st.st_ino)
                if key not in seen_inodes:
                    seen_inodes.add(key)
                    phys_bytes += st.st_size
    print(f"snaputil logical sum={ (u1+u2)/1024**2 :.2f}MiB vs unique inode bytes={ phys_bytes/1024**2 :.2f}MiB")
