    dst_synccli = os.path.join(tmp, "dst_synccli")
    dst_stage = os.path.join(tmp, "dst_stage")
    dst_inc = os.path.join(tmp, "dst_inc")
    os.makedirs(src)
    os.makedirs(dst_synccli)

    # Build a realistic 1 GiB (1024 MiB) evals tree with 25,000 files across 250 subdirs:
    # - 20,000 small JSON/metric files @ 8 KiB = 160 MiB
    # - 4,750 medium log/trace files @ 128 KiB = 593.75 MiB
    # - 245 artifact files @ 1 MiB = 245 MiB
    # - 5 large checkpoint/summary files @ 5 MiB = 25 MiB
    # Total = 25,000 files, 1023.75 MiB (~1.073 GB)
    t0 = time.perf_counter()
    buf_8k = b"x" * 8192
    buf_128k = b"y" * (128 * 1024)
    buf_1m = b"z" * (1024 * 1024)
    buf_5m = b"w" * (5 * 1024 * 1024)
    total_bytes = 0
    file_count = 0
    for d in range(250):
        dpath = os.path.join(src, f"run_{d:03d}", "results")
        os.makedirs(dpath, exist_ok=True)
        for i in range(80):
            with open(os.path.join(dpath, f"metric_{i:03d}.json"), "wb") as f:
                f.write(buf_8k)
            total_bytes += len(buf_8k); file_count += 1
        for i in range(19):
            with open(os.path.join(dpath, f"trace_{i:02d}.log"), "wb") as f:
                f.write(buf_128k)
            total_bytes += len(buf_128k); file_count += 1
        if d < 245:
            with open(os.path.join(dpath, "artifact.bin"), "wb") as f:
                f.write(buf_1m)
            total_bytes += len(buf_1m); file_count += 1
        else:
            with open(os.path.join(dpath, "checkpoint.bin"), "wb") as f:
                f.write(buf_5m)
            total_bytes += len(buf_5m); file_count += 1
    t_gen = time.perf_counter() - t0
    print(f"Generated: {file_count} files, {total_bytes / (1024**2):.2f} MiB ({total_bytes/1e9:.3f} GB) in {t_gen:.3f}s")

    # 1. Measure existing synccli.build_manifest
    tracemalloc.start()
    t0 = time.perf_counter()
    m_synccli = synccli.build_manifest(src)
    t_build_synccli = time.perf_counter() - t0
    cur_mem, peak_mem_manifest = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    print(f"synccli.build_manifest: {t_build_synccli:.3f}s | entries={len(m_synccli)} | tracemalloc cur={cur_mem/1024**2:.2f}MiB peak={peak_mem_manifest/1024**2:.2f}MiB")

    # 2. Measure single-pass scandir manifest builder
    def fast_scan_manifest(root):
        manifest = {}
        stack = [("", root)]
        while stack:
            rel_dir, abs_dir = stack.pop()
            with os.scandir(abs_dir) as it:
                entries = sorted(it, key=lambda e: e.name)
            for entry in entries:
                name = entry.name
                if entry.is_dir(follow_symlinks=False):
                    if not name.startswith("."):
                        stack.append((os.path.join(rel_dir, name) if rel_dir else name, entry.path))
                elif entry.is_file(follow_symlinks=False):
                    st = entry.stat(follow_symlinks=False)
                    rel = os.path.join(rel_dir, name) if rel_dir else name
                    manifest[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "mode": st.st_mode & 0o7777}
        return manifest

    tracemalloc.start()
    t0 = time.perf_counter()
    m_fast = fast_scan_manifest(src)
    t_build_fast = time.perf_counter() - t0
    cur_mem2, peak_mem2 = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    print(f"fast_scan_manifest:     {t_build_fast:.3f}s | entries={len(m_fast)} | tracemalloc cur={cur_mem2/1024**2:.2f}MiB peak={peak_mem2/1024**2:.2f}MiB")

