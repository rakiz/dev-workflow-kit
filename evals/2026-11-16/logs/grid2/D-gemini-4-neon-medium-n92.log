import hashlib, json, os, shutil, tempfile, time
from concurrent.futures import ThreadPoolExecutor

base = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(base, "src")
    os.makedirs(src)
    # Create 2,000 files across 40 subdirs, avg 32 KiB = 64 MiB total
    # (scales 16x to 32,000 files, 1 GiB)
    n_dirs = 40
    n_per_dir = 50
    n_files = n_dirs * n_per_dir
    payload = b"x" * (32 * 1024)
    t0 = time.perf_counter()
    for d in range(n_dirs):
        dp = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(dp)
        for f in range(n_per_dir):
            with open(os.path.join(dp, f"file_{f:03d}.dat"), "wb") as fp:
                fp.write(payload)
    t_create = time.perf_counter() - t0

    # 1. os.walk + os.stat (synccli.build_manifest style)
    t0 = time.perf_counter()
    manifest = {}
    for dp, dns, fns in os.walk(src):
        dns[:] = [d for d in dns if not d.startswith(".")]
        for fn in fns:
            full = os.path.join(dp, fn)
            rel = os.path.relpath(full, src)
            st = os.stat(full)
            manifest[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns}
    t_scan = time.perf_counter() - t0

    # 2. Single-threaded chunked copy (no per-file fsync)
    dst1 = os.path.join(base, "dst1")
    t0 = time.perf_counter()
    for rel in manifest:
        s = os.path.join(src, rel)
        d = os.path.join(dst1, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            shutil.copyfileobj(fs, fd, 1024 * 1024)
    t_copy_1t = time.perf_counter() - t0

    # 3. 4-thread chunked copy (no per-file fsync)
    dst2 = os.path.join(base, "dst2")
    for d in range(n_dirs):
        os.makedirs(os.path.join(dst2, f"dir_{d:02d}"), exist_ok=True)
    def copy_one(rel):
        s = os.path.join(src, rel)
        d = os.path.join(dst2, rel)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            shutil.copyfileobj(fs, fd, 1024 * 1024)
    t0 = time.perf_counter()
    with ThreadPoolExecutor(max_workers=4) as ex:
        list(ex.map(copy_one, manifest.keys()))
    t_copy_4t = time.perf_counter() - t0

    # 4. Hardlink 2,000 files
    dst3 = os.path.join(base, "dst3")
    for d in range(n_dirs):
        os.makedirs(os.path.join(dst3, f"dir_{d:02d}"), exist_ok=True)
    t0 = time.perf_counter()
    for rel in manifest:
        os.link(os.path.join(dst1, rel), os.path.join(dst3, rel))
    t_link = time.perf_counter() - t0

    # 5. Per-file fsync cost (sample 200 files)
    sample = list(manifest.keys())[:200]
    t0 = time.perf_counter()
    for rel in sample:
        fd = os.open(os.path.join(dst1, rel), os.O_RDONLY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    t_fsync_200 = time.perf_counter() - t0

    # 6. SHA-256 hashing of 64 MiB (2,000 files)
    t0 = time.perf_counter()
    for rel in manifest:
        h = hashlib.sha256()
        with open(os.path.join(src, rel), "rb") as fs:
            while chunk := fs.read(1024 * 1024):
                h.update(chunk)
        h.hexdigest()
    t_sha = time.perf_counter() - t0

    # 7. JSON manifest dump + load (scaled to 32,000 entries)
    big_manifest = {f"dir_{i//800:02d}/file_{i%800:04d}.dat": {"size": 32768, "mtime_ns": 1731420000123456789} for i in range(32000)}
    mpath = os.path.join(base, "manifest.json")
    t0 = time.perf_counter()
    raw = json.dumps(big_manifest, separators=(",", ":")).encode("utf-8")
    with open(mpath, "wb") as f:
        f.write(raw)
        f.flush()
        os.fsync(f.fileno())
    t_mdump = time.perf_counter() - t0
    t0 = time.perf_counter()
    with open(mpath, "rb") as f:
        json.loads(f.read())
    t_mload = time.perf_counter() - t0

    print(f"n_files={n_files}, total_MiB=64")
    print(f"scan+stat: {t_scan*1000:.1f} ms ({n_files/t_scan:.0f} files/s)")
    print(f"copy_1t:   {t_copy_1t*1000:.1f} ms ({64/t_copy_1t:.1f} MiB/s, {n_files/t_copy_1t:.0f} files/s)")
    print(f"copy_4t:   {t_copy_4t*1000:.1f} ms ({64/t_copy_4t:.1f} MiB/s, {n_files/t_copy_4t:.0f} files/s)")
    print(f"hardlink:  {t_link*1000:.1f} ms ({n_files/t_link:.0f} files/s)")
    print(f"fsync_200: {t_fsync_200*1000:.1f} ms ({t_fsync_200/200*1000:.3f} ms/file)")
    print(f"sha256:    {t_sha*1000:.1f} ms ({64/t_sha:.1f} MiB/s)")
    print(f"manifest_32k: size={len(raw)/1024/1024:.2f} MiB, dump+fsync={t_mdump*1000:.1f} ms, load={t_mload*1000:.1f} ms")
finally:
    shutil.rmtree(base, ignore_errors=True)
