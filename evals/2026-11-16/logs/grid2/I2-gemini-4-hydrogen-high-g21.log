+class ReleaseAndRegressionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-reg-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.inp = os.path.join(self.tmp, "in")
+        os.makedirs(self.inp)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+        self.rules_path = os.path.join(self.tmp, "rules.toml")
+
+    def _write_csv(self, name, content):
+        path = os.path.join(self.inp, name)
+        with open(path, "w", encoding="utf-8") as fh:
+            fh.write(content)
+        return path
+
+    def _write_rules(self, content):
+        with open(self.rules_path, "w", encoding="utf-8") as fh:
+            fh.write(content)
+
+    def test_boolean_transform_values_and_errors(self):
+        for raw in ("yes", "YES", "Yes", "true", "TRUE", "True", " true "):
+            res = transforms.apply("boolean", raw)
+            self.assertEqual(res, 1.0)
+            self.assertIsInstance(res, float)
+        for raw in ("no", "NO", "No", "false", "FALSE", "False", " false "):
+            res = transforms.apply("boolean", raw)
+            self.assertEqual(res, 0.0)
+            self.assertIsInstance(res, float)
+        for bad in ("", "   ", "1", "0", "y", "n", "maybe"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", bad)
+
+    def test_boolean_transform_end_to_end(self):
+        self._write_csv("flags.csv", "id,active\n1,Yes\n2,no\n3,TRUE\n4,False\n")
+        self._write_rules('[transforms]\nactive = "boolean"\n')
+        report = reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+        col = report["files"]["flags.csv"]["summary"]["columns"]["active"]
+        self.assertEqual(col["distinct"], 2)
+        self.assertEqual(col["sample"], [0.0, 1.0])
+        self.assertEqual(col["numeric_sum"], 1.0)
+
