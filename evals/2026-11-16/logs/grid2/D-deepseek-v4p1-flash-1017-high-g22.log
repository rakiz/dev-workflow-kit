import os, time, json, tempfile, shutil, hashlib
ROOT=tempfile.mkdtemp(dir=tempfile.gettempdir(), prefix='bproto-')
N=20000; SZ=50*1024
# build source
for d in range(N//200):
    p=os.path.join(ROOT,'src',f'd{d:03d}'); os.makedirs(p)
    for i in range(200):
        with open(os.path.join(p,f'f{i:04d}'),'wb') as f: f.write(b'q'*SZ)

def scan_manifest(root):
    out={}
    for dp,dns,fns in os.walk(root):
        for n in fns:
            full=os.path.join(dp,n); st=os.lstat(full)
            rel=os.path.relpath(full,root)
            out[rel]=(st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_mode, st.st_ino)
    return out

def copy_one(s,d):
    os.makedirs(os.path.dirname(d), exist_ok=True)
    with open(s,'rb') as fs, open(d,'wb') as fd:
        while True:
            b=fs.read(1024*1024)
            if not b: break
            fd.write(b)

def fsync_file(p):
    fd=os.open(p,os.O_RDONLY)
    try: os.fsync(fd)
    finally: os.close(fd)

def full_backup(src, snap):
    t0=time.perf_counter(); man=scan_manifest(src); t_scan=time.perf_counter()-t0
    os.makedirs(snap)
    t0=time.perf_counter()
    for rel in man: copy_one(os.path.join(src,rel), os.path.join(snap,'data',rel))
    t_copy=time.perf_counter()-t0
    t0=time.perf_counter()
    miss=[rel for rel in man if not os.path.exists(os.path.join(snap,'data',rel))]
    t_verify=time.perf_counter()-t0
    t0=time.perf_counter()
    idx={'format':1,'complete':True,'files':{k:list(v) for k,v in man.items()},'missing':miss}
    p=os.path.join(snap,'index.json.tmp')
    with open(p,'w') as f: json.dump(idx,f); f.flush(); os.fsync(f.fileno())
    os.replace(p, os.path.join(snap,'index.json'))
    fd=os.open(snap,os.O_RDONLY); os.fsync(fd); os.close(fd)
    t_idx=time.perf_counter()-t0
    return t_scan,t_copy,t_verify,t_idx

t=full_backup(os.path.join(ROOT,'src'), os.path.join(ROOT,'snap-1','data-root'))
print('FULL scan %.3f copy %.3f verify %.3f index+fsync %.3f total %.3f' % (*t, sum(t)))
# incremental modelled: scan, compare, hardlink unchanged from snap1 tree
def incr(src, prev, snap):
    t0=time.perf_counter(); man=scan_manifest(src); t_scan=time.perf_counter()-t0
    old={k:tuple(v) for k,v in json.load(open(os.path.join(prev,'index.json')))['files'].items()}
    t0=time.perf_counter(); changed=[r for r,v in man.items() if old.get(r)!=v]; t_cmp=time.perf_counter()-t0
    os.makedirs(snap)
    t0=time.perf_counter()
    for rel in man:
        s=os.path.join(src,rel); d=os.path.join(snap,'data',rel)
        os.makedirs(os.path.dirname(d),exist_ok=True)
        if rel in old and old[rel]==man[rel]:
            os.link(os.path.join(prev,'data',rel), d)
        else:
            copy_one(s,d)
    t_link=time.perf_counter()-t0
    return t_scan,t_cmp,len(changed),t_link
t=incr(os.path.join(ROOT,'src'), os.path.join(ROOT,'snap-1','data-root'), os.path.join(ROOT,'snap-2','data-root'))
print('INCR(noop) scan %.3f compare %.3f changed %d link/copy %.3f total %.3f' % (*t, sum(x for x in t if isinstance(x,float))))
print('ROOT',ROOT)
