import sys, os, time, shutil, hashlib, stat, tracemalloc, cProfile, pstats
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-95775")
import synccli
src = "src/evals"
def scan(root):
    out = {}
    stack = [""]
    while stack:
        rel = stack.pop()
        with os.scandir(os.path.join(root, rel) if rel else root) as it:
            for e in it:
                r = os.path.join(rel, e.name) if rel else e.name
                st = e.stat(follow_symlinks=False)
                if stat.S_ISDIR(st.st_mode): stack.append(r)
                elif stat.S_ISREG(st.st_mode):
                    out[r] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "ctime_ns": st.st_ctime_ns}
    return out
t=time.time(); m = scan(src); print("scandir+lstat scan %.2fs n=%d" % (time.time()-t, len(m)))
t=time.time(); m = scan(src); print("again %.2fs" % (time.time()-t))
tracemalloc.start(); m = scan(src); cur,_ = tracemalloc.get_traced_memory(); tracemalloc.stop(); print("mem B/entry", cur/len(m))
import json
old = json.loads(json.dumps(m))
t=time.time(); ch = synccli.changed_files(old, m); print("changed_files %.3fs changed=%d" % (time.time()-t, len(ch)))
t=time.time(); synccli.scan_files(src); print("scan_files again %.2fs" % (time.time()-t))
def copy(srcp, dstp, h, mode):
    sfd = os.open(srcp, os.O_RDONLY)
    try:
        st = os.fstat(sfd)
        dfd = os.open(dstp, os.O_WRONLY|os.O_CREAT|os.O_EXCL, 0o600)
        try:
            hh = hashlib.sha256() if h else None
            while True:
                b = os.read(sfd, 1<<20)
                if not b: break
                if hh: hh.update(b)
                os.write(dfd, b)
            if mode == "fsync": os.fsync(dfd)
            os.utime(dfd, ns=(st.st_atime_ns, st.st_mtime_ns))
            os.fchmod(dfd, (st.st_mode & 0o7555) | 0o444)
        finally: os.close(dfd)
    finally: os.close(sfd)
def full(name, h, mode):
    d = "snapA_"+name; shutil.rmtree(d, ignore_errors=True)
    dirs=set()
    t=time.time()
    for rel in m:
        p = os.path.join(d, rel); dn = os.path.dirname(p)
        if dn not in dirs: os.makedirs(dn, exist_ok=True); dirs.add(dn)
        copy(os.path.join(src, rel), p, h, mode)
    t1=time.time()-t
    if mode == "sync": os.sync()
    print("%-22s copy %.2fs  total(with sync if any) %.2fs" % (name, t1, time.time()-t))
full("plain", False, "none")
full("sha256", True, "none")
full("sha256+sync", True, "sync")
full("sha256+fsync", True, "fsync")
