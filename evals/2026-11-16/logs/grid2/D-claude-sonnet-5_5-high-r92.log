import os, random, sys
root = sys.argv[1]; random.seed(1)
buf = os.urandom(1<<20)
plan = [(28000, 10_000), (1900, 200_000), (100, 3_400_000)]
total = 0; n = 0
for count, size in plan:
    for i in range(count):
        d = os.path.join(root, "run%03d" % (n % 120), "sub%02d" % (n % 17))
        os.makedirs(d, exist_ok=True)
        sz = max(1, int(random.gauss(size, size*0.3)))
        off = random.randrange(0, len(buf)-1)
        data = (buf[off:] + buf[:off])[:sz] if sz <= len(buf) else buf*(sz//len(buf)+1)
        with open(os.path.join(d, "f%d.dat" % n), "wb") as f: f.write(data[:sz])
        total += sz; n += 1
print(n, "files", total/1e6, "MB")
EOF
