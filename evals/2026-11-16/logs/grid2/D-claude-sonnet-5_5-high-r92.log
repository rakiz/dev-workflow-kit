        b=os.read(sfd,1<<20)
        if not b: break
        h.update(b); os.write(dfd,b)
    os.fsync(dfd); os.utime(dfd,ns=(st.st_atime_ns,st.st_mtime_ns)); os.fchmod(dfd,0o444); os.close(dfd); os.close(sfd)
for w in (1,4,8):
    shutil.rmtree("cp8", ignore_errors=True)
    for d in dirs: os.makedirs(os.path.join("cp8",d), exist_ok=True)
    t=time.time()
    if w==1:
        for r in paths: copy(r)
    else:
        with ThreadPoolExecutor(w) as ex: list(ex.map(copy, paths))
    print("copy workers=%d: %.2fs" % (w, time.time()-t))
