import os, time, shutil
def free(): s=os.statvfs("."); return s.f_bavail*s.f_frsize
paths=[]
for dp,dn,fn in os.walk("full"):
    rel=os.path.relpath(dp,"full")
    for f in fn: paths.append(os.path.join(rel,f))
dirs = sorted({os.path.dirname(p) for p in paths})
shutil.rmtree("lkA", ignore_errors=True); shutil.rmtree("lkB", ignore_errors=True); os.sync(); time.sleep(2)
for name in ("lkA","lkB"):
    f0=free()
    for d in dirs: os.makedirs(os.path.join(name,d), exist_ok=True)
    for r in paths: os.link(os.path.join("full",r), os.path.join(name,r))
    os.sync(); time.sleep(3); f1=free()
    print(name, "free delta bytes:", f0-f1, "per file:", (f0-f1)/len(paths))
