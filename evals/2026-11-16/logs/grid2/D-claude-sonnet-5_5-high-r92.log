import os, time, shutil, subprocess
from concurrent.futures import ThreadPoolExecutor
paths=[]
for dp,dn,fn in os.walk("full"):
    rel=os.path.relpath(dp,"full")
    for f in fn: paths.append(os.path.join(rel,f))
dirs = sorted({os.path.dirname(p) for p in paths})
for w in (1,4,8):
    shutil.rmtree("lk", ignore_errors=True)
    for d in dirs: os.makedirs(os.path.join("lk",d), exist_ok=True)
    t=time.time()
    if w==1:
        for r in paths: os.link(os.path.join("full",r), os.path.join("lk",r))
    else:
        with ThreadPoolExecutor(w) as ex: list(ex.map(lambda r: os.link(os.path.join("full",r), os.path.join("lk",r)), paths))
    print("link workers=%d: %.2fs" % (w, time.time()-t))
