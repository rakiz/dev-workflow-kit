+class BooleanTransformTests(unittest.TestCase):
+    def test_boolean_affirmative_forms(self):
+        for raw in ("yes", "YES", "Yes", "true", "TRUE", "True"):
+            self.assertEqual(transforms.apply("boolean", raw), 1.0)
+
+    def test_boolean_negative_forms(self):
+        for raw in ("no", "NO", "No", "false", "FALSE", "False"):
+            self.assertEqual(transforms.apply("boolean", raw), 0.0)
+
+    def test_boolean_rejects_other_input(self):
+        for raw in ("maybe", "1", "0", "y", "n", ""):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", raw)
+
+    def test_boolean_column_end_to_end(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-bool-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        inp = os.path.join(tmp, "in")
+        os.makedirs(inp)
+        with open(os.path.join(inp, "flags.csv"), "w") as fh:
+            fh.write("id,flag\n1,YES\n2,No\n3,TRUE\n4,false\n")
+        rules_path = os.path.join(tmp, "rules.toml")
+        with open(rules_path, "w") as fh:
+            fh.write('[transforms]\nflag = "boolean"\n')
+        out = os.path.join(tmp, "out")
+        report = reportgen.run(rules_path, inp, out,
+                               os.path.join(tmp, "cache", "state.json"))
+        col = report["files"]["flags.csv"]["summary"]["columns"]["flag"]
+        self.assertEqual(col["distinct"], 2)
+        self.assertEqual(col["numeric_sum"], 2.0)
+        self.assertEqual(col["sample"], [0.0, 1.0])
+
+
+class FutureSchemaCacheTests(unittest.TestCase):
+    """GOAL item 2: a cache/state.json written by a future schema version
+    must not crash the run — treat it as empty, do the full run, rewrite a
+    valid state file."""
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-future-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+
+    def test_future_version_entries_do_not_crash_run(self):
+        os.makedirs(os.path.dirname(self.cache_path))
+        digest = cache.file_digest(
+            os.path.join(INPUT_DIR, "small_transactions.csv"))
+        future_state = {
+            "small_transactions.csv": {
+                "digest": digest, "rows": 999999, "generated_from": 99,
+                "rules_fp": "ffffffffffffffff",
+                "registry_version": str(int(cache.REGISTRY_VERSION) + 1),
+                "summary": {"columns": {}, "skipped_rows": []}},
+            "some_removed_input.csv": {
+                "registry_version": str(int(cache.REGISTRY_VERSION) + 1)},
+        }
+        with open(self.cache_path, "w") as fh:
+            json.dump(future_state, fh)
+        report = reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+        # Full run: recomputed values, not the future entry's stale ones.
+        self.assertEqual(report["total_rows"], 12012)
+        self.assertEqual(
+            report["files"]["small_transactions.csv"]["rows"], 4)
+        # A valid state file rewritten under the current version.
+        state = cache.load_state(self.cache_path)
+        self.assertEqual(set(state), {
+            "big_transactions.csv", "small_devices.csv",
+            "small_employees.csv", "small_transactions.csv"})
+        for entry in state.values():
+            self.assertEqual(entry["registry_version"], cache.REGISTRY_VERSION)
+        with open(self.cache_path) as fh:
+            raw = json.load(fh)
+        self.assertNotIn("some_removed_input.csv", raw)
+
+    def test_future_nested_schema_treated_as_empty(self):
+        os.makedirs(os.path.dirname(self.cache_path))
+        with open(self.cache_path, "w") as fh:
+            json.dump({"schema_version": int(cache.REGISTRY_VERSION) + 1,
+                       "files": {"a.csv": {"rows": 1}}}, fh)
+        report = reportgen.run(RULES, INPUT_DIR, self.out, self.cache_path)
+        self.assertEqual(report["total_rows"], 12012)
+        state = cache.load_state(self.cache_path)
+        self.assertEqual(set(state), {
+            "big_transactions.csv", "small_devices.csv",
+            "small_employees.csv", "small_transactions.csv"})
+
+
+class HtmlEscapingRegressionTests(unittest.TestCase):
+    """Regression: render_html interpolated raw values, so cell content
+    with markup leaked into report.html (test_legacy_report failure)."""
+
+    def test_sample_and_column_markup_is_escaped(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-esc-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        inp = os.path.join(tmp, "in")
+        os.makedirs(inp)
+        with open(os.path.join(inp, "labels.csv"), "w") as fh:
+            fh.write("item,label\ni1,red <b> & bold\n")
+        out = os.path.join(tmp, "out")
+        reportgen.run(RULES, inp, out, os.path.join(tmp, "cache", "state.json"))
+        with open(os.path.join(out, "report.html")) as fh:
+            html_text = fh.read()
+        self.assertNotIn("<b>", html_text)
+        self.assertIn("red &lt;b&gt; &amp; bold", html_text)
+
+
+class FailedRunLeavesNoArtifactsTests(unittest.TestCase):
+    """Regression: report.html was written before validate_summary ran and
+    cache.save_state was called inside the per-file loop, so a run with a
+    failed transform still emitted a report and left cache entries derived
+    from the incomplete transform pass."""
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-fail-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.inp = os.path.join(self.tmp, "in")
+        os.makedirs(self.inp)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+        self.rules_path = os.path.join(self.tmp, "rules.toml")
+        with open(self.rules_path, "w") as fh:
+            fh.write('[transforms]\nitem = "round2"\n')
+
+    def test_failed_run_emits_no_report(self):
+        with open(os.path.join(self.inp, "a.csv"), "w") as fh:
+            fh.write("item\noops\n")
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+        self.assertFalse(os.path.exists(os.path.join(self.out, "report.html")))
+        self.assertFalse(os.path.exists(os.path.join(self.out, "report.json")))
+
+    def test_failed_run_leaves_no_cache_state(self):
+        # a.csv transforms cleanly; b.csv fails — the incrementally saved
+        # entry for a.csv must not survive the failed run either.
+        with open(os.path.join(self.inp, "a.csv"), "w") as fh:
+            fh.write("item\n1\n")
+        with open(os.path.join(self.inp, "b.csv"), "w") as fh:
+            fh.write("item\noops\n")
+        with self.assertRaises(reportgen.ValidationError):
+            reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)
+        self.assertFalse(os.path.exists(self.cache_path))
+
+
+class GeneratedFromConsistencyRegressionTests(unittest.TestCase):
+    """Regression: cache.make_entry counted rules-mapped header columns
+    while reportgen.generated_from counted only those with a non-empty
+    cell, so generated_from changed between a fresh run and a cache hit
+    (visible on small_devices.csv, whose `status` column is always empty).
+    """
+
+    def test_generated_from_same_fresh_and_cached(self):
+        tmp = tempfile.mkdtemp(prefix="rg3-gen-")
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        out = os.path.join(tmp, "out")
+        cache_path = os.path.join(tmp, "cache", "state.json")
+        fresh = reportgen.run(RULES, INPUT_DIR, out, cache_path)
+        cached = reportgen.run(RULES, INPUT_DIR, out, cache_path)
+        for name in fresh["files"]:
+            self.assertEqual(
+                fresh["files"][name]["generated_from"],
+                cached["files"][name]["generated_from"], name)
+        self.assertEqual(
+            fresh["files"]["small_devices.csv"]["generated_from"], 1)
+
+
