"""HTML output checks for the report rendering."""

import os
import shutil
import tempfile
import unittest

import reportgen


class HtmlOutputTest(unittest.TestCase):
    def test_sample_values_do_not_leak_markup(self):
        tmp = tempfile.mkdtemp(prefix="rg3-html-")
