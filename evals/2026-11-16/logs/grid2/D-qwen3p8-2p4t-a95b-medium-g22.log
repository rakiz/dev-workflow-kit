import os, sys, time, json, tempfile, shutil, resource
sys.path.insert(0, "/private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/bench-v3-56113")
import synccli

def mkfiles(root, n, size, fanout=50):
    for i in range(n):
        d = os.path.join(root, "d%03d" % (i % fanout))
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, "f%06d.bin" % i), "wb") as f:
            f.write(b"x" * size)

base = tempfile.mkdtemp()
try:
    # 1) scan/manifest rate: 10k files x 100B
    src = os.path.join(base, "src"); os.makedirs(src)
    N = 10000
    mkfiles(src, N, 100)
    t0 = time.perf_counter(); man = synccli.build_manifest(src); t1 = time.perf_counter()
    scan_rate = N / (t1 - t0)
    # run twice (warm cache)
    t0 = time.perf_counter(); man = synccli.build_manifest(src); t1 = time.perf_counter()
    scan_rate_warm = N / (t1 - t0)

    # memory per manifest entry (RSS delta over 10k entries)
    rss0 = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
    big = {}
    for i in range(N):
        big["d%03d/f%06d.bin" % (i % 50, i)] = {"size": 100, "mtime": 1763333333.123456}
    rss1 = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss
    bytes_per_entry = (rss1 - rss0) * 1024 / N  # ru_maxrss is bytes on macOS

    # 2) copy_file small-file overhead: copy the 10k x 100B tree (1 MB total)
    dst = os.path.join(base, "dst"); os.makedirs(dst)
    t0 = time.perf_counter()
    for rel in man:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
    t1 = time.perf_counter()
    small_copy_rate = N / (t1 - t0)
    small_copy_per_file = (t1 - t0) / N

    # 3) big-file bandwidth: 4 x 128 MB
    bigsrc = os.path.join(base, "big.bin")
    with open(bigsrc, "wb") as f:
        f.write(b"y" * (128 * 1024 * 1024))
    t0 = time.perf_counter()
    for i in range(4):
        synccli.copy_file(bigsrc, os.path.join(base, "bigcopy%d.bin" % i))
    t1 = time.perf_counter()
    bw = 4 * 128 / (t1 - t0)  # MB/s
    # repeat read to see cache effect
    t0 = time.perf_counter()
    synccli.copy_file(bigsrc, os.path.join(base, "bigcopy_warm.bin"))
    t1 = time.perf_counter()
    bw_warm = 128 / (t1 - t0)

    # 4) hardlink rate: 10k links
    linkdst = os.path.join(base, "links"); os.makedirs(linkdst)
    t0 = time.perf_counter()
    for rel in man:
        d = os.path.join(linkdst, os.path.dirname(rel))
        os.makedirs(d, exist_ok=True)
        os.link(os.path.join(src, rel), os.path.join(linkdst, rel))
    t1 = time.perf_counter()
    link_rate = N / (t1 - t0)
    # incl. makedirs overhead already; also pure os.link on flat dir
    flat = os.path.join(base, "flat"); os.makedirs(flat)
    t0 = time.perf_counter()
    for i in range(N):
        os.link(os.path.join(src, "d000", "f%06d.bin" % i) if i < 50 else bigsrc, os.path.join(flat, "l%06d" % i))
    t1 = time.perf_counter()
    link_rate_flat = N / (t1 - t0)

    # 5) json index write size for 30k entries
    idx = {("d%03d/f%06d.bin" % (i % 50, i)): {"size": 1234, "mtime": 1763333333.123456} for i in range(30000)}
    s = json.dumps(idx, indent=2)
    idx_bytes_30k = len(s)

    print(json.dumps({
        "scan_files_per_s_cold": round(scan_rate),
        "scan_files_per_s_warm": round(scan_rate_warm),
        "manifest_bytes_per_entry_rss": round(bytes_per_entry),
        "copy_small_files_per_s": round(small_copy_rate),
        "copy_small_s_per_file_us": round(small_copy_per_file * 1e6, 1),
        "copy_bigfile_MBps_cold": round(bw),
        "copy_bigfile_MBps_warm": round(bw_warm),
        "hardlink_files_per_s_with_makedirs": round(link_rate),
        "hardlink_files_per_s_flat": round(link_rate_flat),
        "index_json_bytes_30k_entries_indent2": idx_bytes_30k,
    }, indent=2))
finally:
    shutil.rmtree(base, ignore_errors=True)
