import os, sys, time, tempfile, shutil
base = tempfile.mkdtemp()
try:
    # manifest memory: precise container-size accounting for 30k entries
    def deep(o, seen=None):
        if seen is None: seen = set()
        i = id(o)
        if i in seen: return 0
        seen.add(i)
        s = sys.getsizeof(o)
        if isinstance(o, dict):
            s += sum(deep(k, seen) + deep(v, seen) for k, v in o.items())
        return s
    idx = {("d%03d/f%06d.bin" % (i % 50, i)): {"size": 1234, "mtime": 1763333333.123456} for i in range(30000)}
    per_entry = deep(idx) / 30000
    # pure os.link rate, dirs pre-created, 10k links into fresh dirs of <=50 entries
    src = os.path.join(base, "src"); os.makedirs(src)
    for i in range(100):
        with open(os.path.join(src, "f%04d" % i), "wb") as f: f.write(b"x"*100)
    dst = os.path.join(base, "dst")
    for i in range(200): os.makedirs(os.path.join(dst, "d%03d" % i))
    t0 = time.perf_counter()
    for i in range(10000):
        os.link(os.path.join(src, "f%04d" % (i % 100)), os.path.join(dst, "d%03d" % (i // 50), "l%05d" % i))
    t1 = time.perf_counter()
    print({"manifest_bytes_per_entry_deep": round(per_entry, 1),
           "hardlink_files_per_s_precreated_dirs": round(10000/(t1-t0))})
finally:
    shutil.rmtree(base, ignore_errors=True)
