+BOOLEAN_TRUE = ("yes", "true")
+BOOLEAN_FALSE = ("no", "false")
+
+
+def boolean(value):
+    """'yes'/'true' -> 1.0, 'no'/'false' -> 0.0 (case-insensitive).
+    Anything else is not a boolean value."""
+    token = value.strip().lower()
+    if token in BOOLEAN_TRUE:
+        return 1.0
+    if token in BOOLEAN_FALSE:
+        return 0.0
+    raise TransformError("not a boolean: %r" % value)
+
+
