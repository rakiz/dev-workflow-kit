import json, os, shutil, tempfile, time
import synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst1 = os.path.join(tmp, "dst1")
    dst2 = os.path.join(tmp, "dst2")
    os.makedirs(src)
    payload = b"x" * 51200  # 50 KiB -> 20,000 files = 1,000 MiB (~1 GB)
    n_files = 2000          # 1/10th scale (100 MiB across 2,000 files in 40 subdirs)
    for d in range(40):
        sub = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(sub)
        for f in range(n_files // 40):
            with open(os.path.join(sub, f"file_{f:04d}.bin"), "wb") as fp:
                fp.write(payload)

    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0

    t0 = time.perf_counter()
    for rel in manifest:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst1, rel))
    t_copy = time.perf_counter() - t0

    t0 = time.perf_counter()
    for rel in manifest:
        dpath = os.path.join(dst2, rel)
        os.makedirs(os.path.dirname(dpath), exist_ok=True)
        os.link(os.path.join(dst1, rel), dpath)
    t_link = time.perf_counter() - t0

    t0 = time.perf_counter()
    raw = json.dumps(manifest, indent=2)
    t_json_dump = time.perf_counter() - t0
    t0 = time.perf_counter()
    _ = json.loads(raw)
    t_json_load = time.perf_counter() - t0

    print(f"n_files={n_files}, total_bytes={n_files*len(payload)}")
    print(f"build_manifest: {t_manifest:.4f}s ({t_manifest/n_files*1e6:.1f} us/file)")
    print(f"copy_file:      {t_copy:.4f}s ({t_copy/n_files*1e6:.1f} us/file, {(n_files*len(payload)/1e6)/t_copy:.1f} MB/s)")
    print(f"os.link:        {t_link:.4f}s ({t_link/n_files*1e6:.1f} us/file)")
    print(f"json dump/load: dump={t_json_dump:.4f}s, load={t_json_load:.4f}s, bytes={len(raw)} ({len(raw)/n_files:.1f} B/file)")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
