import json, os, shutil, tempfile, time
import synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    payload = b"a" * 20480  # 20 KiB -> 50,000 files = 1,000 MiB (~1 GB)
    n_files = 5000          # 1/10th scale (100 MiB across 5,000 files in 50 subdirs)
    for d in range(50):
        sub = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(sub)
        for f in range(n_files // 50):
            with open(os.path.join(sub, f"file_{f:04d}.bin"), "wb") as fp:
                fp.write(payload)

    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0

    t0 = time.perf_counter()
    created_dirs = set()
    for rel, st in manifest.items():
        s_path = os.path.join(src, rel)
        d_path = os.path.join(dst, rel)
        parent = os.path.dirname(d_path)
        if parent not in created_dirs:
            os.makedirs(parent, exist_ok=True)
            created_dirs.add(parent)
        with open(s_path, "rb") as fsrc, open(d_path, "wb") as fdst:
            shutil.copyfileobj(fsrc, fdst, length=262144)
        os.utime(d_path, (st["mtime"], st["mtime"]))
    t_copy = time.perf_counter() - t0

    print(f"5000 files x 20KiB (100 MiB): build_manifest={t_manifest:.4f}s ({t_manifest/n_files*1e6:.1f} us/file), copy+utime={t_copy:.4f}s ({t_copy/n_files*1e6:.1f} us/file)")
finally:
    shutil.rmtree(tmp, ignore_errors=True)
