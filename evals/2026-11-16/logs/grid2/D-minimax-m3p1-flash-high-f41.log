import os, time, tempfile, shutil, sys
sys.path.insert(0,'.')
import synccli
base = os.path.join(tempfile.gettempdir(),'bench_backup_measure')
src = os.path.join(base,'src')

# fresh dirs
for name in ('A','B','C'):
    p = os.path.join(base,name); shutil.rmtree(p, ignore_errors=True); os.makedirs(p)

paths = synccli.scan_files(src)

def link_all(dst):
    t0=time.time()
    for rel in paths:
        d=os.path.join(dst,rel); os.makedirs(os.path.dirname(d), exist_ok=True); os.link(os.path.join(src,rel), d)
    return time.time()-t0

def copy_stream(dst, chunk=64*1024):
    t0=time.time()
    for rel in paths:
        s=os.path.join(src,rel); d=os.path.join(dst,rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        with open(s,'rb') as fi, open(d,'wb') as fo:
            while True:
                b=fi.read(chunk)
                if not b: break
                fo.write(b)
    return time.time()-t0

print("link run1: %.3fs" % link_all(os.path.join(base,'A')))
print("link run2: %.3fs" % link_all(os.path.join(base,'B')))
print("copy stream run1: %.3fs" % copy_stream(os.path.join(base,'C')))
