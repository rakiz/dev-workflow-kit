for f in files:
    with open(os.path.join(src,f),'rb') as fi:
        while True:
            b=fi.read(65536)
            if not b: break
            n+=len(b)
t1=time.time()
print("read %d MB: %.3fs (%.0f MB/s)"%(n/1e6, t1-t0, n/1e6/(t1-t0)))
