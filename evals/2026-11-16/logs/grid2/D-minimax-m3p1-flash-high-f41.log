import os, sys, tempfile, shutil, json
sys.path.insert(0,'.')
import synccli, snaputil

# 1. dangling symlink breaks build_manifest (file_state uses os.stat)
t = tempfile.mkdtemp()
open(os.path.join(t,'a.txt'),'w').write('a')
os.symlink(os.path.join(t,'missing'), os.path.join(t,'dangling'))
try:
    m = synccli.build_manifest(t)
    print("1) build_manifest on dangling symlink: OK", m)
except OSError as e:
    print("1) build_manifest on dangling symlink raised:", type(e).__name__, e)

# 2. copy_file swallows errors -> file missing but manifest promises it
dst = tempfile.mkdtemp()
src = tempfile.mkdtemp()
p = os.path.join(src,'secret.txt'); open(p,'w').write('x')
os.chmod(p, 0o000)
try:
    synccli.copy_file(p, os.path.join(dst,'secret.txt'))
except OSError as e:
    print("2) copy_file raised (unexpected):", e)
print("2) dest exists after unreadable src:", os.path.exists(os.path.join(dst,'secret.txt')))
# and sync() writes the manifest regardless
open(os.path.join(dst,'.sync_manifest.json'),'w').write(json.dumps({"secret.txt":{"size":1,"mtime":0}}))
print("2) manifest still lists secret.txt:", "secret.txt" in json.load(open(os.path.join(dst,'.sync_manifest.json'))))

# 3. safe_snapshot_path escapes
root='/backup'; snap='snap-1'
print("3) safe_snapshot_path:", snaputil.safe_snapshot_path(root, snap, '../../etc/passwd'))

# 4. prune keep=0 deletes everything
br = tempfile.mkdtemp()
for n in ('snap-20260101-000000-01','snap-20260101-000100-01'):
    os.makedirs(os.path.join(br,n))
deleted = snaputil.prune_snapshots(br, 0)
print("4) prune(keep=0) deleted:", deleted, "remaining:", snaputil.list_snapshots(br))

# 5. list_snapshots ignores non-snap dirs
os.makedirs(os.path.join(br,'.staging','run1'))
print("5) list_snapshots sees staging?:", snaputil.list_snapshots(br))

# 6. memory per manifest entry
import tracemalloc
big = tempfile.mkdtemp()
for i in range(30000):
    with open(os.path.join(big,'f%05d'%i),'wb') as f: f.write(b'x')
tracemalloc.start()
mm = synccli.build_manifest(big)
cur, peak = tracemalloc.get_traced_memory(); tracemalloc.stop()
print("6) manifest dict peak=%.1f MB cur=%.1f MB for %d entries -> %.0f B/entry"%(peak/1e6, cur/1e6, len(mm), cur/len(mm)))
s = json.dumps(mm, separators=(',',':'))
print("6) compact json bytes/entry = %.1f"%(len(s)/len(mm)))
