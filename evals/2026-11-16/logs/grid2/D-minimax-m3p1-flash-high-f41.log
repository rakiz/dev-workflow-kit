paths = synccli.scan_files(src)
newstates={}
for rel in paths:
    st=os.lstat(os.path.join(src,rel)); newstates[rel]={"size":st.st_size,"mtime":st.st_mtime}
t_scanstat=time.time()-t0
t1=time.time(); made=set(); linked=0; copied=0
for rel in paths:
    d=os.path.join(d2,rel); dd=os.path.dirname(d)
    if dd not in made: os.makedirs(dd,exist_ok=True); made.add(dd)
    if rel in changed:
        copy_stream(os.path.join(src,rel), d); copied+=1
    else:
        os.link(os.path.join(d1,rel), d); linked+=1
t_copy=time.time()-t1
print("INCR  scan+stat=%.3fs link+copy=%.3fs (linked=%d copied=%d) total=%.3fs"%(t_scanstat,t_copy,linked,copied,t_scanstat+t_copy))
