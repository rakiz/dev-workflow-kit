import os, time, tempfile, shutil, sys, json
sys.path.insert(0,'.')
import synccli
base = os.path.join(tempfile.gettempdir(),'bench_backup_measure')
src = os.path.join(base,'src')

def copy_stream(srcp, dstp, chunk=65536):
    made=set()
    with open(srcp,'rb') as fi, open(dstp,'wb') as fo:
        while True:
            b=fi.read(chunk)
            if not b: break
            fo.write(b)

def full_run(dest):
    t0=time.time()
    paths = synccli.scan_files(src)
    states={}
    for rel in paths:
        st=os.lstat(os.path.join(src,rel)); states[rel]={"size":st.st_size,"mtime":st.st_mtime}
    t_scanstat=time.time()-t0
    made=set()
    t1=time.time()
    for rel in paths:
        d=os.path.join(dest,rel); dd=os.path.dirname(d)
        if dd not in made: os.makedirs(dd, exist_ok=True); made.add(dd)
        copy_stream(os.path.join(src,rel), d)
    t_copy=time.time()-t1
    t2=time.time()
    with open(os.path.join(dest,'.index.json'),'w') as f: json.dump(states,f)
    t_idx=time.time()-t2
    return t_scanstat,t_copy,t_idx,len(paths),states

d1=os.path.join(base,'run_full'); shutil.rmtree(d1,ignore_errors=True); os.makedirs(d1)
a,b,c,n,states = full_run(d1)
print("FULL  scan+stat=%.3fs copy=%.3fs index=%.3fs total=%.3fs files=%d"%(a,b,c,a+b+c,n))

# incremental: 300 changed, rest hardlinked from previous snapshot
d2=os.path.join(base,'run_incr'); shutil.rmtree(d2,ignore_errors=True); os.makedirs(d2)
