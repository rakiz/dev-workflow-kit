import os, time, tempfile, shutil
from concurrent.futures import ThreadPoolExecutor
b = tempfile.mkdtemp(dir="/tmp")
N=30000
src=os.path.join(b,"s"); os.makedirs(src)
for i in range(200): os.makedirs(os.path.join(src,f"d{i}"))
for i in range(N): open(os.path.join(src,f"d{i%200}",f"f{i}"),"wb").write(b"x"*35000)
def run(workers, tag):
    dst=os.path.join(b,tag)
    for i in range(200): os.makedirs(os.path.join(dst,f"d{i}"))
    def one(i): os.link(os.path.join(src,f"d{i%200}",f"f{i}"), os.path.join(dst,f"d{i%200}",f"f{i}"))
    s=time.perf_counter()
    if workers==1:
        for i in range(N): one(i)
    else:
        # group by directory to avoid same-dir contention
        def per_dir(d):
            for i in range(d,N,200): one(i)
        with ThreadPoolExecutor(workers) as ex: list(ex.map(per_dir, range(200)))
    d=time.perf_counter()-s; print(f"link workers={workers}: {d:.2f}s ({d/N*1e6:.0f} us/file eff.)")
for w in (1,4,8,16): run(w, f"w{w}")
shutil.rmtree(b)
