"""bench_d1: measurements behind DESIGN-d1.md section 'Performance budget'.

Usage: python3 bench_d1.py [workdir]   (needs ~2.2 GiB free; workdir is removed)
Builds a 1 GiB / 30,000-file tree and times each stage of the planned
backupctl pipeline, plus the existing synccli stages for comparison.
"""
import hashlib, json, os, random, shutil, sys, tempfile, time, resource
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import synccli

N_FILES, TOTAL = 30_000, 1 << 30
CHUNK = 1 << 20

def t(label, fn):
    s = time.perf_counter(); r = fn(); d = time.perf_counter() - s
    print(f"{label:<52}{d:8.2f} s"); return r, d

def make_tree(root):
    rnd = random.Random(1)
    w = [rnd.lognormvariate(0, 1.6) for _ in range(N_FILES)]
    k = TOTAL / sum(w)
    sizes = [max(1, int(x * k)) for x in w]
    blob = os.urandom(1 << 20)
    for i, sz in enumerate(sizes):
        d = os.path.join(root, f"d{i % 200:03d}", f"e{(i // 200) % 10}")
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, f"f{i}.dat"), "wb") as f:
            off = (i * 4099) % (len(blob) - 1)
            left = sz
            while left:
                n = min(left, len(blob) - off); f.write(blob[off:off + n]); left -= n; off = 0
    return sizes

def chunked_copy_sha(src, dst, do_fsync):
    h = hashlib.sha256()
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    with open(src, "rb") as a, open(dst, "wb") as b:
        while True:
            buf = a.read(CHUNK)
            if not buf: break
            h.update(buf); b.write(buf)
        if do_fsync:
            b.flush(); os.fsync(b.fileno())
    return h.hexdigest()

def main():
    base = tempfile.mkdtemp(prefix="d1bench-", dir=sys.argv[1] if len(sys.argv) > 1 else None)
    try:
        src = os.path.join(base, "src"); os.makedirs(src)
        sizes, _ = t("build 1 GiB / 30k-file source tree", lambda: make_tree(src))
        print(f"files={len(sizes)} bytes={sum(sizes)} max={max(sizes)} median={sorted(sizes)[len(sizes)//2]}")

        rels, _ = t("synccli.scan_files (os.walk + sort)", lambda: synccli.scan_files(src))
        man, _ = t("synccli.build_manifest (scan + os.stat each)", lambda: synccli.build_manifest(src))
        _, _ = t("synccli.changed_files, empty old manifest", lambda: synccli.changed_files({}, man))
        _, _ = t("synccli.changed_files, identical old manifest", lambda: synccli.changed_files(man, man))
        mj, _ = t("json.dumps(manifest, indent=2)", lambda: json.dumps(man, indent=2))
        print(f"manifest json bytes (indent=2, 2 keys/entry): {len(mj)}  per-entry: {len(mj)/len(man):.0f}")

        # existing synccli end to end, same tree
        dst0 = os.path.join(base, "sync_dst"); os.makedirs(dst0)
        t("synccli.sync initial (copy_file: whole-file read)", lambda: synccli.sync(src, dst0))
        t("synccli.sync second run (no-op)", lambda: synccli.sync(src, dst0))
        shutil.rmtree(dst0)

        for fs in (False, True):
            dst = os.path.join(base, f"snap_fsync{int(fs)}", "data"); os.makedirs(dst)
            def run():
                out = {}
                for rel in rels:
                    out[rel] = chunked_copy_sha(os.path.join(src, rel), os.path.join(dst, rel), fs)
                return out
            t(f"chunked copy + sha256, fsync per file={fs}", run)
            if not fs: first = dst
            else: shutil.rmtree(os.path.dirname(dst))

        # stages on the first copy
        def lstat_all(root):
            for rel in rels: os.lstat(os.path.join(root, rel))
        t("lstat every source file (state capture, 2nd pass)", lambda: lstat_all(src))
        snap2 = os.path.join(base, "snap2", "data"); os.makedirs(snap2)
        def link_all():
            made = set()
            for rel in rels:
                d = os.path.dirname(rel)
                if d not in made:
                    os.makedirs(os.path.join(snap2, d), exist_ok=True); made.add(d)
                os.link(os.path.join(first, rel), os.path.join(snap2, rel))
        t("unchanged run: mkdir + os.link every file", link_all)
        t("verify pass: os.walk + lstat of staged tree", lambda: [os.lstat(os.path.join(snap2, r)) for r in synccli.scan_files(snap2)])
        t("rmtree of linked snapshot (prune cost)", lambda: shutil.rmtree(os.path.join(base, "snap2")))
        def sha_only():
            for rel in rels:
                h = hashlib.sha256()
                with open(os.path.join(src, rel), "rb") as f:
                    while True:
                        b = f.read(CHUNK)
                        if not b: break
                        h.update(b)
        t("read + sha256 only (source, warm cache)", sha_only)
        import filecmp
        t("filecmp.cmp(shallow=False) src vs copy, all files", lambda: [filecmp.cmp(os.path.join(src, r), os.path.join(first, r), shallow=False) for r in rels])
        print("peak RSS MiB (ru_maxrss/1MiB on darwin):", resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / (1 << 20))
    finally:
        shutil.rmtree(base, ignore_errors=True)

main()
