import os, tempfile, time, json, shutil, random

# --- Measure baseline: scan + manifest + copy throughput on this machine ---
# Create a synthetic tree: ~10k files totalling ~100 MB, then extrapolate to 1GB/30k files
# Also microbench scan_files, file_state, copy_file

import synccli, snaputil

# 1. Microbench: per-file overhead of build_manifest (scan + stat)
tmp = tempfile.mkdtemp()
N = 5000
for i in range(N):
    sub = os.path.join(tmp, f"d{i%50}")
    os.makedirs(sub, exist_ok=True)
    # small files ~2KB average
    with open(os.path.join(sub, f"f{i}.bin"), "wb") as f:
        f.write(os.urandom(2048))

t0 = time.perf_counter()
manifest = synccli.build_manifest(tmp)
t1 = time.perf_counter()
elapsed = t1 - t0
print(f"build_manifest for {N} files (~{N*2048/1e6:.1f} MB): {elapsed:.3f}s")
print(f"  per-file: {elapsed/N*1e6:.0f} us")
print(f"  files/sec: {N/elapsed:.0f}")
print(f"  manifest entries: {len(manifest)}")

# 2. Copy throughput: copy_file loop for same tree
dst = tempfile.mkdtemp()
t0 = time.perf_counter()
for rel in manifest:
    synccli.copy_file(os.path.join(tmp, rel), os.path.join(dst, rel))
t1 = time.perf_counter()
elapsed2 = t1 - t0
total_bytes = N * 2048
print(f"copy_file loop for {N} files ({total_bytes/1e6:.1f} MB): {elapsed2:.3f}s")
print(f"  throughput: {total_bytes/elapsed2/1e6:.1f} MB/s")
print(f"  per-file copy overhead: {elapsed2/N*1e6:.0f} us (incl. open/makedirs)")

# 3. Full sync() first run (build + copy + manifest write)
dst2 = tempfile.mkdtemp()
t0 = time.perf_counter()
copied = synccli.sync(tmp, dst2)
t1 = time.perf_counter()
print(f"sync() first full backup: {t1-t0:.3f}s, copied {len(copied)} files")

# 4. Second sync (no changes) — should be scan+compare only
t0 = time.perf_counter()
copied2 = synccli.sync(tmp, dst2)
t1 = time.perf_counter()
print(f"sync() second (noop) : {t1-t0:.3f}s, copied {len(copied2)} files")

# 5. Extrapolate to 1GB / 30k files
# Assume ~34KB avg file size for 1GB/30k
# Per-file overhead dominates for small files; for larger files throughput dominates
proj_files = 30000
proj_bytes = 1 * 1024**3
per_file_scan_us = elapsed / N * 1e6
per_file_copy_us = elapsed2 / N * 1e6  # for 2KB files; larger files scale with bytes
# For throughput estimate, use measured MB/s
print(f"\n--- Extrapolation to 30k files / 1 GB ---")
print(f"  scan+stat: {proj_files * per_file_scan_us / 1e6:.1f}s")
# copy: per-file overhead + byte throughput
copy_time = proj_files * (per_file_copy_us/1e6) * 0.3  # adjust: larger files amortize open overhead
# Actually model copy as: per-file open overhead (~200us) + bytes/throughput
# Use measured throughput for bytes portion
mbps = total_bytes / elapsed2 / 1e6
print(f"  measured copy throughput: {mbps:.1f} MB/s")
print(f"  1GB at {mbps:.0f} MB/s = {1024/mbps:.1f}s byte copy")
print(f"  + per-file open overhead: {proj_files * 0.0003:.1f}s (at ~300us/file)")

# Cleanup
shutil.rmtree(tmp); shutil.rmtree(dst); shutil.rmtree(dst2)

# 6. Validate snaputil helpers
tmp2 = tempfile.mkdtemp()
for name in ["snap-20260101-120000-01", "snap-20260102-120000-02", "notasnap", "snap-20260103-120000-03"]:
    os.makedirs(os.path.join(tmp2, name))
    with open(os.path.join(tmp2, name, "f.txt"), "w") as f:
        f.write("x"*1000)
print(f"\nsnaputil.list_snapshots: {snaputil.list_snapshots(tmp2)}")
print(f"snaputil.snapshot_disk_usage: {snaputil.snapshot_disk_usage(tmp2, 'snap-20260101-120000-01')}")
print(f"snaputil.safe_snapshot_path traversal test: {snaputil.safe_snapshot_path(tmp2, 'snap-20260101-120000-01', '../../etc/passwd')}")
print(f"snaputil.prune_snapshots keep=2: {snaputil.prune_snapshots(tmp2, keep=2)}")
print(f"  remaining: {snaputil.list_snapshots(tmp2)}")
shutil.rmtree(tmp2)
