import os, time, json, tempfile, synccli

with tempfile.TemporaryDirectory() as tmp:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    os.makedirs(dst)

    n_files = 20000
    file_size = 51200  # 20,000 * 51,200 = 1,024,000,000 bytes (~1.00 GiB)
    payload = b"x" * file_size
    for d in range(100):
        os.makedirs(os.path.join(src, f"dir_{d:03d}"), exist_ok=True)
    for i in range(n_files):
        with open(os.path.join(src, f"dir_{i%100:03d}", f"result_{i:05d}.bin"), "wb") as f:
            f.write(payload)

    t0 = time.perf_counter()
    scanned = synccli.scan_files(src)
    t_scan = time.perf_counter() - t0

    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0

    t0 = time.perf_counter()
    to_copy = synccli.changed_files({}, manifest)
    t_diff = time.perf_counter() - t0

    t0 = time.perf_counter()
    for rel in to_copy:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
    t_copy = time.perf_counter() - t0

    dst_manifest_path = os.path.join(dst, synccli.MANIFEST_NAME)
    t0 = time.perf_counter()
    with open(dst_manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, indent=2)
        f.flush()
        os.fsync(f.fileno())
    t_json = time.perf_counter() - t0

    total = t_manifest + t_diff + t_copy + t_json
    print(f"20,000 files (1.024 GB):")
    print(f"  scan_files alone:  {t_scan:.3f} s ({t_scan/n_files*1e6:.1f} us/file)")
    print(f"  build_manifest:    {t_manifest:.3f} s ({t_manifest/n_files*1e6:.1f} us/file)")
    print(f"  changed_files:     {t_diff:.3f} s ({t_diff/n_files*1e6:.1f} us/file)")
    print(f"  copy_file loop:    {t_copy:.3f} s ({t_copy/n_files*1e6:.1f} us/file, {(n_files*file_size)/(1024**2)/t_copy:.1f} MiB/s)")
    print(f"  manifest dump+fsync: {t_json:.3f} s (size={os.path.getsize(dst_manifest_path)} B)")
    print(f"  TOTAL full backup: {total:.3f} s")
'
