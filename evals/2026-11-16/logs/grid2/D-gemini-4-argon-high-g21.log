import os, time, json, shutil, tempfile, synccli, snaputil

with tempfile.TemporaryDirectory() as tmp:
    src = os.path.join(tmp, "src")
    dst1 = os.path.join(tmp, "dst1")
    dst2 = os.path.join(tmp, "dst2")
    os.makedirs(src)
    os.makedirs(dst1)
    os.makedirs(dst2)

    # Create 2,000 files totaling 100 MB (50 KB each) across 50 subdirs (scales 10x to 20,000 files / 1 GB)
    n_files = 2000
    file_size = 51200 # 50 KiB -> 20,000 files = 1,024,000,000 bytes (~1 GiB)
    payload = b"x" * file_size
    t0 = time.perf_counter()
    for d in range(50):
        subdir = os.path.join(src, f"dir_{d:03d}")
        os.makedirs(subdir, exist_ok=True)
    for i in range(n_files):
        p = os.path.join(src, f"dir_{i%50:03d}", f"result_{i:05d}.bin")
        with open(p, "wb") as f:
            f.write(payload)
    t_create = time.perf_counter() - t0

    t0 = time.perf_counter()
    files = synccli.scan_files(src)
    t_scan = time.perf_counter() - t0

    t0 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t_manifest = time.perf_counter() - t0

    t0 = time.perf_counter()
    copied = synccli.sync(src, dst1)
    t_sync_full = time.perf_counter() - t0

    t0 = time.perf_counter()
    copied_noop = synccli.sync(src, dst1)
    t_sync_noop = time.perf_counter() - t0

    # Measure hardlink tree creation for 2,000 unchanged files
    t0 = time.perf_counter()
    for d in range(50):
        os.makedirs(os.path.join(dst2, f"dir_{d:03d}"), exist_ok=True)
    for rel in files:
        os.link(os.path.join(dst1, rel), os.path.join(dst2, rel))
    t_hardlink = time.perf_counter() - t0

    manifest_bytes = os.path.getsize(os.path.join(dst1, synccli.MANIFEST_NAME))
    print(f"n_files={n_files}, total_bytes={n_files*file_size}")
    print(f"scan_files: {t_scan*1000:.2f} ms ({t_scan/n_files*1e6:.2f} us/file)")
    print(f"build_manifest: {t_manifest*1000:.2f} ms ({t_manifest/n_files*1e6:.2f} us/file)")
    print(f"sync full (2000 files, 100MB): {t_sync_full:.3f} s ({t_sync_full*10:.2f} s scaled 10x to 20k files / 1GB)")
    print(f"sync noop (2000 files): {t_sync_noop*1000:.2f} ms ({t_sync_noop*10*1000:.2f} ms scaled 10x)")
    print(f"hardlink 2000 files: {t_hardlink*1000:.2f} ms ({t_hardlink*10:.3f} s scaled 10x)")
    print(f"manifest_bytes (2000 files): {manifest_bytes} bytes ({manifest_bytes/n_files:.1f} B/file)")
