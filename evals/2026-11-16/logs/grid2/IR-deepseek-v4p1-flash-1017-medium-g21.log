+def copy_many(pairs):
+    """Copy a batch of (src, dst) pairs; return the list of dst paths done."""
+    done = []
+    for src, dst in pairs:
+        try:
+            copy_file(src, dst)
+            done.append(dst)
+        except Exception:
+            continue
+    return done
