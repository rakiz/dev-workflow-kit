The existing code is much faster than `cp -R` here (about 13 s vs 30 s), but it does no hashing and no fsync. Next I'll measure what a crash-safe copy costs: streamed copy with SHA-256, the staged index, a no-change re-scan, and hard-link creation. Durability is run three ways (none, `fsync`, `F_FULLFSYNC`).
[0m$ [0mcd /var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1-scratch && cat > bench_candidate.py <<'EOF'
import fcntl, hashlib, json, os, shutil, sys, time
mode, runs, REPO = sys.argv[1], int(sys.argv[2]), sys.argv[3]
sys.path.insert(0, REPO)
import synccli
S = os.getcwd(); FIX = os.path.join(S, "fixture"); W = os.path.join(S, "work_" + mode)
CHUNK = 1 << 20
def rm(p): shutil.rmtree(p, ignore_errors=True)

def copy_one(src, dst, mode):
    h = hashlib.sha256()
    with open(src, "rb") as fi:
        st = os.fstat(fi.fileno())
        with open(dst, "xb") as fo:
            while True:
                buf = fi.read(CHUNK)
                if not buf:
                    break
                h.update(buf); fo.write(buf)
            fo.flush()
            if mode == "fsync":
                os.fsync(fo.fileno())
            elif mode == "fullfsync":
                fcntl.fcntl(fo.fileno(), fcntl.F_FULLFSYNC)
    os.chmod(dst, 0o444)
    return st, h.hexdigest()

def copy_tree(src_root, dst_root, mode):
    entries, dirs = {}, set()
    for rel in synccli.scan_files(src_root):
        src = os.path.join(src_root, rel); dst = os.path.join(dst_root, rel)
        d = os.path.dirname(dst)
        if d not in dirs:
            os.makedirs(d, exist_ok=True); dirs.add(d)
        st, digest = copy_one(src, dst, mode)
        entries[rel] = {"size": st.st_size, "mtime_ns": st.st_mtime_ns, "ctime_ns": st.st_ctime_ns,
                        "ino": st.st_ino, "dev": st.st_dev, "sha256": digest}
    return entries

def timed(label, fn, *a):
    t = time.perf_counter(); r = fn(*a); dt = time.perf_counter() - t
    print("%s %.2fs" % (label, dt), flush=True); return r

for i in range(runs):
    snap = os.path.join(W, "snap%d" % i); rm(snap)
    staged = snap + ".staging"
    entries = timed("C1 copy+sha256 mode=%s run%d" % (mode, i), copy_tree, FIX, staged, mode)
    idx = os.path.join(staged, ".backupctl-index.json")
    def write_index():
        with open(idx, "w") as f:
            json.dump(entries, f, separators=(",", ":"), sort_keys=True); f.flush(); os.fsync(f.fileno())
    timed("C2 index write+fsync run%d" % i, write_index)
    print("C2 index bytes=%d entries=%d" % (os.path.getsize(idx), len(entries)), flush=True)
    os.rename(staged, snap)
    if i == 0:
        linkdst = os.path.join(W, "linked"); rm(linkdst)
        def link_all():
            for rel in entries:
                d = os.path.join(linkdst, rel); os.makedirs(os.path.dirname(d), exist_ok=True)
                os.link(os.path.join(snap, rel), d)
        timed("C3 hardlink 30000 files", link_all)
        rm(linkdst)
        def incremental():
            with open(idx) as f:
                old = json.load(f)
            unchanged = 0
            for rel in synccli.scan_files(FIX):
                st = os.stat(os.path.join(FIX, rel))
                o = old.get(rel)
                if o and o["size"] == st.st_size and o["mtime_ns"] == st.st_mtime_ns and o["ctime_ns"] == st.st_ctime_ns and o["ino"] == st.st_ino and o["dev"] == st.st_dev:
                    unchanged += 1
            return unchanged
        n = timed("C4 no-change incremental scan (source=fixture)", incremental)
        print("C4 unchanged=%d" % n, flush=True)
