        state["armed"] = False
        orig_remove(fp)
    return orig(path, *a, **k)
orig_remove = os.remove
os.stat = racy
try:
    print("C8 usage:", snaputil.snapshot_disk_usage(r8, "snap-x"))
except Exception as e:
    print("C8 raised:", type(e).__name__, e)
finally:
    os.stat = orig
