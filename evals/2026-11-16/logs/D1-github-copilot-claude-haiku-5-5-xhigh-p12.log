The no-fsync copy-plus-hash runs about 13–14 s, about the same as `synccli.sync`, so SHA-256 and chunking add little. But 30k hard-links take about 11 s, which suggests the cost is per file rather than per byte. I'll separate the two terms with a micro-benchmark, including fsync and F_FULLFSYNC costs on a 1000-file sample.
[0m$ [0mcd /var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/d1-scratch && cat > micro.py <<'EOF'
import fcntl, hashlib, os, shutil, time
S = os.getcwd(); W = os.path.join(S, "micro")
shutil.rmtree(W, ignore_errors=True); os.makedirs(W)
def t(label, fn):
    s = time.perf_counter(); r = fn(); print("%-52s %.3fs" % (label, time.perf_counter() - s), flush=True); return r
# per-file creation cost, empty files, 30000
def create_empty(d, n):
    os.makedirs(d, exist_ok=True)
    for i in range(n):
        with open(os.path.join(d, "e%05d" % i), "xb"):
            pass
t("A 30000 empty file create (no data, no fsync)", lambda: create_empty(os.path.join(W, "empty"), 30000))
# per-file link cost, 30000 links of existing inodes
def links(src, dst, n):
    os.makedirs(dst, exist_ok=True)
    for i in range(n):
        os.link(os.path.join(src, "e%05d" % i), os.path.join(dst, "l%05d" % i))
t("B 30000 hardlinks (no data)", lambda: links(os.path.join(W, "empty"), os.path.join(W, "links"), 30000))
# per-byte cost: one 1 GiB file, 1 MiB writes, then sha256 of it
big = os.path.join(W, "big.bin"); buf = os.urandom(1 << 20)
def write_big():
    with open(big, "wb") as f:
        for _ in range(1024): f.write(buf)
t("C write 1 GiB single file (1 MiB writes, no fsync)", write_big)
def read_hash():
    h = hashlib.sha256()
    with open(big, "rb") as f:
        while True:
            b = f.read(1 << 20)
            if not b: break
            h.update(b)
    return h.hexdigest()
t("D read+sha256 1 GiB single file (warm)", read_hash)
# fsync cost per file, 1000 small files
def fsync_files(mode, n):
    d = os.path.join(W, "fs_" + mode); os.makedirs(d, exist_ok=True)
    for i in range(n):
        with open(os.path.join(d, "f%05d" % i), "xb") as f:
            f.write(b"x" * 4096); f.flush()
            if mode == "fsync": os.fsync(f.fileno())
            elif mode == "fullfsync": fcntl.fcntl(f.fileno(), fcntl.F_FULLFSYNC)
t("E 1000 files 4 KiB, no fsync", lambda: fsync_files("none", 1000))
t("F 1000 files 4 KiB, fsync(2) each", lambda: fsync_files("fsync", 1000))
t("G 1000 files 4 KiB, F_FULLFSYNC each", lambda: fsync_files("fullfsync", 1000))
# one dir fsync after batch (directory entries durability)
def dir_fsync():
    fd = os.open(os.path.join(W, "fs_none"), os.O_RDONLY); os.fsync(fd); os.close(fd)
t("H fsync of one directory", dir_fsync)
