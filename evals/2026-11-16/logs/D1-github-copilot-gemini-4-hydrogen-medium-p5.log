import os, tempfile, time, shutil, synccli

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    # Create 2000 small files across 20 subdirs (~10 MB total) to measure per-file stat/scan/copy overhead
    data_4k = b"x" * 4096
    for d in range(20):
        sd = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(sd)
        for f in range(100):
            with open(os.path.join(sd, f"file_{f:04d}.json"), "wb") as fp:
                fp.write(data_4k)

    t0 = time.perf_counter()
    m = synccli.build_manifest(src)
    t1 = time.perf_counter()

    # Copy 2000 files using synccli.copy_file
    t2 = time.perf_counter()
    for rel in m:
        synccli.copy_file(os.path.join(src, rel), os.path.join(dst, rel))
    t3 = time.perf_counter()

    # Also measure 100 MB sequential copy in 1 MB files using chunked copy vs synccli.copy_file
    big_src = os.path.join(tmp, "big_src")
    big_dst = os.path.join(tmp, "big_dst")
    os.makedirs(big_src)
    data_1m = b"y" * (1024 * 1024)
    for i in range(100):
        with open(os.path.join(big_src, f"big_{i:03d}.bin"), "wb") as fp:
            fp.write(data_1m)
    t4 = time.perf_counter()
    for i in range(100):
        synccli.copy_file(os.path.join(big_src, f"big_{i:03d}.bin"), os.path.join(big_dst, f"big_{i:03d}.bin"))
    t5 = time.perf_counter()

    print(f"build_manifest(2000 files): {t1-t0:.4f}s ({2000/(t1-t0):.0f} files/s)")
    print(f"copy_file(2000 x 4KB): {t3-t2:.4f}s ({2000/(t3-t2):.0f} files/s)")
    print(f"copy_file(100 x 1MB = 100MB): {t5-t4:.4f}s ({100/(t5-t4):.1f} MB/s)")
finally:
    shutil.rmtree(tmp)
'
