import os, tempfile, time, shutil, json

tmp = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(tmp, "src")
    dst = os.path.join(tmp, "dst")
    os.makedirs(src)
    os.makedirs(dst)
    for d in range(20):
        os.makedirs(os.path.join(src, f"d{d:02d}"))
        os.makedirs(os.path.join(dst, f"d{d:02d}"))
        for f in range(100):
            with open(os.path.join(src, f"d{d:02d}", f"f{f:04d}"), "wb") as fp:
                fp.write(b"a")
    t0 = time.perf_counter()
    for d in range(20):
        for f in range(100):
            os.link(os.path.join(src, f"d{d:02d}", f"f{f:04d}"), os.path.join(dst, f"d{d:02d}", f"f{f:04d}"))
    t1 = time.perf_counter()
    manifest = {f"d{d:02d}/f{f:04d}": {"size": 4096, "mtime_ns": 1731715200000000000} for d in range(200) for f in range(100)}
    t2 = time.perf_counter()
    raw = json.dumps(manifest)
    t3 = time.perf_counter()
    _ = json.loads(raw)
    t4 = time.perf_counter()
    print(f"os.link(2000 files): {t1-t0:.4f}s ({2000/(t1-t0):.0f} links/s)")
    print(f"json.dumps(20k entries): {t3-t2:.4f}s ({len(raw)/1e6:.2f} MB)")
    print(f"json.loads(20k entries): {t4-t3:.4f}s")
finally:
    shutil.rmtree(tmp)
'
