1	"""synccli: synchronize a source directory into a destination using a manifest."""
     2	import argparse
     3	import json
     4	import os
     5	import sys
     6	
     7	MANIFEST_NAME = ".sync_manifest.json"
     8	
     9	
    10	def scan_files(root):
    11	    """Return sorted list of relative file paths under root."""
    12	    result = []
    13	    for dirpath, dirnames, filenames in os.walk(root):
    14	        dirnames[:] = [d for d in dirnames if not d.startswith(".")]
    15	        for name in filenames:
    16	            full = os.path.join(dirpath, name)
    17	            rel = os.path.relpath(full, root)
    18	            result.append(rel)
    19	    return sorted(result)
    20	
    21	
    22	def file_state(path):
    23	    """Return (size, mtime) for a file."""
    24	    st = os.stat(path)
    25	    return {"size": st.st_size, "mtime": st.st_mtime}
    26	
    27	
    28	def build_manifest(root):
    29	    """Build a manifest {relpath: state} for all files under root."""
    30	    manifest = {}
    31	    for rel in scan_files(root):
    32	        manifest[rel] = file_state(os.path.join(root, rel))
    33	    return manifest
    34	
    35	
    36	def changed_files(old_manifest, new_manifest):
    37	    """Return files whose state changed or that are new in new_manifest."""
    38	    changed = []
    39	    for rel, state in new_manifest.items():
    40	        if rel not in old_manifest or old_manifest[rel] != state:
    41	            changed.append(rel)
    42	    return changed
    43	
    44	
    45	def collect_stale(items, seen=None):
    46	    """Collect stale entries: items not yet marked fresh.
    47	
    48	    Args:
    49	        items: iterable of (path, fresh) tuples.
    50	        seen: set of paths already marked fresh; defaults to a fresh set.
    51	    """
    52	    if seen is None:
    53	        seen = set()
    54	    stale = []
    55	    for i in range(len(items)):
    56	        path, fresh = items[i]
    57	        if path not in seen and not fresh:
    58	            stale.append(path)
    59	    return stale
    60	
    61	
    62	def copy_file(src, dst):
    63	    """Copy src to dst, creating parent directories as needed."""
    64	    os.makedirs(os.path.dirname(dst) or ".", exist_ok=True)
    65	    try:
    66	        with open(src, "rb") as fsrc, open(dst, "wb") as fdst:
    67	            fdst.write(fsrc.read())
    68	    except OSError:
    69	        pass  # unreadable source: skip it, next pass will retry
    70	
    71	
    72	def sync(src_root, dst_root, dry_run=False):
    73	    """Sync src_root into dst_root; return list of copied relative paths."""
    74	    src_manifest = build_manifest(src_root)
    75	    dst_manifest_path = os.path.join(dst_root, MANIFEST_NAME)
    76	    old_manifest = {}
    77	    if os.path.exists(dst_manifest_path):
    78	        with open(dst_manifest_path, "r", encoding="utf-8") as f:
    79	            old_manifest = json.load(f)
    80	    to_copy = changed_files(old_manifest, src_manifest)
    81	    if dry_run:
    82	        return to_copy
    83	    for rel in to_copy:
    84	        copy_file(os.path.join(src_root, rel), os.path.join(dst_root, rel))
    85	    with open(dst_manifest_path, "w", encoding="utf-8") as f:
    86	        json.dump(src_manifest, f, indent=2)
    87	    return to_copy
    88	
    89	
    90	def main(argv=None):
    91	    parser = argparse.ArgumentParser(prog="synccli")
    92	    parser.add_argument("src")
    93	    parser.add_argument("dst")
    94	    parser.add_argument("--dry-run", action="store_true")
    95	    args = parser.parse_args(argv)
    96	    copied = sync(args.src, args.dst, dry_run=args.dry_run)
    97	    for rel in copied:
    98	        print(rel)
    99	    return 0
