import hashlib, os, shutil, tempfile, time

base = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    # 1) Per-file overhead: 5000 tiny 1-byte files
    src_small = os.path.join(base, "src_small")
    dst_small = os.path.join(base, "dst_small")
    os.makedirs(src_small); os.makedirs(dst_small)
    rels = []
    for d in range(50):
        os.makedirs(os.path.join(src_small, f"d{d:02d}"))
        os.makedirs(os.path.join(dst_small, f"d{d:02d}"))
        for f in range(100):
            rel = os.path.join(f"d{d:02d}", f"f{f:03d}")
            rels.append(rel)
            with open(os.path.join(src_small, rel), "wb") as fp:
                fp.write(b"a")

    t0 = time.perf_counter()
    for rel in rels:
        s = os.path.join(src_small, rel)
        d = os.path.join(dst_small, rel)
        h = hashlib.sha256()
        with open(s, "rb") as fs, open(d, "wb") as fd:
            buf = fs.read(1048576)
            h.update(buf)
            fd.write(buf)
        st = os.stat(s)
        os.utime(d, ns=(st.st_atime_ns, st.st_mtime_ns))
    t1 = time.perf_counter()

    # 2) Pure byte throughput: 1 x 256 MiB file streamed 1 MiB + sha256
    big_src = os.path.join(base, "big.bin")
    big_dst = os.path.join(base, "big_copy.bin")
    chunk = os.urandom(1048576)
    with open(big_src, "wb") as fp:
        for _ in range(256):
            fp.write(chunk)
    t2 = time.perf_counter()
    h = hashlib.sha256()
    with open(big_src, "rb") as fs, open(big_dst, "wb") as fd:
        while True:
            buf = fs.read(1048576)
            if not buf:
                break
            h.update(buf)
            fd.write(buf)
    os.fsync(fd.fileno()) if False else None
    t3 = time.perf_counter()

    c_file = (t1 - t0) / 5000
    mb_per_s = 256 / (t3 - t2)
    print(f"5000 tiny files: {t1-t0:.4f}s => c_file = {c_file*1000:.4f} ms/file")
    print(f"256 MiB stream+sha256: {t3-t2:.4f}s => {mb_per_s:.1f} MB/s (c_byte = {(t3-t2)/256*1000:.3f} ms/MiB)")
finally:
    shutil.rmtree(base, ignore_errors=True)
'
