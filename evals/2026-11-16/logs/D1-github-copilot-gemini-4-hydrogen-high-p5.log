import os, shutil, tempfile, time, json, sys
sys.path.insert(0, os.getcwd())
import synccli

base = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(base, "src")
    dst1 = os.path.join(base, "dst_synccli")
    dst2 = os.path.join(base, "dst_buffered")
    dst3 = os.path.join(base, "dst_link")
    os.makedirs(src)
    os.makedirs(dst1)
    os.makedirs(dst2)
    os.makedirs(dst3)

    # Create 2000 files across 20 dirs, 50 KB each = 100 MB
    payload = b"x" * 51200
    for d in range(20):
        dd = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(dd)
        for f in range(100):
            with open(os.path.join(dd, f"file_{f:04d}.json"), "wb") as fp:
                fp.write(payload)

    t0 = time.perf_counter()
    files = synccli.scan_files(src)
    t1 = time.perf_counter()
    manifest = synccli.build_manifest(src)
    t2 = time.perf_counter()
    copied = synccli.sync(src, dst1)
    t3 = time.perf_counter()

    # Measure buffered copyfile + copystat (256 KB buffer / shutil.copy2)
    t4 = time.perf_counter()
    for rel in files:
        s = os.path.join(src, rel)
        d = os.path.join(dst2, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        shutil.copy2(s, d)
    t5 = time.perf_counter()

    # Measure hardlink creation from dst2 to dst3 (incremental unchanged run)
    t6 = time.perf_counter()
    for rel in files:
        s = os.path.join(dst2, rel)
        d = os.path.join(dst3, rel)
        os.makedirs(os.path.dirname(d), exist_ok=True)
        os.link(s, d)
    t7 = time.perf_counter()

    # Measure manifest dump/load for 2000 entries
    m_path = os.path.join(base, "m.json")
    t8 = time.perf_counter()
    with open(m_path, "w") as fp:
        json.dump(manifest, fp)
    t9 = time.perf_counter()
    with open(m_path, "r") as fp:
        _ = json.load(fp)
    t10 = time.perf_counter()

    print(f"files={len(files)}, total_bytes={len(files)*len(payload)}")
    print(f"scan_files: {t1-t0:.4f}s")
    print(f"build_manifest (includes scan_files+stat): {t2-t1:.4f}s")
    print(f"synccli.sync (100MB, 2000 files): {t3-t2:.4f}s ({100/(t3-t2):.1f} MB/s)")
    print(f"shutil.copy2 (100MB, 2000 files): {t5-t4:.4f}s ({100/(t5-t4):.1f} MB/s)")
    print(f"os.link (2000 files): {t7-t6:.4f}s")
    print(f"json dump (2000 entries): {t9-t8:.4f}s, size={os.path.getsize(m_path)} bytes")
    print(f"json load (2000 entries): {t10-t9:.4f}s")
finally:
    shutil.rmtree(base, ignore_errors=True)
