import hashlib, os, shutil, tempfile, time

base = tempfile.mkdtemp(dir="/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode")
try:
    src = os.path.join(base, "src")
    dst_buf = os.path.join(base, "dst_buf")
    dst_fsync = os.path.join(base, "dst_fsync")
    os.makedirs(src); os.makedirs(dst_buf); os.makedirs(dst_fsync)
    payload = b"x" * 51200
    rels = []
    for d in range(20):
        dd = os.path.join(src, f"dir_{d:02d}")
        os.makedirs(dd)
        for f in range(100):
            rel = os.path.join(f"dir_{d:02d}", f"file_{f:04d}.json")
            rels.append(rel)
            with open(os.path.join(src, rel), "wb") as fp:
                fp.write(payload)

    # Buffered 1 MiB copy + copystat minimal (utime_ns) + sha256 during stream
    t0 = time.perf_counter()
    for d in range(20):
        os.makedirs(os.path.join(dst_buf, f"dir_{d:02d}"), exist_ok=True)
    for rel in rels:
        s = os.path.join(src, rel)
        d = os.path.join(dst_buf, rel)
        h = hashlib.sha256()
        with open(s, "rb") as fs, open(d, "wb") as fd:
            while True:
                buf = fs.read(1048576)
                if not buf:
                    break
                h.update(buf)
                fd.write(buf)
        st = os.stat(s)
        os.utime(d, ns=(st.st_atime_ns, st.st_mtime_ns))
    t1 = time.perf_counter()

    # Measure with per-file os.fsync
    for d in range(20):
        os.makedirs(os.path.join(dst_fsync, f"dir_{d:02d}"), exist_ok=True)
    t2 = time.perf_counter()
    for rel in rels[:200]:
        s = os.path.join(src, rel)
        d = os.path.join(dst_fsync, rel)
        with open(s, "rb") as fs, open(d, "wb") as fd:
            fd.write(fs.read(1048576))
            fd.flush()
            os.fsync(fd.fileno())
    t3 = time.perf_counter()

    # Measure rmtree of 2000 files
    t4 = time.perf_counter()
    shutil.rmtree(dst_buf)
    t5 = time.perf_counter()

    print(f"streamed_1MB_sha256_utime (100MB, 2000 files): {t1-t0:.4f}s ({100/(t1-t0):.1f} MB/s)")
    print(f"per_file_fsync (200 files = 10MB): {t3-t2:.4f}s ({(t3-t2)/200*1000:.2f} ms/file)")
    print(f"rmtree (2000 files): {t5-t4:.4f}s")
finally:
    shutil.rmtree(base, ignore_errors=True)
