        o = json.loads(line)
        loaded[o.pop("p")] = o
t1 = time.perf_counter()
print(json.dumps({"mode": "jsonl_parse_30k", "bytes": os.path.getsize(jl), "secs": round(t1-t0, 3)}))
os.remove(jl)
