cur, peak = tracemalloc.get_traced_memory()
tracemalloc.stop()
print(json.dumps({"mode": "record_dict_mem", "entries": len(recs), "bytes_per_entry": round(cur/len(recs), 1), "peak_bytes_per_entry": round(peak/len(recs), 1)}))

# write them as JSONL, then time the parse (base-load cost per run)
