[0m$ [0mcd /private/var/folders/k0/m1pgz3y90k34xd8h1b4tdkqw0000gp/T/opencode/backupctl-probe && export PYTHONDONTWRITEBYTECODE=1 && python3 - <<'EOF'
import os, time, json, shutil, tracemalloc
import perf
TREE, SCR = perf.TREE, perf.SCR
paths = []
for dp, dn, fn in os.walk(TREE):
    for nm in fn:
        paths.append(os.path.join(dp, nm))
rels = [os.path.relpath(p, TREE) for p in paths]
# precreate directory tree once, then time only the per-file operation
out = os.path.join(SCR, "linked2")
if os.path.exists(out): shutil.rmtree(out)
dirs = sorted({os.path.dirname(os.path.join(out, r)) for r in rels})
for d in dirs: os.makedirs(d, exist_ok=True)
t0 = time.perf_counter()
for p, r in zip(paths, rels):
    os.link(p, os.path.join(out, r))
t1 = time.perf_counter()
print(json.dumps({"mode": "link_only_30k", "secs": round(t1-t0, 3), "us_per_file": round((t1-t0)/len(paths)*1e6, 1)}))
shutil.rmtree(out)
# same, but copy via open/write (no fsync), dirs precreated
out2 = os.path.join(SCR, "copied2")
if os.path.exists(out2): shutil.rmtree(out2)
dirs = sorted({os.path.dirname(os.path.join(out2, r)) for r in rels})
for d in dirs: os.makedirs(d, exist_ok=True)
t0 = time.perf_counter()
for p, r in zip(paths, rels):
    with open(p, "rb") as fs, open(os.path.join(out2, r), "xb") as fd:
        fd.write(fs.read())
t1 = time.perf_counter()
print(json.dumps({"mode": "copy_only_30k_dirs_precreated", "secs": round(t1-t0, 3), "us_per_file": round((t1-t0)/len(paths)*1e6, 1)}))
shutil.rmtree(out2)
# record memory: tuple-packed vs dict
def dict_recs():
    d = {}
    for p, r in zip(paths, rels):
        st = os.lstat(p)
        d[r] = {"kind": "f", "size": st.st_size, "mtime_ns": st.st_mtime_ns, "ctime_ns": st.st_ctime_ns, "ino": st.st_ino, "dev": st.st_dev}
    return d
def tuple_recs():
    d = {}
    for p, r in zip(paths, rels):
        st = os.lstat(p)
        d[r] = ("f", st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino, st.st_dev)
    return d
for fn in (dict_recs, tuple_recs):
    tracemalloc.start()
    x = fn()
    cur, peak = tracemalloc.get_traced_memory()
    tracemalloc.stop()
    print(json.dumps({"mode": "mem_" + fn.__name__, "entries": len(x), "bytes_per_entry": round(cur/len(x), 1)}))
    del x
