class RegressionTests(unittest.TestCase):
    """Boolean transform, cache hygiene and failure-policy regressions."""

    def setUp(self):
        self.tmp = tempfile.mkdtemp(prefix="rg3-reg-")
        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
        self.out = os.path.join(self.tmp, "out")
        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
        self.inp = os.path.join(self.tmp, "in")
        os.makedirs(self.inp)
        self.rules_path = os.path.join(self.tmp, "rules.toml")
        with open(self.rules_path, "w") as fh:
            fh.write('[transforms]\\nflag = "boolean"\\n')

    def write_csv(self, body):
        with open(os.path.join(self.inp, "f.csv"), "w") as fh:
            fh.write(body)

    def run_tool(self):
        return reportgen.run(self.rules_path, self.inp, self.out, self.cache_path)

    def test_boolean_accepts_case_insensitive_words(self):
        self.assertEqual(transforms.apply("boolean", "YES"), 1.0)
        self.assertEqual(transforms.apply("boolean", "True"), 1.0)
        self.assertEqual(transforms.apply("boolean", "no"), 0.0)
        self.assertEqual(transforms.apply("boolean", " FALSE "), 0.0)

    def test_boolean_rejects_other_values(self):
        for bad in ("1", "y", "", "maybe"):
            with self.assertRaises(transforms.TransformError):
                transforms.apply("boolean", bad)

    def test_date_iso_rejects_non_ascii_digits_without_crashing(self):
        with self.assertRaises(transforms.TransformError):
            transforms.apply("date_iso", "\\u00b9/15/2026")

    def test_boolean_column_sums_numerically(self):
        self.write_csv("id,flag\\n1,yes\\n2,No\\n3,TRUE\\n")
        cols = self.run_tool()["files"]["f.csv"]["summary"]["columns"]
        self.assertEqual(cols["flag"]["numeric_sum"], 2.0)

    def test_future_schema_state_does_not_crash_and_is_rewritten(self):
        self.write_csv("id,flag\\n1,yes\\n")
        os.makedirs(os.path.dirname(self.cache_path))
        with open(self.cache_path, "w") as fh:
            json.dump({"version": 99, "f.csv": {"registry_version": "99"}}, fh)
        report = self.run_tool()
        self.assertEqual(report["total_rows"], 1)
        state = cache.load_state(self.cache_path)
        self.assertEqual(state["f.csv"]["registry_version"], cache.REGISTRY_VERSION)
        self.assertNotIn("version", json.load(open(self.cache_path)))

    def test_entry_from_other_registry_version_is_not_reused(self):
        self.write_csv("id,flag\\n1,yes\\n")
        self.run_tool()
        state = json.load(open(self.cache_path))
        state["f.csv"]["registry_version"] = "1"
        state["f.csv"]["summary"]["columns"]["flag"]["numeric_sum"] = 999.0
        with open(self.cache_path, "w") as fh:
            json.dump(state, fh)
        cols = self.run_tool()["files"]["f.csv"]["summary"]["columns"]
        self.assertEqual(cols["flag"]["numeric_sum"], 1.0)

    def test_cached_and_fresh_runs_report_same_generated_from(self):
        self.write_csv("id,flag\\n1,yes\\n,\\n")
        fresh = self.run_tool()["files"]["f.csv"]["generated_from"]
        cached = self.run_tool()["files"]["f.csv"]["generated_from"]
        self.assertEqual(fresh, cached)

    def test_failed_cell_emits_no_report_and_no_cache(self):
        self.write_csv("id,flag\\n1,yes\\n2,maybe\\n")
        with self.assertRaises(reportgen.ValidationError):
            self.run_tool()
