+def _version_number(value):
+    """Best-effort integer value of a version field; None if unparseable."""
+    if isinstance(value, bool):
+        return None
+    try:
+        return int(str(value).strip())
+    except ValueError:
+        return None
+
+
+def _is_future_state(state):
+    """True when the state was written by a schema newer than this code: a
+    top-level version field, or any entry's registry_version, greater than
+    REGISTRY_VERSION."""
+    current = int(REGISTRY_VERSION)
+    candidates = [state.get(k) for k in
+                  ("version", "registry_version", "schema_version")
+                  if k in state]
+    candidates += [e.get("registry_version") for e in state.values()
+                   if isinstance(e, dict)]
+    for value in candidates:
+        number = _version_number(value)
+        if number is not None and number > current:
+            return True
+    return False
+
+
