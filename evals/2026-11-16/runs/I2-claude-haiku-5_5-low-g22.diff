+def boolean(value):
+    """'yes'/'true' -> 1.0, 'no'/'false' -> 0.0, case-insensitive.
+    Surrounding whitespace is ignored; anything else raises."""
+    word = value.strip().lower()
+    if word in BOOLEAN_TRUE:
+        return 1.0
+    if word in BOOLEAN_FALSE:
+        return 0.0
+    raise TransformError("not a boolean: %r" % value)
