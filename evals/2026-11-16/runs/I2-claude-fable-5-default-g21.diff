+class RegressionTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="rg3-reg-")
+        self.addCleanup(shutil.rmtree, self.tmp, ignore_errors=True)
+        self.inp = os.path.join(self.tmp, "in")
+        os.makedirs(self.inp)
+        self.out = os.path.join(self.tmp, "out")
+        self.cache_path = os.path.join(self.tmp, "cache", "state.json")
+        self.rules_path = os.path.join(self.tmp, "rules.toml")
+        with open(self.rules_path, "w") as fh:
+            fh.write('[transforms]\nitem = "round2"\n')
+
+    def write_csv(self, body):
+        with open(os.path.join(self.inp, "t.csv"), "w") as fh:
+            fh.write(body)
+
+    def run_tool(self):
+        return reportgen.run(self.rules_path, self.inp, self.out,
+                             self.cache_path)
+
+    def test_failed_transform_leaves_no_report_and_no_cache(self):
+        # Defect: report.html and cache state used to be written before
+        # validation rejected a run with failed transforms.
+        self.write_csv("item,label\nnot-a-number,alpha\n")
+        with self.assertRaises(reportgen.ValidationError):
+            self.run_tool()
+        self.assertFalse(os.path.exists(os.path.join(self.out, "report.html")))
+        self.assertFalse(os.path.exists(os.path.join(self.out, "report.json")))
+        self.assertFalse(os.path.exists(self.cache_path))
+
+    def test_future_version_cache_treated_as_empty(self):
+        # Goal item 2: a future-schema state.json must not crash the run;
+        # the run completes and rewrites a valid state file.
+        os.makedirs(os.path.dirname(self.cache_path))
+        with open(self.cache_path, "w") as fh:
+            json.dump({"version": 99, "payload": {"opaque": True}}, fh)
+        self.write_csv("item,label\n1,alpha\n")
+        report = self.run_tool()
+        self.assertEqual(report["total_rows"], 1)
+        state = cache.load_state(self.cache_path)
+        self.assertIn("t.csv", state)
+        self.assertEqual(state["t.csv"]["registry_version"],
+                         cache.REGISTRY_VERSION)
+        self.assertNotIn("version", state)
+
