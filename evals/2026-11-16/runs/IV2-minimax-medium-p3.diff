+def _version_key(value):
+    """Ordering key for a version value.
+
+    Versions may be written as an int or as a string; the two must compare
+    without raising (and "10" must sort above "2"), so numeric values are
+    compared as numbers and non-numeric ones as strings in a separate
+    group."""
+    if isinstance(value, bool) or value is None:
+        return (0, "")
+    if isinstance(value, (int, float)):
+        return (1, float(value))
+    if isinstance(value, str):
+        text = value.strip()
+        try:
+            return (1, float(text))
+        except ValueError:
+            return (0, text)
+    return (0, "")
+
+
+def is_newer_version(value, current=REGISTRY_VERSION):
+    """True when `value` names a schema version newer than `current`."""
+    return _version_key(value) > _version_key(current)
