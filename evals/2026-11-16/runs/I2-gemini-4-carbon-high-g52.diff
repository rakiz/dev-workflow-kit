+def _is_future_state(data):
+    if not isinstance(data, dict):
+        return True
+    current = _parse_version(REGISTRY_VERSION)
+
+    def walk(obj, depth=0):
+        if isinstance(obj, dict):
+            for k, v in obj.items():
+                if depth >= 1 and k == "summary":
+                    continue
+                if (k == "version" or k.endswith("_version")) and not isinstance(v, (dict, list)):
+                    parsed = _parse_version(v)
+                    if parsed is not None and parsed > current:
+                        return True
+                if isinstance(v, (dict, list)) and walk(v, depth + 1):
+                    return True
+        elif isinstance(obj, list):
+            for item in obj:
+                if isinstance(item, (dict, list)) and walk(item, depth + 1):
+                    return True
+        return False
+
+    return walk(data)
+
+
