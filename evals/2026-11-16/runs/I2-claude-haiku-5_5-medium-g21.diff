+def is_future_state(state):
+    """True when the state was written by a schema newer than this code:
+    a top-level version marker or any entry's registry_version is greater
+    than REGISTRY_VERSION."""
+    current = int(REGISTRY_VERSION)
+    markers = [state.get("version"), state.get("registry_version")]
+    markers += [e.get("registry_version") for e in state.values()
+                if isinstance(e, dict)]
+    return any((_as_version(m) or 0) > current for m in markers)
+
