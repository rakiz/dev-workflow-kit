+_VERSION_KEYS = ("version", "schema_version", "registry_version")
 
+
+def _parse_version(value):
+    """Parse a version number (int, float, or dotted digit string) into an
+    int tuple for numeric comparison, or return None if unparseable."""
+    if isinstance(value, bool):
+        return None
+    if isinstance(value, int):
+        return (value,)
+    if isinstance(value, float):
+        value = str(value)
+    if isinstance(value, str):
+        text = value.strip()
+        if text.startswith(("v", "V")):
+            text = text[1:]
+        parts = text.split(".")
+        if parts and all(p.isdigit() for p in parts):
+            return tuple(int(p) for p in parts)
+    return None
+
+
+def _is_future_version(value):
+    """Return True when `value` represents a version greater than
+    REGISTRY_VERSION (or an unrecognized non-current version)."""
+    current = _parse_version(REGISTRY_VERSION)
+    parsed = _parse_version(value)
+    if parsed is None:
+        return value != REGISTRY_VERSION
+    return parsed > current
+
+
+def _has_future_version(data):
+    """Return True if a loaded cache state carries a top-level or per-entry
+    version field greater than REGISTRY_VERSION."""
+    for key in _VERSION_KEYS:
+        if key in data and not isinstance(data[key], dict):
+            if _is_future_version(data[key]):
+                return True
+    for entry in data.values():
+        if isinstance(entry, dict):
+            for key in _VERSION_KEYS:
+                if key in entry and _is_future_version(entry[key]):
+                    return True
+    return False
+
+
