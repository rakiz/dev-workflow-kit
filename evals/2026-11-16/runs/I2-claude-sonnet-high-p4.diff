+def _version_number(value):
+    try:
+        return int(value)
+    except (TypeError, ValueError):
+        return None
+
+
+def _is_future_state(state):
+    """True when the state was written by a schema version newer than
+    REGISTRY_VERSION: a top-level "version" field, or any entry's
+    "registry_version", greater than the current one."""
+    current = int(REGISTRY_VERSION)
+    if not isinstance(state, dict):
+        return False
+    candidates = [state.get("version")]
+    candidates += [e.get("registry_version") for e in state.values()
+                   if isinstance(e, dict)]
+    return any(n is not None and n > current
+               for n in map(_version_number, candidates))
+
+
