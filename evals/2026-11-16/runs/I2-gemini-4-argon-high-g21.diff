+def _parse_version(val):
+    if isinstance(val, bool) or val is None:
+        return None
+    if isinstance(val, (int, float)):
+        return (val,)
+    if isinstance(val, str):
+        s = val.strip().lstrip("vV")
+        parts = s.split(".")
+        if parts and all(p.isdigit() for p in parts):
+            return tuple(int(p) for p in parts)
+        try:
+            return (float(s),)
+        except ValueError:
+            return None
+    return None
+
+
+def _is_future_version(val):
+    parsed = _parse_version(val)
+    current = _parse_version(REGISTRY_VERSION)
+    if parsed is not None and current is not None:
+        return parsed > current
+    if isinstance(val, str):
+        return val > REGISTRY_VERSION
+    return False
+
+
+def _has_future_version(obj):
+    if isinstance(obj, dict):
+        for k, v in obj.items():
+            if k in ("registry_version", "version", "schema_version") and _is_future_version(v):
+                return True
+            if _has_future_version(v):
+                return True
+    elif isinstance(obj, list):
+        return any(_has_future_version(item) for item in obj)
+    return False
+
