+
+
+def is_future_state(state):
+    """True when the state, or any entry in it, was stamped by a registry
+    version newer than this code understands."""
+    current = int(REGISTRY_VERSION)
+    versions = [state.get("registry_version")]
+    versions += [e.get("registry_version") for e in state.values()
+                 if isinstance(e, dict)]
+    for v in versions:
+        n = _version_number(v)
+        if n is not None and n > current:
+            return True
+    return False
+
