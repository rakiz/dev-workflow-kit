+def _usable(state):
+    """Keep only what the current schema can read: a state file written
+    by a future schema version (a version field greater than the current
+    REGISTRY_VERSION) is treated as empty, and entries stamped with any
+    other registry version (older or newer) are never reused."""
+    if not isinstance(state, dict):
+        return {}
+    if _is_future_version(state.get("version")):
+        return {}
+    entries = {}
+    for name, entry in state.items():
+        if isinstance(entry, dict) and entry.get("registry_version") == REGISTRY_VERSION:
+            entries[name] = entry
+    return entries
+
