import os, tempfile, time, json, synccli

def bench(files, mb):
    with tempfile.TemporaryDirectory() as src, tempfile.TemporaryDirectory() as dst:
        chunk = b'x' * (64 * 1024)
        for i in range(files):
            p = os.path.join(src, f'f{i:06d}')
            with open(p, 'wb') as f:
                remaining = mb * 1024 * 1024 // files
                for _ in range(remaining // len(chunk)):
                    f.write(chunk)
        start = time.perf_counter(); copied = synccli.sync(src, dst); elapsed = time.perf_counter()-start
        size = sum(os.stat(os.path.join(src,x)).st_size for x in copied)
        print(json.dumps({'files':files,'bytes':size,'sync_seconds':round(elapsed,4),'MiB_s':round(size/elapsed/1048576,1)}))
