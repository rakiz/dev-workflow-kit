import builtins, io, json, os, shutil, subprocess, sys, tempfile

BASE = os.getcwd()
tmp = tempfile.mkdtemp()
inp = os.path.join(tmp, "in"); os.makedirs(inp)
open(os.path.join(inp, "t.csv"), "w").write("item,flag\n1,yes\n2,no\n")
bad = os.path.join(tmp, "bad"); os.makedirs(bad)
open(os.path.join(bad, "t.csv"), "w").write("item,flag\n1,yes\n2,maybe\n")
rules = os.path.join(tmp, "rules.toml")
open(rules, "w").write('[transforms]\nitem = "round2"\nflag = "boolean"\n')
out = os.path.join(tmp, "out"); cp = os.path.join(tmp, "cache", "state.json")

def arts():
    return {p: (open(p,'rb').read() if os.path.exists(p) else None)
            for p in (os.path.join(out,'report.json'), os.path.join(out,'report.html'), cp)}

def cli(input_dir):
    return subprocess.run([sys.executable, os.path.join(BASE,'reportgen.py'),
        '--rules', rules, '--input', input_dir, '--output', out, '--cache', cp],
        capture_output=True, text=True)

r = cli(inp); print("good run exit:", r.returncode)
before = arts()
r = cli(bad)
print("failing run exit:", r.returncode)
print("failing run stderr:", r.stderr.strip())
after = arts()
print("artifacts byte-identical after failure:", before == after)
print("report.json unchanged:", before[os.path.join(out,'report.json')] == after[os.path.join(out,'report.json')])
print("report.html unchanged:", before[os.path.join(out,'report.html')] == after[os.path.join(out,'report.html')])
print("cache unchanged:", before[cp] == after[cp])
print("cache still holds the good summary:",
      json.loads(after[cp])['entries']['t.csv']['summary']['skipped_rows'] == [])

# count how many times the rules file is opened during a run
import reportgen
real_open = builtins.open
opens = []
def counting_open(file, *a, **kw):
    if os.path.abspath(str(file)) == os.path.abspath(rules):
        opens.append(str(file))
    return real_open(file, *a, **kw)
builtins.open = counting_open
reportgen.run(rules, inp, out, cp)
builtins.open = real_open
print("rules file opened during a run:", len(opens), "time(s)")
shutil.rmtree(tmp, ignore_errors=True)
