+class FailurePolicyTests(unittest.TestCase):
+    """Any transform failure: exit 1, nothing new emitted, previous report
+    and cache untouched."""
+
+    def setUp(self):
+        self.tmp = make_tmp(self, "rg3-policy-")
+        self.inp = os.path.join(self.tmp, "in")
