+
+def boolean(value):
+    """'yes'/'true' -> 1.0, 'no'/'false' -> 0.0 (case-insensitive, no
+    whitespace stripping); anything else is an error."""
+    key = value.lower()
+    if key not in BOOLEAN_VALUES:
+        raise TransformError("not a boolean: %r" % value)
+    return BOOLEAN_VALUES[key]
