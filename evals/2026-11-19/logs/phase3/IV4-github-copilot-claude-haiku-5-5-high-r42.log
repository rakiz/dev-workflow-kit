    45	class RulesTests(unittest.TestCase):
    46	    def test_rules_loader_ignores_other_tables(self):
    47	        tmp = tempfile.mkdtemp(prefix="rg3-rules-")
    48	        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
    49	        path = os.path.join(tmp, "rules.toml")
    50	        with open(path, "w") as fh:
    51	            fh.write('# rules\n[report]\ntitle = "x"\n\n[transforms]\nname = "upper"\n')
    52	        self.assertEqual(reportgen.load_rules(path), {"name": "upper"})
    53	
    54	    def test_shipped_rules_load(self):
    55	        rules = reportgen.load_rules(RULES)
    56	        self.assertEqual(rules["amount"], "currency_amount")
    57	        self.assertEqual(rules["date"], "date_iso")
    58	        self.assertNotIn("notes", rules)
