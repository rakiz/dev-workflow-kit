    19	class TransformTests(unittest.TestCase):
    20	    def test_trim_upper_lower(self):
    21	        self.assertEqual(transforms.apply("trim", "  x "), "x")
    22	        self.assertEqual(transforms.apply("upper", "aB"), "AB")
    23	        self.assertEqual(transforms.apply("lower", "aB"), "ab")
    24	
    25	    def test_currency_amount(self):
    26	        self.assertEqual(transforms.apply("currency_amount", "$1,234.5"), 1234.5)
    27	        with self.assertRaises(transforms.TransformError):
    28	            transforms.apply("currency_amount", "see invoice")
    29	
    30	    def test_round2(self):
    31	        self.assertEqual(transforms.apply("round2", "3.14159"), 3.14)
    32	        with self.assertRaises(transforms.TransformError):
    33	            transforms.apply("round2", "n/a")
    34	
    35	    def test_date_iso(self):
    36	        self.assertEqual(transforms.apply("date_iso", "01/15/2026"), "2026-01-15")
    37	        with self.assertRaises(transforms.TransformError):
    38	            transforms.apply("date_iso", "2026-01-15")
    39	
    40	    def test_unknown_transform_name(self):
    41	        with self.assertRaises(transforms.TransformError):
    42	            transforms.apply("nope", "x")
    43	
