=== reportgen.py
     1	"""reportgen — summarize CSV inputs through per-column transforms.
     2	
     3	Reads every *.csv in the input directory, applies the per-column
     4	transforms from a rules file, and writes a JSON summary plus an HTML
     5	rendering of the same summary to the output directory. A content cache
     6	(cache/state.json) lets unchanged inputs skip re-transformation on later
     7	runs.
     8	
     9	Usage:
    10	    python3 reportgen.py [--rules rules.example.toml] [--input input]
    11	                         [--output output] [--cache cache/state.json]
    12	"""
    13	
    14	import argparse
    15	import csv
    16	import json
    17	import os
    18	import sys
    19	
    20	import cache
    21	import transforms
    22	
    23	DEFAULT_RULES = "rules.example.toml"
    24	DEFAULT_INPUT = "input"
    25	DEFAULT_OUTPUT = "output"
    26	
    27	
    28	class ValidationError(Exception):
    29	    """Raised when a summary was derived from an incomplete transform
    30	    pass (at least one cell failed its transform)."""
    31	
    32	
    33	def load_rules(path):
    34	    """Load a rules file. Only the [transforms] table is read; it maps
    35	    column name -> transform name. Other tables are reserved for future
    36	    report options and ignored."""
    37	    rules = {}
    38	    section = None
    39	    with open(path, "r", encoding="utf-8") as fh:
    40	        for lineno, raw in enumerate(fh, start=1):
    41	            line = raw.strip()
    42	            if not line or line.startswith("#"):
    43	                continue
    44	            if line.startswith("[") and line.endswith("]"):
    45	                section = line[1:-1].strip()
    46	                continue
    47	            if "=" not in line:
    48	                raise ValueError('%s:%d: expected key = "value"' % (path, lineno))
    49	            key, _, value = line.partition("=")
    50	            if section == "transforms":
    51	                rules[key.strip().strip('"')] = value.strip().strip('"')
    52	    return rules
    53	
    54	
    55	def load_rows(path):
    56	    """Return (header, data_rows). Blank physical lines are not rows;
    57	    quoted cells may span physical lines."""
    58	    with open(path, "r", encoding="utf-8", newline="") as fh:
    59	        reader = csv.reader(fh)
    60	        header = next(reader)
    61	        return header, [row for row in reader if row]
    62	
    63	
    64	def summarize_file(header, data_rows, rules):
    65	    """Column-level summary of one input file: per column, the non-empty
    66	    cell count, the distinct count over transformed values, the first
    67	    three distinct values in sorted order, and the numeric sum when every
    68	    transformed value is a float. Cells that fail their transform are
    69	    skipped and recorded in `skipped_rows`."""
    70	    columns = {}
    71	    skipped_rows = []
    72	    for row_no, row in enumerate(data_rows, start=2):
    73	        for i, col in enumerate(header):
    74	            raw = row[i] if i < len(row) else ""
    75	            tname = rules.get(col)
    76	            if tname:
    77	                try:
    78	                    value = transforms.apply(tname, raw)
    79	                except transforms.TransformError as exc:
    80	                    skipped_rows.append(
    81	                        {"row": row_no, "column": col, "reason": str(exc)})
    82	                    continue
    83	            else:
    84	                value = raw
    85	            stats = columns.setdefault(col, {"non_empty": 0, "values": set()})
    86	            if raw != "":
    87	                stats["non_empty"] += 1
    88	            stats["values"].add(value)
    89	    out = {}
    90	    for col in sorted(columns):
    91	        stats = columns[col]
    92	        values = stats["values"]
    93	        entry = {"non_empty": stats["non_empty"], "distinct": len(values),
    94	                 "sample": sorted(values, key=str)[:3]}
    95	        numeric = [v for v in values if isinstance(v, float)]
    96	        if numeric and len(numeric) == len(values):
    97	            entry["numeric_sum"] = round(sum(sorted(numeric)), 2)
    98	        out[col] = entry
    99	    return {"columns": out, "skipped_rows": skipped_rows}
   100	
   101	
   102	def generated_from(header, data_rows, rules):
   103	    """Number of rules-mapped columns that have at least one non-empty
   104	    cell in the file."""
   105	    non_empty = set()
   106	    for row in data_rows:
   107	        for i, col in enumerate(header):
   108	            if i < len(row) and row[i] != "":
   109	                non_empty.add(col)
   110	    return sum(1 for col in header if col in rules and col in non_empty)
   111	
   112	
   113	def validate_summary(summary):
   114	    """Reject a summary that was derived from cells that failed their
   115	    transform."""
   116	    skipped = summary.get("skipped_rows") or []
   117	    if skipped:
   118	        first = skipped[0]
   119	        raise ValidationError(
   120	            "%d cell(s) failed their transform (first: row %s, column %s)"
   121	            % (len(skipped), first["row"], first["column"]))
   122	
   123	
   124	def render_html(report):
   125	    """Render the summary as a standalone HTML page, one table per file."""
   126	    parts = ["<!doctype html>",
   127	             "<html><head><meta charset='utf-8'>",
   128	             "<title>reportgen summary</title></head><body>"]
   129	    for name in sorted(report["files"]):
   130	        res = report["files"][name]
   131	        parts.append("<h1>%s</h1>" % name)
   132	        parts.append("<p>%d rows</p>" % res["rows"])
   133	        parts.append("<table border='1'>")
   134	        parts.append("<tr><th>column</th><th>non_empty</th>"
   135	                     "<th>distinct</th><th>sample</th></tr>")
   136	        summary = res["summary"]["columns"]
   137	        for col in sorted(summary):
   138	            stats = summary[col]
   139	            sample = ", ".join(str(v) for v in stats["sample"])
   140	            parts.append("<tr><td>%s</td><td>%d</td><td>%d</td><td>%s</td></tr>"
   141	                         % (col, stats["non_empty"], stats["distinct"], sample))
   142	        parts.append("</table>")
   143	    parts.append("</body></html>")
   144	    return "\n".join(parts)
   145	
   146	
   147	def run(rules_path, input_dir, output_dir, cache_path):
   148	    """Run one full pass over the input directory and write the report."""
   149	    state = cache.load_state(cache_path)
   150	
   151	    names = sorted(n for n in os.listdir(input_dir) if n.endswith(".csv"))
   152	    results = {}
   153	    pending = {}
   154	    for name in names:
   155	        rules = load_rules(rules_path)
   156	        rules_fp = cache.rules_fingerprint(rules)
   157	        path = os.path.join(input_dir, name)
   158	        digest = cache.file_digest(path)
   159	        entry = state.get(name)
   160	        header, data_rows = load_rows(path)
   161	        print("reportgen: %s: parsed %d rows" % (name, len(data_rows)))
   162	        if entry and entry["digest"] == digest and entry.get("rules_fp") == rules_fp:
   163	            results[name] = {"digest": digest, "rows": entry["rows"],
   164	                             "generated_from": entry["generated_from"],
   165	                             "summary": entry["summary"]}
   166	        else:
   167	            summary = summarize_file(header, data_rows, rules)
   168	            results[name] = {"digest": digest, "rows": len(data_rows),
   169	                             "generated_from": generated_from(header, data_rows, rules),
   170	                             "summary": summary}
   171	            pending[name] = cache.make_entry(path, digest, len(data_rows),
   172	                                             summary, rules, rules_fp)
   173	            cache.save_state(pending, path=cache_path)
   174	
   175	    report = {"rules": rules_path,
   176	              "total_rows": sum(r["rows"] for r in results.values()),
   177	              "files": results}
   178	    os.makedirs(output_dir, exist_ok=True)
   179	    with open(os.path.join(output_dir, "report.html"), "w", encoding="utf-8") as fh:
   180	        fh.write(render_html(report))
   181	    for name in sorted(results):
   182	        validate_summary(results[name]["summary"])
   183	    with open(os.path.join(output_dir, "report.json"), "w", encoding="utf-8") as fh:
   184	        json.dump(report, fh, indent=2, sort_keys=True)
   185	        fh.write("\n")
   186	    return report
   187	
   188	
   189	def main(argv=None):
   190	    parser = argparse.ArgumentParser(
   191	        description="summarize CSV inputs through per-column transforms")
   192	    parser.add_argument("--rules", default=DEFAULT_RULES,
   193	                        help="rules TOML file mapping columns to transforms")
   194	    parser.add_argument("--input", default=DEFAULT_INPUT,
   195	                        help="directory of input CSV files")
   196	    parser.add_argument("--output", default=DEFAULT_OUTPUT,
   197	                        help="directory for report.json / report.html")
   198	    parser.add_argument("--cache", default=cache.DEFAULT_CACHE_PATH,
   199	                        help="path of the cache state file")
   200	    args = parser.parse_args(argv)
   201	    try:
   202	        return run(args.rules, args.input, args.output, args.cache)
   203	    except ValidationError as exc:
   204	        sys.stderr.write("reportgen: warning: %s\n" % exc)
   205	        return None
   206	
   207	
   208	if __name__ == "__main__":
   209	    main()
=== cache.py
     1	"""Content cache for reportgen.
     2	
     3	Layout: cache/state.json maps each input file name to one entry:
     4	
     5	    {"digest":           "<sha256 of the file bytes>",
     6	     "rows":             <int>,
     7	     "generated_from":   <int>,
     8	     "rules_fp":         "<fingerprint of the rules mapping>",
     9	     "registry_version": "<version of the transform registry>",
    10	     "summary":          {...}}
    11	
    12	Entries are reused when the file on disk is byte-identical to the file
    13	processed in the previous run and the rules mapping is unchanged;
    14	save_state() rewrites the state file after every run so it always mirrors
    15	what the last run saw.
    16	"""
    17	
    18	import csv
    19	import hashlib
    20	import json
    21	import os
    22	
    23	DEFAULT_CACHE_PATH = os.path.join("cache", "state.json")
    24	
    25	REGISTRY_VERSION = "2"
    26	
    27	
    28	def file_digest(path):
    29	    """sha256 of the file bytes (streamed, constant memory)."""
    30	    h = hashlib.sha256()
    31	    with open(path, "rb") as fh:
    32	        for chunk in iter(lambda: fh.read(65536), b""):
    33	            h.update(chunk)
    34	    return h.hexdigest()
    35	
    36	
    37	def rules_fingerprint(rules):
    38	    """Stable fingerprint of the effective column -> transform mapping."""
    39	    payload = json.dumps(rules, sort_keys=True, separators=(",", ":"))
    40	    return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]
    41	
    42	
    43	def load_state(path=DEFAULT_CACHE_PATH):
    44	    """Load the cache state; a missing file is just an empty cache."""
    45	    if not os.path.exists(path):
    46	        return {}
    47	    with open(path, "r", encoding="utf-8") as fh:
    48	        return json.load(fh)
    49	
    50	
    51	def save_state(entries, path=DEFAULT_CACHE_PATH):
    52	    """Merge `entries` into the state file, keeping entries for inputs the
    53	    run did not touch (a run may cover a subset of the inputs)."""
    54	    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    55	    merged = {}
    56	    if os.path.exists(path):
    57	        merged = load_state(path)
    58	    merged.update(entries)
    59	    tmp = path + ".tmp"
    60	    with open(tmp, "w", encoding="utf-8") as fh:
    61	        json.dump(merged, fh, indent=2, sort_keys=True)
    62	        fh.write("\n")
    63	    os.replace(tmp, path)
    64	
    65	
    66	def make_entry(path, digest, rows, summary, rules, rules_fp):
    67	    """Build a cache entry for `path`. `generated_from` is the number of
    68	    header columns covered by the rules mapping."""
    69	    with open(path, "r", encoding="utf-8", newline="") as fh:
    70	        header = next(csv.reader(fh))
    71	    generated_from = sum(1 for col in header if col in rules)
    72	    return {"digest": digest, "rows": rows, "generated_from": generated_from,
    73	            "rules_fp": rules_fp, "registry_version": REGISTRY_VERSION,
    74	            "summary": summary}
=== transforms.py
     1	"""Column transforms for reportgen.
     2	
     3	A rules file maps a column name to a transform name; the registry below is
     4	the single source of truth for what those names mean. Each transform takes
     5	the raw string cell and returns the transformed value — numeric transforms
     6	return floats, everything else returns strings.
     7	
     8	The registry is versioned: every cache entry is stamped with the registry
     9	version it was produced under (cache.REGISTRY_VERSION, stamped by
    10	make_entry) and the version is compared at lookup, so a summary written
    11	under an older registry is never reused.
    12	"""
    13	
    14	
    15	class TransformError(Exception):
    16	    """Raised when a cell cannot be transformed under its column's rule."""
    17	
    18	
    19	def trim(value):
    20	    return value.strip()
    21	
    22	
    23	def upper(value):
    24	    return value.upper()
    25	
    26	
    27	def lower(value):
    28	    return value.lower()
    29	
    30	
    31	def currency_amount(value):
    32	    """'$1,234.5' -> 1234.5 (float, rounded to 2 decimals)."""
    33	    cleaned = value.replace("$", "").replace(",", "").strip()
    34	    try:
    35	        return round(float(cleaned), 2)
    36	    except ValueError:
    37	        raise TransformError("not a currency amount: %r" % value)
    38	
    39	
    40	def round2(value):
    41	    """Parse a float and round it to 2 decimals."""
    42	    try:
    43	        return round(float(value.strip()), 2)
    44	    except ValueError:
    45	        raise TransformError("not a number: %r" % value)
    46	
    47	
    48	def date_iso(value):
    49	    """'MM/DD/YYYY' -> 'YYYY-MM-DD'."""
    50	    parts = value.strip().split("/")
    51	    if len(parts) != 3 or len(parts[2]) != 4:
    52	        raise TransformError("not a MM/DD/YYYY date: %r" % value)
    53	    month, day, year = (p.strip() for p in parts)
    54	    if not (month.isdigit() and day.isdigit() and year.isdigit()):
    55	        raise TransformError("not a MM/DD/YYYY date: %r" % value)
    56	    return "%s-%02d-%02d" % (year, int(month), int(day))
    57	
    58	
    59	REGISTRY = {
    60	    "trim": trim,
    61	    "upper": upper,
    62	    "lower": lower,
    63	    "currency_amount": currency_amount,
    64	    "round2": round2,
    65	    "date_iso": date_iso,
    66	}
    67	
    68	
    69	def apply(name, value):
    70	    """Apply the named transform to a raw cell. An empty name is a
    71	    passthrough; an unknown name raises TransformError."""
    72	    if not name:
    73	        return value
    74	    fn = REGISTRY.get(name)
    75	    if fn is None:
    76	        raise TransformError("unknown transform: %r" % name)
    77	    return fn(value)
