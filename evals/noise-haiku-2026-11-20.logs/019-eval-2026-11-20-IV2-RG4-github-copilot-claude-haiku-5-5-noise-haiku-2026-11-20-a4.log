+class BooleanTransformTests(unittest.TestCase):
+    def test_affirmative_forms_are_one(self):
+        for raw in ("yes", "YES", "Yes", "true", "True", " TRUE "):
+            self.assertEqual(transforms.apply("boolean", raw), 1.0, raw)
+
+    def test_negative_forms_are_zero(self):
+        for raw in ("no", "NO", "false", "False", " False "):
+            self.assertEqual(transforms.apply("boolean", raw), 0.0, raw)
+
+    def test_other_inputs_raise_transform_error(self):
+        for raw in ("maybe", "1", "0", "y", "", "yes please"):
+            with self.assertRaises(transforms.TransformError, msg=raw):
+                transforms.apply("boolean", raw)
