+class BooleanAndFiniteTests(unittest.TestCase):
+    def test_boolean_affirmative_and_negative(self):
+        for raw in ("yes", "YES", " True ", "true"):
+            self.assertEqual(transforms.apply("boolean", raw), 1.0)
+        for raw in ("no", "No", "FALSE", "false"):
+            self.assertEqual(transforms.apply("boolean", raw), 0.0)
+
+    def test_boolean_rejects_other_input(self):
+        for raw in ("", "1", "0", "y", "maybe", "yes please"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("boolean", raw)
+
+    def test_non_finite_numbers_rejected(self):
+        # Regression: float("nan") / "inf" used to pass and produced NaN in
+        # report.json, which is not valid JSON.
+        for raw in ("nan", "inf", "-inf"):
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("round2", raw)
+            with self.assertRaises(transforms.TransformError):
+                transforms.apply("currency_amount", "$" + raw)
+
+
